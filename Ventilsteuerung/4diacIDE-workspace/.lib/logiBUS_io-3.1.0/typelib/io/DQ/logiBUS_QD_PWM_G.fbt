<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="logiBUS_QD_PWM_G" Comment="Output service interface function block for 13-bit PWM output with gamma correction for lamps and LEDs (brightness 0..8191 in DWORD)">
	<Identification Description="Copyright (c) 2017 fortiss GmbH, HR Agrartechnik GmbH&#10; &#10;This program and the accompanying materials are made &#10;available under the terms of the Eclipse Public License 2.0 &#10;which is available at https://www.eclipse.org/legal/epl-2.0/ &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-11-06" Remarks="initial version, gamma variant of logiBUS_QD_PWM">
	</VersionInfo>
	<CompilerInfo packageName="logiBUS::io::DQ">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
				<With Var="QI"/>
				<With Var="PARAMS"/>
				<With Var="Output"/>
				<With Var="FREQ"/>
				<With Var="RAMP"/>
				<With Var="GAMMA"/>
			</Event>
			<Event Name="REQ" Type="Event" Comment="Service Request">
				<With Var="QI"/>
				<With Var="OUT"/>
				<With Var="RAMP"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
			<Event Name="CNF" Type="Event" Comment="Confirmation of Requested Service">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
			<Event Name="RAMPO" Type="Event" Comment="Ramp finished: OUT reached (immediately after the jump with RAMP = T#0ms)">
				<With Var="QO"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Event Input Qualifier"/>
			<VarDeclaration Name="PARAMS" Type="STRING" Comment="Service Parameters"/>
			<VarDeclaration Name="OUT" Type="DWORD" Comment="Brightness as the eye sees it (0..8191), converted to the duty cycle with GAMMA, also during the ramp"/>
			<VarDeclaration Name="Output" Type="logiBUS::io::DQ::logiBUS_DO_S" Comment="Identify the Output Output_Q1..Q8" InitialValue="logiBUS_DO::Invalid"/>
			<VarDeclaration Name="FREQ" Type="UDINT" Comment="PWM frequency in Hz, read at INIT. Outputs with the same frequency share an LEDC timer (4 timers, LED blinking uses one). Power stage limits, not checked: APIXON 15 PWR Q1 (BTH50030) max. 100 Hz; BTS7030/BTT6030/BTH6070 for valves 100..200 Hz; Trainer20 without power stage" InitialValue="400"/>
			<VarDeclaration Name="RAMP" Type="TIME" Comment="Transition time to the new OUT value (hardware ramp), read at INIT and REQ. T#0ms = jump" InitialValue="T#0ms"/>
			<VarDeclaration Name="GAMMA" Type="REAL" Comment="Gamma of the brightness curve, read at INIT: duty = 8191 * (OUT / 8191)^GAMMA. 1.0 = linear (like logiBUS_QD_PWM), 2.2 = sRGB (default), 2.6 / 2.8 = Espressif examples, often more even on LEDs" InitialValue="2.2"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Event Output Qualifier"/>
			<VarDeclaration Name="STATUS" Type="STRING" Comment="Service Status"/>
		</OutputVars>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
