<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="IA_RHS" Comment="ISOBUS Adapter for Rear Hitch Status (RHS)">
	<Identification Standard="ISO 11783-7" Classification="PGN 65093" Description="Copyright (c) 2024-2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.2" Author="Franz Höpfinger" Date="2026-09-17" Remarks="Bugfix (Franz: 'IA_VDS hat einen Bug, moeglicherweise alle anderen auch'): .IND-&gt;TIMEOUT.E1 ergaenzt (analog IA_VDS) - bisher wurde TIMEOUT.E1 NUR von .TIMEOUT gefeuert (Timeout-Beginn), nie beim Eintreffen einer normalen Botschaft (.IND) - TIMEOUT.D1 (Q_timeout=FALSE) wurde also gesetzt, aber nie an den TIMEOUT-Plug propagiert, sobald der Timeout wieder endete.">
	</VersionInfo>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.1" Author="Franz Höpfinger" Date="2026-09-16" Remarks="E_D_FF_ANY-Aenderungsfilter fuer POSITION/FORCE/DRAFT ergaenzt (analog IA_RPTO v1.1).">
	</VersionInfo>
	<CompilerInfo packageName="isobus::tecu">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
				<With Var="QI"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Event Input Qualifier"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Event Output Qualifier"/>
			<VarDeclaration Name="STATUS" Type="STRING"/>
		</OutputVars>
		<Plugs>
			<AdapterDeclaration Name="POSITION" Type="adapter::types::unidirectional::AUS" Comment="Rear Hitch Position" x="4500" y="5000"/>
			<AdapterDeclaration Name="FORCE" Type="adapter::types::unidirectional::AUS" Comment="Rear Nominal Lower Link Force" x="4500" y="5760"/>
			<AdapterDeclaration Name="DRAFT" Type="adapter::types::unidirectional::AUI" Comment="Rear Draft" x="4500" y="6520"/>
			<AdapterDeclaration Name="TIMEOUT" Type="adapter::types::unidirectional::AX" Comment="Timeout Status" x="3800" y="4100"/>
		</Plugs>
	</InterfaceList>
	<FBNetwork>
		<FB Name="I_CORE" Type="isobus::tecu::I_RHS" x="680" y="3700">
		</FB>
		<FB Name="E_D_FF_Position" Type="iec61499::events::E_D_FF_ANY" x="3473.33" y="5000">
		</FB>
		<FB Name="E_D_FF_Force" Type="iec61499::events::E_D_FF_ANY" x="3473.33" y="5760">
		</FB>
		<FB Name="E_D_FF_Draft" Type="iec61499::events::E_D_FF_ANY" x="3473.33" y="6520">
		</FB>
		<EventConnections>
			<Connection Source="INIT" Destination="I_CORE.INIT" dx1="66.67"/>
			<Connection Source="I_CORE.INITO" Destination="INITO" dx1="66.67"/>
			<Connection Source="I_CORE.IND" Destination="E_D_FF_Position.CLK" dx1="266.67"/>
			<Connection Source="E_D_FF_Position.EO" Destination="POSITION.E1"/>
			<Connection Source="I_CORE.IND" Destination="E_D_FF_Force.CLK" dx1="266.67"/>
			<Connection Source="E_D_FF_Force.EO" Destination="FORCE.E1"/>
			<Connection Source="I_CORE.IND" Destination="E_D_FF_Draft.CLK" dx1="266.67"/>
			<Connection Source="E_D_FF_Draft.EO" Destination="DRAFT.E1"/>
			<Connection Source="I_CORE.TIMEOUT" Destination="TIMEOUT.E1" dx1="573.33"/>
			<Connection Source="I_CORE.IND" Destination="TIMEOUT.E1" dx1="573.33"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="QI" Destination="I_CORE.QI" dx1="66.67"/>
			<Connection Source="I_CORE.QO" Destination="QO" dx1="133.33"/>
			<Connection Source="I_CORE.STATUS" Destination="STATUS" dx1="200"/>
			<Connection Source="I_CORE.REAR_HITCH_POSITION" Destination="E_D_FF_Position.D" dx1="200"/>
			<Connection Source="E_D_FF_Position.Q" Destination="POSITION.D1"/>
			<Connection Source="I_CORE.REAR_HITCH_NOMINAL_LOWER_LINK_FORCE" Destination="E_D_FF_Force.D" dx1="133.33"/>
			<Connection Source="E_D_FF_Force.Q" Destination="FORCE.D1"/>
			<Connection Source="I_CORE.REAR_HITCH_DRAFT" Destination="E_D_FF_Draft.D" dx1="66.67"/>
			<Connection Source="E_D_FF_Draft.Q" Destination="DRAFT.D1"/>
			<Connection Source="I_CORE.Q_timeout" Destination="TIMEOUT.D1" dx1="333.33"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
