<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="IA_MSS" Comment="ISOBUS Adapter for Machine Selected Speed (MSS)">
	<Identification Standard="ISO 11783-7" Classification="PGN 61474" Description="Copyright (c) 2024-2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.2" Author="Franz Höpfinger" Date="2026-09-17" Remarks="Bugfix (Franz: 'IA_VDS hat einen Bug, moeglicherweise alle anderen auch'): .IND-&gt;TIMEOUT.E1 ergaenzt (analog IA_VDS) - bisher wurde TIMEOUT.E1 NUR von .TIMEOUT gefeuert (Timeout-Beginn), nie beim Eintreffen einer normalen Botschaft (.IND) - TIMEOUT.D1 (Q_timeout=FALSE) wurde also gesetzt, aber nie an den TIMEOUT-Plug propagiert, sobald der Timeout wieder endete.">
	</VersionInfo>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.1" Author="Franz Höpfinger" Date="2026-09-16" Remarks="E_D_FF_ANY-Aenderungsfilter fuer SPEED/DISTANCE ergaenzt (analog IA_RPTO v1.1).">
	</VersionInfo>
	<CompilerInfo packageName="isobus::tecu">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
				<With Var="QI"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Event Input Qualifier"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Event Output Qualifier"/>
			<VarDeclaration Name="STATUS" Type="STRING"/>
		</OutputVars>
		<Plugs>
			<AdapterDeclaration Name="SPEED" Type="adapter::types::unidirectional::AUI" Comment="Machine selected speed" x="4700" y="5000"/>
			<AdapterDeclaration Name="DISTANCE" Type="adapter::types::unidirectional::AUDI" Comment="Machine selected distance" x="4800" y="5800"/>
			<AdapterDeclaration Name="TIMEOUT" Type="adapter::types::unidirectional::AX" Comment="Timeout Status" x="3900" y="3500"/>
		</Plugs>
	</InterfaceList>
	<FBNetwork>
		<FB Name="I_CORE" Type="isobus::tecu::I_MSS" x="680" y="3100">
		</FB>
		<FB Name="E_D_FF_Speed" Type="iec61499::events::E_D_FF_ANY" x="3513.33" y="5000">
		</FB>
		<FB Name="E_D_FF_Distance" Type="iec61499::events::E_D_FF_ANY" x="3513.33" y="5760">
		</FB>
		<EventConnections>
			<Connection Source="INIT" Destination="I_CORE.INIT" dx1="66.67"/>
			<Connection Source="I_CORE.INITO" Destination="INITO" dx1="66.67"/>
			<Connection Source="I_CORE.IND" Destination="E_D_FF_Speed.CLK" dx1="186.67"/>
			<Connection Source="E_D_FF_Speed.EO" Destination="SPEED.E1"/>
			<Connection Source="I_CORE.IND" Destination="E_D_FF_Distance.CLK" dx1="266.67"/>
			<Connection Source="E_D_FF_Distance.EO" Destination="DISTANCE.E1" dx1="266.67"/>
			<Connection Source="I_CORE.TIMEOUT" Destination="TIMEOUT.E1" dx1="746.67"/>
			<Connection Source="I_CORE.IND" Destination="TIMEOUT.E1" dx1="746.67"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="QI" Destination="I_CORE.QI" dx1="66.67"/>
			<Connection Source="I_CORE.QO" Destination="QO" dx1="333.33"/>
			<Connection Source="I_CORE.STATUS" Destination="STATUS" dx1="400"/>
			<Connection Source="I_CORE.SELECTEDMACHINESPEED" Destination="E_D_FF_Speed.D" dx1="133.33"/>
			<Connection Source="E_D_FF_Speed.Q" Destination="SPEED.D1"/>
			<Connection Source="I_CORE.SELECTEDMACHINEDISTANCE" Destination="E_D_FF_Distance.D" dx1="66.67"/>
			<Connection Source="E_D_FF_Distance.Q" Destination="DISTANCE.D1" dx1="266.67"/>
			<Connection Source="I_CORE.Q_timeout" Destination="TIMEOUT.D1" dx1="200"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
	<Attribute Name="Documentation" Type="CDATA"><![CDATA[<p>ISOBUS Adapter for Machine Selected Speed (MSS)</p>

<p>&nbsp;</p>

<p><strong>TIMEOUT.E1-Verdrahtung:</strong> I_CORE.TIMEOUT (echter Timeout-Eintritt) UND I_CORE.IND (Normalbetrieb) sind beide auf den Adapter-Plug TIMEOUT.E1 verdrahtet - bewusst so, damit TIMEOUT.D1 (Q_timeout) am Adapter-Plug auch beim Zuruecksetzen auf false aktualisiert wird, nicht nur beim Eintreten des Timeouts. Der zugrundeliegende TIMEOUT/IND-Vertrag von I_CORE selbst ist in dessen eigener .fbt-Datei dokumentiert.</p>
]]></Attribute>
</FBType>
