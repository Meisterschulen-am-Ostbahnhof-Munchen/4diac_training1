<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="IA_VDS" Comment="ISOBUS Adapter for Vehicle Direction/Speed (VDS)">
	<Identification Standard="ISO 11783-7" Classification="PGN 65256" Description="Copyright (c) 2024-2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.1" Author="Franz Höpfinger" Date="2026-09-16" Remarks="E_D_FF_ANY-Aenderungsfilter fuer NAV_SPEED/BEARING/ALTITUDE ergaenzt (analog IA_RPTO v1.1).">
	</VersionInfo>
	<CompilerInfo packageName="isobus::tecu">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
				<With Var="QI"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Event Input Qualifier"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Event Output Qualifier"/>
			<VarDeclaration Name="STATUS" Type="STRING"/>
		</OutputVars>
		<Plugs>
			<AdapterDeclaration Name="NAV_SPEED" Type="adapter::types::unidirectional::AUI" Comment="Navigation-based vehicle speed" x="4400" y="5800"/>
			<AdapterDeclaration Name="BEARING" Type="adapter::types::unidirectional::AUI" Comment="Compass bearing" x="4400" y="5000"/>
			<AdapterDeclaration Name="ALTITUDE" Type="adapter::types::unidirectional::AUI" Comment="Altitude" x="4400" y="6500"/>
			<AdapterDeclaration Name="TIMEOUT" Type="adapter::types::unidirectional::AX" Comment="Timeout Status" x="3200" y="4000"/>
		</Plugs>
	</InterfaceList>
	<FBNetwork>
		<FB Name="I_VDS" Type="isobus::tecu::I_VDS" x="680" y="3700">
		</FB>
		<FB Name="E_D_FF_NavSpeed" Type="iec61499::events::E_D_FF_ANY" x="3280" y="5760">
		</FB>
		<FB Name="E_D_FF_Bearing" Type="iec61499::events::E_D_FF_ANY" x="3280" y="5000">
		</FB>
		<FB Name="E_D_FF_Altitude" Type="iec61499::events::E_D_FF_ANY" x="3280" y="6520">
		</FB>
		<EventConnections>
			<Connection Source="INIT" Destination="I_VDS.INIT" dx1="66.67"/>
			<Connection Source="I_VDS.INITO" Destination="INITO" dx1="66.67"/>
			<Connection Source="I_VDS.TIMEOUT" Destination="TIMEOUT.E1" dx1="266.67"/>
			<Connection Source="I_VDS.IND" Destination="E_D_FF_NavSpeed.CLK" dx1="333.33"/>
			<Connection Source="E_D_FF_NavSpeed.EO" Destination="NAV_SPEED.E1" dx1="180"/>
			<Connection Source="I_VDS.IND" Destination="E_D_FF_Bearing.CLK" dx1="333.33"/>
			<Connection Source="E_D_FF_Bearing.EO" Destination="BEARING.E1"/>
			<Connection Source="I_VDS.IND" Destination="E_D_FF_Altitude.CLK" dx1="333.33"/>
			<Connection Source="E_D_FF_Altitude.EO" Destination="ALTITUDE.E1" dx1="180"/>
			<Connection Source="I_VDS.IND" Destination="TIMEOUT.E1" dx1="513.33"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="QI" Destination="I_VDS.QI" dx1="66.67"/>
			<Connection Source="I_VDS.QO" Destination="QO" dx1="133.33"/>
			<Connection Source="I_VDS.STATUS" Destination="STATUS" dx1="200"/>
			<Connection Source="I_VDS.Q_timeout" Destination="TIMEOUT.D1" dx1="66.67"/>
			<Connection Source="I_VDS.NavigationBasedVehicleSpeed" Destination="E_D_FF_NavSpeed.D" dx1="133.33"/>
			<Connection Source="E_D_FF_NavSpeed.Q" Destination="NAV_SPEED.D1" dx1="180"/>
			<Connection Source="I_VDS.CompassBearing" Destination="E_D_FF_Bearing.D" dx1="200"/>
			<Connection Source="E_D_FF_Bearing.Q" Destination="BEARING.D1"/>
			<Connection Source="I_VDS.Altitude" Destination="E_D_FF_Altitude.D" dx1="66.67"/>
			<Connection Source="E_D_FF_Altitude.Q" Destination="ALTITUDE.D1" dx1="180"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
	<Attribute Name="Documentation" Type="CDATA"><![CDATA[<p>ISOBUS Adapter for Vehicle Direction/Speed (VDS)</p>

<p>&nbsp;</p>

<p><strong>TIMEOUT.E1-Verdrahtung:</strong> I_VDS.TIMEOUT (echter Timeout-Eintritt) UND I_VDS.IND (Normalbetrieb) sind beide auf den Adapter-Plug TIMEOUT.E1 verdrahtet - bewusst so, damit TIMEOUT.D1 (Q_timeout) am Adapter-Plug auch beim Zuruecksetzen auf false aktualisiert wird, nicht nur beim Eintreten des Timeouts. Der zugrundeliegende TIMEOUT/IND-Vertrag von I_VDS selbst ist in dessen eigener .fbt-Datei dokumentiert.</p>
]]></Attribute>
</FBType>
