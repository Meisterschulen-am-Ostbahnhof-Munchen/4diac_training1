<?xml version="1.0" encoding="UTF-8"?>
<Function Name="F_VTScaleFactor" Comment="Pick the DataMask or SoftKeyMask/Aux scale factor for a VT object ID, per the DM/SKM ID-range table.">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-05" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="isobus::UT::Q::helpers">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="u16ObjId"/>
				<With Var="rScaleFactorDM"/>
				<With Var="rScaleFactorSKM"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var=""/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="u16ObjId" Type="UINT"/>
			<VarDeclaration Name="rScaleFactorDM" Type="REAL"/>
			<VarDeclaration Name="rScaleFactorSKM" Type="REAL"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="" Type="REAL"/>
		</OutputVars>
	</InterfaceList>
	<FunctionBody>
		<ST><![CDATA[PACKAGE isobus::UT::Q::helpers;

(* Pick the DataMask or SoftKeyMask/Aux scale factor for a VT object ID, per the DM/SKM
 * ID-range table (see UT/Q/SCALING_FLAG_KONZEPT.md). Ranges not covered by the table
 * (no SKM counterpart, or outside any documented range) default to rScaleFactorDM, per
 * the table's own "DataMask objects are always scaled" default. *)
FUNCTION F_VTScaleFactor : REAL

VAR_INPUT
	u16ObjId : UINT;
	rScaleFactorDM : REAL;
	rScaleFactorSKM : REAL;
END_VAR

IF (u16ObjId = 0)
	OR (u16ObjId >= 5000 AND u16ObjId <= 5999)
	OR (u16ObjId >= 31000 AND u16ObjId <= 31999) THEN
	(* Centering: WorkingSet object, Softkeys, Auxiliary Function - never scaled *)
	F_VTScaleFactor := 1.0;
ELSIF (u16ObjId >= 3500 AND u16ObjId <= 3999)
	OR (u16ObjId >= 11500 AND u16ObjId <= 11999)
	OR (u16ObjId >= 12500 AND u16ObjId <= 12999)
	OR (u16ObjId >= 13500 AND u16ObjId <= 13999)
	OR (u16ObjId >= 14500 AND u16ObjId <= 14999)
	OR (u16ObjId >= 15500 AND u16ObjId <= 15999)
	OR (u16ObjId >= 16500 AND u16ObjId <= 16999)
	OR (u16ObjId >= 20500 AND u16ObjId <= 20999)
	OR (u16ObjId >= 23500 AND u16ObjId <= 23999)
	OR (u16ObjId >= 24500 AND u16ObjId <= 24900)
	OR (u16ObjId >= 25500 AND u16ObjId <= 25999) THEN
	(* SoftKeyMask/Aux half of a split range *)
	F_VTScaleFactor := rScaleFactorSKM;
ELSE
	(* DataMask half of a split range, or a class with no SKM split at all *)
	F_VTScaleFactor := rScaleFactorDM;
END_IF;

END_FUNCTION
]]></ST>
	</FunctionBody>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</Function>
