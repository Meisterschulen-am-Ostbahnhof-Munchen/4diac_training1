<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="Q_ESC_AX" Comment="Esc Command with AX adapter ( Part 6 - F.8 )">
	<Identification Standard="ISO 11783-6" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-11" Remarks="AX adapter wrapper for Q_ESC">
	</VersionInfo>
	<CompilerInfo packageName="isobus::UT::Q">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</Event>
			<Event Name="CNF" Type="Event" Comment="Confirmation of Requested Service">
				<With Var="STATUS"/>
				<With Var="s16result"/>
			</Event>
		</EventOutputs>
		<OutputVars>
			<VarDeclaration Name="STATUS" Type="STRING" Comment="Service Status"/>
			<VarDeclaration Name="s16result" Type="INT" Comment="retval see description"/>
		</OutputVars>
		<Sockets>
			<AdapterDeclaration Name="xReq" Type="adapter::types::unidirectional::AX" Comment="Esc Command Trigger" x="-600" y="1200"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="Q_ESC" Type="isobus::UT::Q::Q_ESC" x="533.33" y="420">
		</FB>
		<EventConnections>
			<Connection Source="INIT" Destination="Q_ESC.INIT" dx1="1306.67"/>
			<Connection Source="Q_ESC.INITO" Destination="INITO" dx1="1506.67"/>
			<Connection Source="Q_ESC.CNF" Destination="CNF" dx1="1760"/>
			<Connection Source="xReq.E1" Destination="Q_ESC.REQ" dx1="320"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="Q_ESC.STATUS" Destination="STATUS" dx1="2000"/>
			<Connection Source="Q_ESC.s16result" Destination="s16result" dx1="2573.33"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="Documentation" Type="CDATA"><![CDATA[<h1>Esc Command with AX adapter ( Part 6 - F.8 )</h1>

<p>This FB is an AX adapter wrapper around <strong>Q_ESC</strong>.</p>
]]></Attribute>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
