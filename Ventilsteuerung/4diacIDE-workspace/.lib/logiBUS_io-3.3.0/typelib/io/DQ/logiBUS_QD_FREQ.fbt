<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="logiBUS_QD_FREQ" Comment="Output service interface function block for a frequency output (MCPWM, duty cycle 50 %, frequency in mHz in DWORD)">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-11-06" Remarks="initial version">
	</VersionInfo>
	<CompilerInfo packageName="logiBUS::io::DQ">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
				<With Var="QI"/>
				<With Var="PARAMS"/>
				<With Var="Output"/>
				<With Var="FMIN"/>
				<With Var="FMAX"/>
			</Event>
			<Event Name="REQ" Type="Event" Comment="Service Request">
				<With Var="QI"/>
				<With Var="FREQ"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
			<Event Name="CNF" Type="Event" Comment="Confirmation of Requested Service">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Event Input Qualifier"/>
			<VarDeclaration Name="PARAMS" Type="STRING" Comment="Service Parameters"/>
			<VarDeclaration Name="FREQ" Type="DWORD" Comment="Frequency in mHz (1000 = 1 Hz) like ISOBUS DDI 583 Setpoint Frequency (resolution 0.001 Hz). 0 = output off (low). Duty cycle fixed 50 %. Values outside FMIN..FMAX are limited, STATUS says so. Takes effect at the end of the running period (no glitch). Power stage limits, not checked: APIXON 15 PWR Q1 (BTH50030) max. 100 Hz; BTS7030/BTT6030/BTH6070 some 100 Hz; Trainer20 without power stage"/>
			<VarDeclaration Name="Output" Type="logiBUS::io::DQ::logiBUS_DO_S" Comment="Identify the Output Output_Q1..Q8" InitialValue="logiBUS_DO::Invalid"/>
			<VarDeclaration Name="FMIN" Type="DWORD" Comment="Lowest frequency in mHz, read at INIT. Sets the timer resolution (16-bit timer: resolution = about FMIN * 65536): the higher FREQ is above FMIN, the coarser the steps (step about FREQ^2 / resolution). Default 10 Hz: 640 kHz resolution, step 1.6 Hz at 1 kHz, 156 Hz at 10 kHz" InitialValue="10000"/>
			<VarDeclaration Name="FMAX" Type="DWORD" Comment="Highest frequency in mHz, read at INIT. FREQ above it is limited. Never more than the chip can produce with the resolution from FMIN (half the resolution)" InitialValue="10000000"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Event Output Qualifier"/>
			<VarDeclaration Name="STATUS" Type="STRING" Comment="Service Status"/>
		</OutputVars>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
