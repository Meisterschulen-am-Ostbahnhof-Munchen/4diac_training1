<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AIS_LAST_2" Comment="MERGE 2 AIS in 1 AIS (LAST WRITER WINS, generic FB) - welcher Socket zuletzt&#10;geschrieben hat, gewinnt und wird sofort an OUT durchgereicht">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-08-31" Remarks="generic 2-way AIS last-writer-wins merge, plain BasicFB (like E_D_FF/E_SR) instead of wiring F_SEL/E_RS inline every time - whichever Socket's own event fires IS the last-writer signal, no SR-latch needed">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-11-06" Remarks="generic FB GEN_AIS_LAST (N Sockets), Verhalten in FORTE">
	</VersionInfo>
	<CompilerInfo packageName="adapter::events::unidirectional">
		<Import declaration="eclipse4diac::core::GenericClassName"/>
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="OUT" Type="adapter::types::unidirectional::AIS"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="IN1" Type="adapter::types::unidirectional::AIS"/>
			<AdapterDeclaration Name="IN2" Type="adapter::types::unidirectional::AIS"/>
		</Sockets>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::GenericClassName" Value="'GEN_AIS_LAST'"/>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
