<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AIWS_TO_AIS" Comment="Composite FB for converting AIWS (WSTRING) adapter to AIS (STRING) adapter">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-11-13" Remarks="Initial Version - Luecke in der Adapter-Familie geschlossen">
	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::unidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="AIS_OUT" Type="adapter::types::unidirectional::AIS" Comment="STRING Adapter Output" x="2300" y="0"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="AIWS_IN" Type="adapter::types::unidirectional::AIWS" Comment="WSTRING Adapter Input" x="0" y="0"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="Convert" Type="iec61131::conversion::F_WSTRING_TO_STRING" x="1000" y="0">
		</FB>
		<EventConnections>
			<Connection Source="AIWS_IN.E1" Destination="Convert.REQ"/>
			<Connection Source="Convert.CNF" Destination="AIS_OUT.E1"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="AIWS_IN.D1" Destination="Convert.IN"/>
			<Connection Source="Convert.OUT" Destination="AIS_OUT.D1"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
