<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AULI_TO_ATM_IN_MS" Comment="Convert ULINT (via AULI adapter) in MS to TIME (via ATM adapter), Gegenrichtung zu ATM_IN_MS_TO_AULI">
	<Identification Standard="61499-2" Function="OUT = T#1ms * IN (F_MULTIME)" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-11-13" Remarks="Initial Version - Luecke in der Adapter-Familie geschlossen">
	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::unidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="OUT" Type="adapter::types::unidirectional::ATM" Comment="TIME-Wert = IN * 1 MS" x="2500" y="0"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="IN" Type="adapter::types::unidirectional::AULI" Comment="Zeitwert in MS als ULINT" x="0" y="0"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="F_MULTIME" Type="iec61131::arithmetic::F_MULTIME" x="900" y="0">
			<Parameter Name="IN1" Value="T#1ms"/>
		</FB>
		<EventConnections>
			<Connection Source="IN.E1" Destination="F_MULTIME.REQ"/>
			<Connection Source="F_MULTIME.CNF" Destination="OUT.E1"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="IN.D1" Destination="F_MULTIME.IN2"/>
			<Connection Source="F_MULTIME.OUT" Destination="OUT.D1"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
