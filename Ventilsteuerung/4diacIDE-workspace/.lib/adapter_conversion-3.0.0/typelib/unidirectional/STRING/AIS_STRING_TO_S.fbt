<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AIS_STRING_TO_S" Comment="Composite FB for convert STRING to AIS">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-11-13" Remarks="Initial Version - Luecke geschlossen (analog zu AB_BYTE_TO_B)">
	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::unidirectional">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Request to Adapter">
				<With Var="OUT"/>
				<Attribute Name="YPOSITION" Type="DINT" Value="46"/>
			</Event>
		</EventInputs>
		<InputVars>
			<VarDeclaration Name="OUT" Type="STRING" Comment="Output data to Adapter">
				<Attribute Name="YPOSITION" Type="DINT" Value="31"/>
			</VarDeclaration>
		</InputVars>
		<Plugs>
			<AdapterDeclaration Name="AIS_OUT" Type="adapter::types::unidirectional::AIS" Comment="Adapter Output" x="-3900" y="-500"/>
		</Plugs>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="REQ" Destination="AIS_OUT.E1" dx1="1606.67"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="OUT" Destination="AIS_OUT.D1" dx1="180"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
