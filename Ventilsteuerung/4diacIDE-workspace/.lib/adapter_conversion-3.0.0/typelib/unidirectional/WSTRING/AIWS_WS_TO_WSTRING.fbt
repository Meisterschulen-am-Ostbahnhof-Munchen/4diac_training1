<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AIWS_WS_TO_WSTRING" Comment="Composite FB for convert AIWS to WSTRING">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-11-13" Remarks="Initial Version - Luecke geschlossen (analog zu AB_B_TO_BYTE)">
	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::unidirectional">
	</CompilerInfo>
	<InterfaceList>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="Confirmation from Adapter">
				<With Var="IN"/>
				<Attribute Name="YPOSITION" Type="DINT" Value="46"/>
			</Event>
		</EventOutputs>
		<OutputVars>
			<VarDeclaration Name="IN" Type="WSTRING" Comment="Input data from Adapter">
				<Attribute Name="YPOSITION" Type="DINT" Value="47"/>
			</VarDeclaration>
		</OutputVars>
		<Sockets>
			<AdapterDeclaration Name="AIWS_IN" Type="adapter::types::unidirectional::AIWS" Comment="Adapter Input" x="0" y="0"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="AIWS_IN.E1" Destination="CNF" dx1="2293.33"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="AIWS_IN.D1" Destination="IN" dx1="2293.33"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
