<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AD2_TO_AD" Comment="Composite FB for convert bidirectional AD2 to unidirectional AD">
	<Identification Standard="61499-2" Function="AD2_BIDIR forwards its incoming (EO1) side out as a plain unidirectional signal via AD_OUT. AD_IN publishes its value onto the outgoing (EI1) side of AD2_BIDIR." Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-11-13" Remarks="Initial Version - Luecke geschlossen (analog zu AB2_TO_AB)">
	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::bidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Sockets>
			<AdapterDeclaration Name="AD2_BIDIR" Type="adapter::types::bidirectional::AD2" Comment="Adapter Input: bidirectional tap, incoming side forwarded to AD_OUT, outgoing side driven by AD_IN" x="-1200" y="900"/>
			<AdapterDeclaration Name="AD_IN" Type="adapter::types::unidirectional::AD" Comment="Adapter Input: unidirectional source" x="-2200" y="900"/>
		</Sockets>
		<Plugs>
			<AdapterDeclaration Name="AD_OUT" Type="adapter::types::unidirectional::AD" Comment="Adapter Output: mirrors AD2_BIDIR's incoming (indication) side" x="100" y="900"/>
		</Plugs>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="AD2_BIDIR.EO1" Destination="AD_OUT.E1"/>
			<Connection Source="AD_IN.E1" Destination="AD2_BIDIR.EI1"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="AD2_BIDIR.DO1" Destination="AD_OUT.D1"/>
			<Connection Source="AD_IN.D1" Destination="AD2_BIDIR.DI1"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
