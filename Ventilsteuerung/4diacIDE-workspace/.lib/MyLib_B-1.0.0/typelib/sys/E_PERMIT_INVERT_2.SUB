<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="E_PERMIT_INVERT_2" Comment="2-Kanal invertiertes Event-Freigabe-Gate (je Kanal F_NOT_BOOL_INIT + E_PERMIT)">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-11-11" Remarks="Je Kanal ein F_NOT_BOOL_INIT und ein E_PERMIT statt E_MUX/E_DEMUX mit gemeinsamem K: kamen zwei Kanaele in derselben Ereigniskette (z. B. E_SPLIT), ueberschrieb E_MUX das K, bevor E_DEMUX es las, und das erste Ereignis landete auf dem falschen Ausgang.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-10" Remarks="initial implementation">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
	</CompilerInfo>
	<SubAppInterfaceList>
		<SubAppEventInputs>
			<SubAppEvent Name="EI1" Type="Event" Comment="Event input channel 1">
			</SubAppEvent>
			<SubAppEvent Name="EI2" Type="Event" Comment="Event input channel 2">
			</SubAppEvent>
		</SubAppEventInputs>
		<SubAppEventOutputs>
			<SubAppEvent Name="EO1" Type="Event" Comment="Event output channel 1">
			</SubAppEvent>
			<SubAppEvent Name="EO2" Type="Event" Comment="Event output channel 2">
			</SubAppEvent>
		</SubAppEventOutputs>
		<InputVars>
			<VarDeclaration Name="PERMIT" Type="BOOL" Comment="Invertierte Freigabebedingung"/>
		</InputVars>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="F_NOT_1" Type="iec61131::booleanOperators::F_NOT_BOOL_INIT" x="1000" y="0">
		</FB>
		<FB Name="E_PERMIT_1" Type="iec61499::events::E_PERMIT" x="2600" y="0">
		</FB>
		<FB Name="F_NOT_2" Type="iec61131::booleanOperators::F_NOT_BOOL_INIT" x="1000" y="400">
		</FB>
		<FB Name="E_PERMIT_2" Type="iec61499::events::E_PERMIT" x="2600" y="400">
		</FB>
		<EventConnections>
			<Connection Source="EI1" Destination="F_NOT_1.REQ"/>
			<Connection Source="F_NOT_1.CNF" Destination="E_PERMIT_1.EI"/>
			<Connection Source="E_PERMIT_1.EO" Destination="EO1"/>
			<Connection Source="EI2" Destination="F_NOT_2.REQ"/>
			<Connection Source="F_NOT_2.CNF" Destination="E_PERMIT_2.EI"/>
			<Connection Source="E_PERMIT_2.EO" Destination="EO2"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="PERMIT" Destination="F_NOT_1.IN"/>
			<Connection Source="F_NOT_1.OUT" Destination="E_PERMIT_1.PERMIT"/>
			<Connection Source="PERMIT" Destination="F_NOT_2.IN"/>
			<Connection Source="F_NOT_2.OUT" Destination="E_PERMIT_2.PERMIT"/>
		</DataConnections>
	</SubAppNetwork>
</SubAppType>
