<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="STRING_TO_CAN_MSG" Comment="STRING (bis 8 Zeichen) in eine CAN_MSG fuer AlPgnTxNew8B packen">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.1" Author="Franz Höpfinger" Date="2026-11-14" Remarks="Fuellung Text + 16#00 + 16#FF, u16DaSize immer 8, PRIO auf 0..7 begrenzt, Ausgang TRUNC in TRUNCATED umbenannt (TRUNC ist reserviert)">
	</VersionInfo>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-11-13" Remarks="Initial Version - STRING ueber CAN (0-8 Byte)">
	</VersionInfo>
	<CompilerInfo packageName="isobus::pgn">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Text packen">
				<With Var="IN"/>
				<With Var="PRIO"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="MSG ist gefuellt">
				<With Var="MSG"/>
				<With Var="TRUNCATED"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="IN" Type="STRING" Comment="Text, je Zeichen 1 Byte"/>
			<VarDeclaration Name="PRIO" Type="USINT" Comment="Prioritaet (0..7), groesser 7 wird 7; AlPgnTxNew8B nimmt die Prioritaet vom install, nicht aus MSG" InitialValue="6"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="MSG" Type="isobus::pgn::CAN_MSG" Comment="data = Zeichen, dann 16#00 (falls Platz), Rest 16#FF; u16DaSize = 8"/>
			<VarDeclaration Name="TRUNCATED" Type="BOOL" Comment="TRUE, wenn IN laenger als 8 Zeichen war (abgeschnitten)"/>
		</OutputVars>
	</InterfaceList>
	<SimpleFB>
		<ECState Name="REQ" Comment="">
			<ECAction Algorithm="REQ" Output="CNF"/>
		</ECState>
		<Algorithm Name="REQ" Comment="Zeichen in data[0..7] kopieren, mit 16#00 abschliessen, Rest 16#FF">
			<ST><![CDATA[ALGORITHM REQ
VAR_TEMP
	n : DINT; // Anzahl zu kopierender Zeichen
	i : DINT; // Laufindex
END_VAR
n := LEN(IN);
IF n < 0 THEN
	n := 0;
END_IF;
TRUNCATED := n > 8;
IF n > 8 THEN
	n := 8;
END_IF;
FOR i := 0 TO 7 DO
	MSG.data[i] := BYTE#16#FF; // nicht genutzte Bytes wie bei J1939/ISOBUS ueblich
END_FOR;
FOR i := 1 TO n DO
	MSG.data[i - 1] := CHAR_TO_BYTE(IN[i]);
END_FOR;
IF n < 8 THEN
	MSG.data[n] := BYTE#16#00; // Textende
END_IF;
(* AlPgnTxNew8B sendet Laenge und Prioritaet vom install, MSG.u16DaSize und MSG.u8Priority werden dort nicht gelesen *)
MSG.u16DaSize := 8;
IF PRIO > 7 THEN
	MSG.u8Priority := 7;
ELSE
	MSG.u8Priority := PRIO;
END_IF;
END_ALGORITHM]]></ST>
		</Algorithm>
	</SimpleFB>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
