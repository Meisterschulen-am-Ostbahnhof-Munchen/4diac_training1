<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="logiBUS_AI_Calibrate_IDA_OPC" Comment="logiBUS_AI_IDA (Analog-Eingang) mit 2-Punkt-Kalibrierung (AR_CALIBRATE_2P_REF, unabhaengig gespeicherte Rohwerte X_LOW/X_HIGH + Referenzwerte LOW_REF/HIGH_REF alle INI-persistiert) auf VT-Zahlenfelder (Rohwert + kalibrierter Wert, je eigene CNumberVariable) + Bargraph (kalibriert) + 2 VT-Tasten (CO/CS) + OPC-UA (Rohwert DWORD + kalibrierter Wert REAL, generisch, ein Kanal)">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-08-31" Remarks="initial API and implementation and/or initial documentation - Kalibrierlogik nach Vorbild Uebung_028c3_AR.SUB, aber AR_CALIBRATE_SQ (korrigierte Offset-Formel, ECC-erzwungene CO-vor-CS-Reihenfolge) statt AR_CALIBRATE">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-09-11" Remarks="Migriert auf AR_CALIBRATE_2P_REF: CO/CS speichern jetzt unabhaengig X_LOW/X_HIGH (wie AR_CALIBRATE_3P/_REF), keine ECC-erzwungene Reihenfolge mehr noetig, da CS mathematisch nie von CO abhing - nur die alte OFFSET/SCALE-Inkrementalrechnung erzwang das kuenstlich. Aeussere Schnittstelle (InputVars, VT-Tasten CO/CS, GCF-IDs) unveraendert, nur interne INI-Keys OFFSET/SCALE/ZERO/SPAN -&gt; X_LOW/X_HIGH/LOW_REF/HIGH_REF umbenannt (Klarheit, keine bestehenden Feldgeraete betroffen).">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.2" Author="Franz Höpfinger" Date="2026-09-17" Remarks="Franz: 'die Tasten vom OPC-UA Webpanel aus sollen Methoden aufrufen auf dem Steuergeraet das die Kalibrierung macht' - CO/CS bekommen einen dritten, gleichberechtigten Ausloeser: eine argumentlose OPC-UA-Methode (ID_CO_METHOD/ID_CS_METHOD, ACTION=CREATE_METHOD via SERVER_0), analog zum bereits etablierten Softkey_Aux_Method_IE-Muster (Softkey/AUX/lokale-Methode gleichberechtigt gemergt). IND-&gt;RSP-Selfloop zwingend (siehe OPC_UA_VERNETZUNG.md Punkt 12 - sonst 4s Server-Lock). Bestehende Instanzen (Ultraschall) muessen einen echten, wenn auch vorerst ungenutzten Methoden-Namen bekommen - InputVars sind nicht optional (kein WSTRING-Aequivalent zu ID_NULL).">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.3" Author="Franz Höpfinger" Date="2026-09-17" Remarks="AR_CALIBRATE_2P_REF.C_LOW/C_HIGH von AX-Sockets auf reine EventInputs umgestellt (Franz: der AX-Flankenwaechter war akademisch, jeder echte Aufrufer liefert ohnehin ein atomares Event) - AX_BOOL_TO_X_CO/_CS entfallen ersatzlos, die Merge-Ketten (E_MERGE_CO_C/E_MERGE_CS_C) verbinden jetzt direkt per EventConnection mit CALIBRATE.C_LOW/C_HIGH.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.4" Author="Franz Höpfinger" Date="2026-09-18" Remarks="AX_SUBSCRIBE_CO/CS + AX_RF_TRIG_CO/CS (Toggle-Subscribe-Weiterleitung, ID_CO_READ/ID_CS_READ) ersatzlos entfernt - Cross-Station-Weiterleitung einer VT-Taste lief bisher ueber Event-&gt;Pegel(Toggle)-&gt;Event, obwohl mit ID_CO_METHOD/ID_CS_METHOD bereits ein echter Methodenaufruf existiert. Siehe OPC_UA_VERNETZUNG.md Punkt 14. E_MERGE_CO/CS schrumpfen von 4 auf 2 Quellen (lokale VT-Taste + Methode) - CO/CS-Merge-Ketten (3x E_MERGE_2 in Reihe) durch je einen einzelnen E_MERGE_2 ersetzt.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.5" Author="Franz Höpfinger" Date="2026-09-18" Remarks="Button_CO/Button_CS + METHOD_SERVER_CO/CS + E_MERGE_CO/CS (je 1x pro Taste) durch je eine Instanz des neuen wiederverwendbaren Bausteins Button_Method_IE ersetzt - identisches Muster kam 2x identisch vor, analog zu Softkey_Aux_Method_IE herausgeloest.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.6" Author="Franz Höpfinger" Date="2026-09-18" Remarks="Franz: 'kann eine SUB sein' - logiBUS_AI_IDA+AD_SPLIT_2+AD_PUBLISH_RAW+AD_TO_AUDI+AUDI_SPLIT_2+Q_NumericValue_RAW+AUDI_TO_AR durch neue SubApp logiBUS_AI_Raw_VT_AR_OPC ersetzt, AR_SPLIT_2+AR_PUBLISH_CAL+Q_NumericValue_CAL durch die bereits bestehende SubApp AR_TO_Q_Publish_OPC (dort um optionales INITO ergaenzt) - beide Muster kamen identisch auch in logiBUS_AI_Calibrate_3P_IDA_OPC vor.">
	</VersionInfo>
