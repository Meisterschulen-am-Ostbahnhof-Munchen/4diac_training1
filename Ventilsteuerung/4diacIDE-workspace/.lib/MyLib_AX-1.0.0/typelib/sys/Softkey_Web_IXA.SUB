<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Softkey_Web_IXA" Comment="SoftKey (VT) ODER lokaler Web-Override (vt-ui-mirror, Dauerzustand) zu 1 gemeinsamem kontinuierlichem AX-Zustand zusammengefuehrt - fuer Taster ohne AUX-Zuordnung (z.B. Fahrwerk-Mittelpunkt), die trotzdem per Web-Client genauso wie physisch gedrueckt/gehalten werden koennen sollen. Analog zu Softkey_Aux_IXA_TO_Remote_WRITE (dort zusaetzlich mit AUX + Remote-Write), hier nur der reine Merge ohne AUX und ohne Schreiben irgendwohin - der Aufrufer verarbeitet den gemergten Zustand selbst weiter (z.B. SoftKey_Kurz_Lang).">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-11" Remarks="initial implementation - herausgeloest aus Fahrwerk_Mittelpunkt_Automatik.SUB (Softkey_Mittelpunkt+WebSub_Mittelpunkt+OR_MITTELPUNKT), wiederverwendbar fuer jeden Taster ohne AUX, der auch per Web gehalten werden koennen soll.">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
	</CompilerInfo>
	<SubAppInterfaceList>
		<InputVars>
			<VarDeclaration Name="u16ObjId" Type="UINT" Comment="Object ID SoftKey"/>
			<VarDeclaration Name="ID_WEB_READ" Type="WSTRING" Comment="Lokale Subscribe-Adresse fuer den Web-Client (vt-ui-mirror): down/up wie ein gehaltener physischer Taster"/>
		</InputVars>
		<Plugs>
			<AdapterDeclaration Name="OUT" Type="adapter::types::unidirectional::AX" Comment="SoftKey ODER Web-Override, 1 gemeinsamer kontinuierlicher Zustand"/>
		</Plugs>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="Softkey" Type="isobus::UT::io::Softkey::Softkey_IXA" x="0" y="0">
			<Parameter Name="QI" Value="TRUE"/>
		</FB>
		<FB Name="WebSub" Type="adapter::net::AX_SUBSCRIBE_1" x="0" y="900">
			<Parameter Name="QI" Value="TRUE"/>
		</FB>
		<FB Name="OR_MERGE" Type="adapter::booleanOperators::AX_OR_2" x="1600" y="450">
		</FB>
		<DataConnections>
			<Connection Source="u16ObjId" Destination="Softkey.u16ObjId" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_WEB_READ" Destination="WebSub.ID" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
		</DataConnections>
		<AdapterConnections>
			<Connection Source="Softkey.IN" Destination="OR_MERGE.IN1" dx1="800"/>
			<Connection Source="WebSub.OUT" Destination="OR_MERGE.IN2" dx1="800"/>
			<Connection Source="OR_MERGE.OUT" Destination="OUT" dx1="800"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
