<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="logiBUS_AI_Calibrated_Subscribe_VT_OPC" Comment="Remote-Subscribe eines bereits kalibrierten physikalischen Werts (M2M, von der Sensor-Station) -&gt; VT-Anzeige (Q_NumericValue_PHYSA) + lokaler Re-Publish. Die physischen VT-Elemente bleiben hier (dort wo die VT ist): CO/CS-Tasten rufen per CLIENT_0 direkt die ID_CO_METHOD/ID_CS_METHOD auf der Sensor-Station auf (logiBUS_AI_Calibrate_IDA_OPC) - echter Event-zu-Event-Methodenaufruf, kein Toggle/Publish/Subscribe-Umweg (siehe OPC_UA_VERNETZUNG.md Punkt 14). Die beiden Referenzwert-Eingabefelder ZERO/SPAN (NumericValue_TO_AR2_OPC) werden weiterhin LOKAL publiziert (AX_PUBLISH_1) und von der Sensor-Station remote abonniert (ID_ZERO_READ/ID_SPAN_READ) - das sind echte, dauerhafte Werte, kein Event, daher bleibt hier das Publish/Subscribe-Muster richtig. Ersetzt logiBUS_AI_Calibrate_Remote_IDA_OPC: Kalibrierung selbst laeuft jetzt auf der Sensor-Station (logiBUS_AI_Calibrate_IDA_OPC), hier bleibt nur noch Anzeige + VT-Bedienelemente-Weiterleitung.">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.2" Author="Franz Höpfinger" Date="2026-09-17" Remarks="CO/CS-Weiterleitung von AX_CLIENT_1_0 (Remote-Write) auf AX_PUBLISH_1 (lokaler Publish, Sensor-Station abonniert remote) umgestellt - konsistenter mit der ZERO/SPAN-Weiterleitung (die ohnehin schon so funktioniert, siehe v1.1) und mit dem im Projekt dominanten Subscribe-Richtungsmuster (DRUCK_RAW_M2M etc: der Sensor-seitige Publisher ist immer lokal, die Gegenseite abonniert remote). AX_CLIENT_1_0 war unnoetig - dieser Mechanismus ist im Projekt der Spezialfall fuer 'alleinige Source of Truth'-Kommandos (z.B. Kuehlermotor), nicht das allgemeine Signal-Weiterleitungsmuster.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.3" Author="Franz Höpfinger" Date="2026-09-18" Remarks="Franz: 'solche Scheiße muss komplett raus' - v1.2s AX_T_FF_SR-Toggle+AX_PUBLISH_1 war selbst wieder ein Event->Pegel->Event-Umweg (Button_IE.IND ist schon ein atomares Event, wird kuenstlich zum Toggle gemacht, nur damit die Sensor-Station es per AX_SUBSCRIBE_1+AX_RF_TRIG wieder zu einem Event zurueckverwandelt). Jetzt: Button_CO/CS.IND direkt auf CLIENT_0.REQ (ACTION=CALL_METHOD), ruft ID_CO_METHOD/ID_CS_METHOD auf der Sensor-Station direkt auf - kein Toggle/Publish/Subscribe/Flankenerkennung mehr noetig. ID_CO_WRITE/ID_CS_WRITE (BOOL-Publish-Adressen) durch ID_CO_CALL/ID_CS_CALL (CALL_METHOD-Adressen) ersetzt. Siehe OPC_UA_VERNETZUNG.md Punkt 14.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-09-17" Remarks="ZERO/SPAN-Referenzwert-Eingabefelder ergaenzt (uebersehen in v1.0) - ohne diese kann der Kalibrier-Referenzwert (z.B. '0 bar'/'250 bar' bei Druck) nicht mehr von der VT auf STG1 zur jetzt auf der Sensor-Station laufenden CALIBRATE weitergereicht werden. Zwei NumericValue_TO_AR2_OPC-Instanzen (VT-Eingabefeld + OPC-Publish, unveraendert aus dem bisherigen logiBUS_AI_Calibrate_Remote_IDA_OPC-Innenleben wiederverwendet).">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-17" Remarks="initial implementation - Franz: 'Analog-Kalibrierung LOKAL, Speichern LOKAL, nur der ENDWERT wird ueber OPC-UA verteilt'.">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
		<Import declaration="isobus::UT::Q::const::IDs::ID_NULL"/>
		<Import declaration="isobus::UT::io::Button::ButtonActivationCode::BT_PRESSED_LATCHED"/>
		<Import declaration="logiBUS::utils::conversion::phys::NumericObjectPool_S"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<InputVars>
			<VarDeclaration Name="ID_CAL_M2M_READ" Type="WSTRING" Comment="Remote-Subscribe-Adresse des bereits kalibrierten physikalischen Werts (REAL) - Gegenstueck zu ID_CAL_WRITE auf der Sensor-Station (logiBUS_AI_Calibrate_IDA_OPC)"/>
			<VarDeclaration Name="stObjCal" Type="logiBUS::utils::conversion::phys::NumericObjectPool_S" Comment="Object ID + Scale/Offset/Decimals CNumberVariable (kalibrierter Wert)" InitialValue="(u16ObjId := ID_NULL, r32Scale := 1.0, i32Offset := 0, u8Decimals := 1)"/>
			<VarDeclaration Name="ID_WRITE" Type="WSTRING" Comment="Lokale Re-Publish-Adresse (REAL, ACTION=PUBLISH) fuer weitere lokale Konsumenten auf dieser Station"/>
			<VarDeclaration Name="u16ObjId_CO" Type="UINT" Comment="Object ID Taste 'CO' (Kalibrier-Nullpunkt) - physisch hier auf der VT" InitialValue="ID_NULL"/>
			<VarDeclaration Name="u16ObjId_CS" Type="UINT" Comment="Object ID Taste 'CS' (Kalibrier-Spanne) - physisch hier auf der VT" InitialValue="ID_NULL"/>
			<VarDeclaration Name="ID_CO_CALL" Type="WSTRING" Comment="Remote-Methodenadresse (ACTION=CALL_METHOD) fuer den CO-Trigger - ruft ID_CO_METHOD direkt auf der Sensor-Station auf (logiBUS_AI_Calibrate_IDA_OPC)"/>
			<VarDeclaration Name="ID_CS_CALL" Type="WSTRING" Comment="Remote-Methodenadresse (ACTION=CALL_METHOD) fuer den CS-Trigger - ruft ID_CS_METHOD direkt auf der Sensor-Station auf (logiBUS_AI_Calibrate_IDA_OPC)"/>
			<VarDeclaration Name="stObjZero" Type="logiBUS::utils::conversion::phys::NumericObjectPool_S" Comment="Object ID + Scale/Offset/Decimals CNumberVariable (ZERO-Referenzwert, VT-Eingabefeld hier auf dieser Station)" InitialValue="(u16ObjId := ID_NULL, r32Scale := 1.0, i32Offset := 0, u8Decimals := 1)"/>
			<VarDeclaration Name="stObjSpan" Type="logiBUS::utils::conversion::phys::NumericObjectPool_S" Comment="Object ID + Scale/Offset/Decimals CNumberVariable (SPAN-Referenzwert, VT-Eingabefeld hier auf dieser Station)" InitialValue="(u16ObjId := ID_NULL, r32Scale := 1.0, i32Offset := 0, u8Decimals := 1)"/>
			<VarDeclaration Name="ID_ZERO_READ" Type="WSTRING" Comment="Optionale Subscribe-Adresse falls ZERO extern (Dashboard) ueberschrieben werden soll - unbenutzt zulaessig"/>
			<VarDeclaration Name="ID_ZERO_WRITE" Type="WSTRING" Comment="Lokale Publish-Adresse (REAL, ACTION=PUBLISH) des ZERO-Referenzwerts - wird von der Sensor-Station remote abonniert (deren ID_ZERO_READ)"/>
			<VarDeclaration Name="ID_SPAN_READ" Type="WSTRING" Comment="Optionale Subscribe-Adresse falls SPAN extern (Dashboard) ueberschrieben werden soll - unbenutzt zulaessig"/>
			<VarDeclaration Name="ID_SPAN_WRITE" Type="WSTRING" Comment="Lokale Publish-Adresse (REAL, ACTION=PUBLISH) des SPAN-Referenzwerts - wird von der Sensor-Station remote abonniert (deren ID_SPAN_READ)"/>
		</InputVars>
	</SubAppInterfaceList>
