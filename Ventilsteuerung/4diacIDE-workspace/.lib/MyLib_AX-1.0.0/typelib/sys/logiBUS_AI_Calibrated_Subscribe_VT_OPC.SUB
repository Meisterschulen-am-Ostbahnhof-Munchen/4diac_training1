<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="logiBUS_AI_Calibrated_Subscribe_VT_OPC" Comment="Remote-Subscribe eines bereits kalibrierten physikalischen Werts (M2M, von der Sensor-Station) -&gt; VT-Anzeige (Q_NumericValue_PHYSA) + lokaler Re-Publish. Die physischen VT-Elemente bleiben hier (dort wo die VT ist): CO/CS-Tasten rufen per CLIENT_0 direkt die ID_CO_METHOD/ID_CS_METHOD auf der Sensor-Station auf (logiBUS_AI_Calibrate_IDA_OPC) - echter Event-zu-Event-Methodenaufruf, kein Toggle/Publish/Subscribe-Umweg (siehe OPC_UA_VERNETZUNG.md Punkt 14). Kein ZERO/SPAN-Referenzwert-Eingabefeld (siehe v1.5) - der erste/bisher einzige Anwendungsfall (Fuellband-Winkel) hat feste Referenzwerte 0/100, die direkt auf der Sensor-Station als Literal stehen. Ersetzt logiBUS_AI_Calibrate_Remote_IDA_OPC: Kalibrierung selbst laeuft jetzt auf der Sensor-Station (logiBUS_AI_Calibrate_IDA_OPC), hier bleibt nur noch Anzeige + VT-Bedienelemente-Weiterleitung.">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.2" Author="Franz Höpfinger" Date="2026-09-17" Remarks="CO/CS-Weiterleitung von AX_CLIENT_1_0 (Remote-Write) auf AX_PUBLISH_1 (lokaler Publish, Sensor-Station abonniert remote) umgestellt - konsistenter mit der ZERO/SPAN-Weiterleitung (die ohnehin schon so funktioniert, siehe v1.1) und mit dem im Projekt dominanten Subscribe-Richtungsmuster (DRUCK_RAW_M2M etc: der Sensor-seitige Publisher ist immer lokal, die Gegenseite abonniert remote). AX_CLIENT_1_0 war unnoetig - dieser Mechanismus ist im Projekt der Spezialfall fuer 'alleinige Source of Truth'-Kommandos (z.B. Kuehlermotor), nicht das allgemeine Signal-Weiterleitungsmuster.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.3" Author="Franz Höpfinger" Date="2026-09-18" Remarks="Franz: 'solche Scheiße muss komplett raus' - v1.2s AX_T_FF_SR-Toggle+AX_PUBLISH_1 war selbst wieder ein Event-&gt;Pegel-&gt;Event-Umweg (Button_IE.IND ist schon ein atomares Event, wird kuenstlich zum Toggle gemacht, nur damit die Sensor-Station es per AX_SUBSCRIBE_1+AX_RF_TRIG wieder zu einem Event zurueckverwandelt). Jetzt: Button_CO/CS.IND direkt auf CLIENT_0.REQ (ACTION=CALL_METHOD), ruft ID_CO_METHOD/ID_CS_METHOD auf der Sensor-Station direkt auf - kein Toggle/Publish/Subscribe/Flankenerkennung mehr noetig. ID_CO_WRITE/ID_CS_WRITE (BOOL-Publish-Adressen) durch ID_CO_CALL/ID_CS_CALL (CALL_METHOD-Adressen) ersetzt. Siehe OPC_UA_VERNETZUNG.md Punkt 14.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-09-17" Remarks="ZERO/SPAN-Referenzwert-Eingabefelder ergaenzt (uebersehen in v1.0) - ohne diese kann der Kalibrier-Referenzwert (z.B. '0 bar'/'250 bar' bei Druck) nicht mehr von der VT auf STG1 zur jetzt auf der Sensor-Station laufenden CALIBRATE weitergereicht werden. Zwei NumericValue_TO_AR2_OPC-Instanzen (VT-Eingabefeld + OPC-Publish, unveraendert aus dem bisherigen logiBUS_AI_Calibrate_Remote_IDA_OPC-Innenleben wiederverwendet).">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-17" Remarks="initial implementation - Franz: 'Analog-Kalibrierung LOKAL, Speichern LOKAL, nur der ENDWERT wird ueber OPC-UA verteilt'.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.5" Author="Franz Höpfinger" Date="2026-09-21" Remarks="Franz: 'Min Max ist beim Fuellband FEST 0-100 ENDE, das UT braucht keinen Schreibzugriff auf Min/Max' - ZERO/SPAN-Referenzwert-Eingabefelder (stObjZero/stObjSpan/ID_ZERO_READ/WRITE/ID_SPAN_READ/WRITE, SubApps ZeroRef/SpanRef) ersatzlos entfernt. Dieser Typ ist bisher nur fuer Fuellband-Winkel instanziiert, kein anderer Aufrufer betroffen.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.4" Author="Franz Höpfinger" Date="2026-09-21" Remarks="Neuer Plug CAL_OUT (AR) ergaenzt - durchgereicht von ValueDisplay.VALUE_OUT (AR_M2M_Subscribe_TO_Q_Publish_OPC v1.1) - erster echter Verwendungsfall: Fuellband-Winkel zieht von STG1-Remote-Kalibrierung auf STG2-lokale Kalibrierung um, Befuellautomatik/Fuellband_Oben (beide auf STG1) brauchen den kalibrierten Wert weiterhin als lokalen AR-Plug statt eigenem OPC-UA-Self-Subscribe (Doppel-Self-Subscribe-Vermeidung, wie zuvor ueber AnalogChannel_Fuellband_Winkel.CAL_OUT).">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.6" Author="Franz Höpfinger" Date="2026-09-22" Remarks="Franz: 'Button_IE CLIENT_0 kann eine Subapp werden, das ist ein generelles Muster zum Rufen einer Methode vom VT aus' - Button_CO/Button_CS + CLIENT_CO/CLIENT_CS (Button_IE.IND -&gt; CLIENT_0.REQ) durch je eine Instanz des neuen MyLib::sys::Button_CLIENT_Method_IE ersetzt (TriggerCO/TriggerCS). InputEvent ist dort Parameter statt hartcodiert.">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
		<Import declaration="isobus::UT::Q::const::IDs::ID_NULL"/>
		<Import declaration="isobus::UT::io::Button::ButtonActivationCode::BT_PRESSED_LATCHED"/>
		<Import declaration="logiBUS::utils::conversion::phys::NumericObjectPool_S"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<InputVars>
			<VarDeclaration Name="ID_CAL_M2M_READ" Type="WSTRING" Comment="Remote-Subscribe-Adresse des bereits kalibrierten physikalischen Werts (REAL) - Gegenstueck zu ID_CAL_WRITE auf der Sensor-Station (logiBUS_AI_Calibrate_IDA_OPC)"/>
			<VarDeclaration Name="stObjCal" Type="logiBUS::utils::conversion::phys::NumericObjectPool_S" Comment="Object ID + Scale/Offset/Decimals CNumberVariable (kalibrierter Wert)" InitialValue="(u16ObjId := ID_NULL, r32Scale := 1.0, i32Offset := 0, u8Decimals := 1)"/>
			<VarDeclaration Name="ID_WRITE" Type="WSTRING" Comment="Lokale Re-Publish-Adresse (REAL, ACTION=PUBLISH) fuer weitere lokale Konsumenten auf dieser Station"/>
			<VarDeclaration Name="u16ObjId_CO" Type="UINT" Comment="Object ID Taste &apos;CO&apos; (Kalibrier-Nullpunkt) - physisch hier auf der VT" InitialValue="ID_NULL"/>
			<VarDeclaration Name="u16ObjId_CS" Type="UINT" Comment="Object ID Taste &apos;CS&apos; (Kalibrier-Spanne) - physisch hier auf der VT" InitialValue="ID_NULL"/>
			<VarDeclaration Name="ID_CO_CALL" Type="WSTRING" Comment="Remote-Methodenadresse (ACTION=CALL_METHOD) fuer den CO-Trigger - ruft ID_CO_METHOD direkt auf der Sensor-Station auf (logiBUS_AI_Calibrate_IDA_OPC)"/>
			<VarDeclaration Name="ID_CS_CALL" Type="WSTRING" Comment="Remote-Methodenadresse (ACTION=CALL_METHOD) fuer den CS-Trigger - ruft ID_CS_METHOD direkt auf der Sensor-Station auf (logiBUS_AI_Calibrate_IDA_OPC)"/>
		</InputVars>
		<Plugs>
			<AdapterDeclaration Name="CAL_OUT" Type="adapter::types::unidirectional::AR" Comment="Nur-Lese-Spiegel des kalibrierten Werts (= ValueDisplay.VALUE_OUT) fuer weitere lokale Konsumenten auf dieser Station, statt eigenem OPC-UA-Self-Subscribe"/>
		</Plugs>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<SubApp Name="ValueDisplay" Type="MyLib::sys::AR_M2M_Subscribe_TO_Q_Publish_OPC" x="0" y="0">
		</SubApp>
		<SubApp Name="TriggerCO" Type="MyLib::sys::Button_CLIENT_Method_IE" x="400" y="700">
			<Parameter Name="InputEvent" Value="BT_PRESSED_LATCHED"/>
		</SubApp>
		<SubApp Name="TriggerCS" Type="MyLib::sys::Button_CLIENT_Method_IE" x="400" y="1300">
			<Parameter Name="InputEvent" Value="BT_PRESSED_LATCHED"/>
		</SubApp>
		<DataConnections>
			<Connection Source="ID_CAL_M2M_READ" Destination="ValueDisplay.ID_M2M_READ" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="stObjCal" Destination="ValueDisplay.stObj" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_WRITE" Destination="ValueDisplay.ID_WRITE" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="u16ObjId_CO" Destination="TriggerCO.u16ObjId" dx1="973.33">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="u16ObjId_CS" Destination="TriggerCS.u16ObjId" dx1="973.33">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_CO_CALL" Destination="TriggerCO.ID_CALL" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_CS_CALL" Destination="TriggerCS.ID_CALL" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
		</DataConnections>
		<AdapterConnections>
			<Connection Source="ValueDisplay.VALUE_OUT" Destination="CAL_OUT" dx1="300"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
