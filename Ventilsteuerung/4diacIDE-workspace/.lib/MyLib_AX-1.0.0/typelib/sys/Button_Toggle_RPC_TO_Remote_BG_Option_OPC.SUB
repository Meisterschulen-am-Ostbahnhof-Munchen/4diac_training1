<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Button_Toggle_RPC_TO_Remote_BG_Option_OPC" Comment="Wie Button_Toggle_RPC_TO_Remote_BG_OPC (IO-Diag-Taster, Loslassen ruft per&#10;CLIENT_0 eine RPC-Toggle-Methode auf dem Zielmodul auf, Hintergrundfarbe aus&#10;Remote-Subscribe), aber per AOption aktiviert statt QI/INIT. AOption_OUT reicht&#10;die Aktivierung nach dem eigenen INIT weiter (Daisy-Chain).">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-10-30" Remarks="Remote-Clients mit Remote_Init_Retry: Kette (und Option-INIT_CNF) wartet nicht mehr auf die Gegenstation, nach INITO- neuer Versuch nach 2 s (forte #1092, sonst 60 s pro fehlendem Node und danach tot).">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-10-17" Remarks="Kopie von Button_Toggle_RPC_TO_Remote_BG_OPC (Franz: 'kopieren, Variante mit AOption machen') - INIT/INITO/QI/QO ersetzt durch AOption_IN (AOption_X_TO_EVENT) und AOption_OUT (AOption_EVENT_TO_X, Daisy-Chain wie OptionalGroup_001a). AOption_OUT muss weiterverbunden sein (DummyGroup als Kettenende), sonst kommt kein INIT_CNF zurueck.">
	</VersionInfo>
