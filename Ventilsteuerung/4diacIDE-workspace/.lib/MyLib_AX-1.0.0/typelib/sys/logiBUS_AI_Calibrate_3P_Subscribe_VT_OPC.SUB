			<VarDeclaration Name="ID_MID_CALL" Type="WSTRING" Comment="Remote-Methodenadresse (ACTION=CALL_METHOD) fuer den C_MID-Trigger - ruft ID_MID_TRIGGER_METHOD direkt auf der Sensor-Station auf"/>
