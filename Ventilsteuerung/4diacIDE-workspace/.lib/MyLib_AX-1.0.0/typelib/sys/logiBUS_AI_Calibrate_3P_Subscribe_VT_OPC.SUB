			<AdapterDeclaration Name="MIDREF_OUT" Type="adapter::types::unidirectional::AR" Comment="Optional: live MID_REF-Referenzwert (= MID_REF_LIT.VALUE_OUT) fuer externe Consumer. Unverdrahtet lassen, wenn nicht gebraucht."/>
			<AdapterDeclaration Name="MAXREF_OUT" Type="adapter::types::unidirectional::AR" Comment="Optional: live MAX_REF-Referenzwert (= MAX_REF_LIT.VALUE_OUT) fuer externe Consumer. Unverdrahtet lassen, wenn nicht gebraucht."/>
		</Plugs>
	</SubAppInterfaceList>
