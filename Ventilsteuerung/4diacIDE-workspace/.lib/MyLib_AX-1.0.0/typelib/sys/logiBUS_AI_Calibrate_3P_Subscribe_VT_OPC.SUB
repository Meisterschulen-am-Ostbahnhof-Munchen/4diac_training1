			<VarDeclaration Name="ID_MAXREF_READ" Type="WSTRING" Comment="Optionale Subscribe-Adresse falls MAX_REF extern (Dashboard) ueberschrieben werden soll - unbenutzt zulaessig"/>
			<VarDeclaration Name="ID_MAXREF_WRITE" Type="WSTRING" Comment="Lokale Publish-Adresse (REAL, ACTION=PUBLISH) des MAX_REF-Referenzwerts - wird von der Sensor-Station remote abonniert (deren ID_MAXREF_READ)"/>
		</InputVars>
		<Plugs>
