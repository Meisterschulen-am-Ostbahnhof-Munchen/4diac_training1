<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Heben_Senken_TO_QDA_PWM_OPC" Comment="2 Remote-Kommandos (Heben/Senken, je Subscribe+State-Publish, ODER-verknuepft mit IO-Test wie bei ILOCK_SWITCH_2_QXA_OPC) auf 1 ratiometrisches PWM-Signal (Danfoss PVEA: 25%=Senken, 50%=Neutral, 75%=Heben, Lastteiler-korrigiert) + 1 Freigabe-DO als Klick-Toggle (AX_T_FF_INIT, Default AN, per RPC-Methode aus VT und Dashboard aus-/einschaltbar - Not-Bedienung, z.B. Strassenmodus). Generisch fuer jeden PVEA-Aktor mit 2 physischen Kanaelen (links=PWM, rechts=Freigabe), Bedienung von einem Modul ohne eigenes VT.">
	<Identification Standard="61499-2">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.3" Author="Franz Höpfinger" Date="2026-09-08" Remarks="V1.1: IO-Test fuer Heben/Senken ergaenzt (SUBSCRIBE_TEST_HEBEN/SENKEN, ODER vor dem ILOCK), Publish-Punkte (State+Test) hinter den ILOCK verlegt (wie ILOCK_SWITCH_2_QXA_OPC), Freigabe-DO von starrem initval_AX auf AX_T_FF_INIT-Klick-Toggle per RPC-Methode umgestellt - KEIN OR nach dem Flipflop, AX_T_FF_INIT.Q ist alleinige Source of Truth fuer den Ausgang. V1.2: Freigabe-DO-Teilnetz nach MyLib::sys::DO_TOGGLE_RPC_QXA_OPC ausgelagert. V1.3: PWM/ILOCK/Mux-Teilnetz nach MyLib::sys::HebenSenken_ILOCK_QDA_PWM_OPC ausgelagert - diese SubApp ist jetzt nur noch die Zusammensetzung beider Bausteine, Schnittstelle unveraendert.">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
		<Import declaration="logiBUS::io::DQ::logiBUS_DO"/>
		<Import declaration="logiBUS::io::DQ::logiBUS_DO_S"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<InputVars>
			<VarDeclaration Name="Output_PWM" Type="logiBUS::io::DQ::logiBUS_DO_S" Comment="Physischer PWM-Ausgang (linker Kanal): 25/50/75% Tastgrad, ratiometrisch" InitialValue="logiBUS_DO::Invalid"/>
			<VarDeclaration Name="Output_DO" Type="logiBUS::io::DQ::logiBUS_DO_S" Comment="Physischer Freigabe-Ausgang (rechter Kanal): Klick-Toggle, Default AN" InitialValue="logiBUS_DO::Invalid"/>
			<VarDeclaration Name="DT_PROTECT" Type="TIME" Comment="Schutz-Totzeit vor Richtungswechsel" InitialValue="T#300ms"/>
			<VarDeclaration Name="ID_HEBEN_READ" Type="WSTRING" Comment="Echtes Funktions-Kommando Heben (Subscribe)"/>
			<VarDeclaration Name="ID_HEBEN_WRITE" Type="WSTRING" Comment="Echte Funktions-Rueckmeldung Heben, HINTER dem ILOCK (Publish)"/>
			<VarDeclaration Name="ID_SENKEN_READ" Type="WSTRING" Comment="Echtes Funktions-Kommando Senken (Subscribe)"/>
			<VarDeclaration Name="ID_SENKEN_WRITE" Type="WSTRING" Comment="Echte Funktions-Rueckmeldung Senken, HINTER dem ILOCK (Publish)"/>
			<VarDeclaration Name="ID_TEST_READ_HEBEN" Type="WSTRING" Comment="Bestehende IO-Test-Subscribe-Adresse Heben (z.B. STG2_Q0x_READ), ODER-verknuepft mit ID_HEBEN_READ vor dem ILOCK"/>
			<VarDeclaration Name="ID_TEST_WRITE_HEBEN" Type="WSTRING" Comment="Bestehende IO-Test-Publish-Adresse Heben, HINTER dem ILOCK (z.B. STG2_Q0x_WRITE)"/>
			<VarDeclaration Name="ID_TEST_READ_SENKEN" Type="WSTRING" Comment="Bestehende IO-Test-Subscribe-Adresse Senken, ODER-verknuepft mit ID_SENKEN_READ vor dem ILOCK"/>
			<VarDeclaration Name="ID_TEST_WRITE_SENKEN" Type="WSTRING" Comment="Bestehende IO-Test-Publish-Adresse Senken, HINTER dem ILOCK"/>
			<VarDeclaration Name="ID_DO_TOGGLE_METHOD" Type="WSTRING" Comment="Lokale Methodenadresse (ACTION=CREATE_METHOD) fuer den argumentlosen Freigabe-Toggle-Trigger - wird von STG1 (SoftKey-Relay) UND direkt vom OPC-Dashboard (CALL_METHOD) aufgerufen, beide Aufrufer teilen sich denselben Flipflop-Takt"/>
			<VarDeclaration Name="ID_DO_STATE_WRITE" Type="WSTRING" Comment="Lokale Publish-Adresse (ACTION=WRITE) fuer den tatsaechlichen Freigabe-Zustand (AX_T_FF_INIT.Q) - wird von VT und Dashboard remote abonniert"/>
		</InputVars>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<SubApp Name="PWM_Mux" Type="MyLib::sys::HebenSenken_ILOCK_QDA_PWM_OPC" x="0" y="0">
		</SubApp>
		<SubApp Name="DO_Toggle" Type="MyLib::sys::DO_TOGGLE_RPC_QXA_OPC" x="0" y="1500">
		</SubApp>
		<DataConnections>
			<Connection Source="ID_HEBEN_READ" Destination="PWM_Mux.ID_HEBEN_READ" dx1="280">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_TEST_READ_HEBEN" Destination="PWM_Mux.ID_TEST_READ_HEBEN" dx1="280">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_TEST_WRITE_HEBEN" Destination="PWM_Mux.ID_TEST_WRITE_HEBEN" dx1="1280">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_HEBEN_WRITE" Destination="PWM_Mux.ID_HEBEN_WRITE" dx1="1280">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_SENKEN_READ" Destination="PWM_Mux.ID_SENKEN_READ" dx1="280">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_TEST_READ_SENKEN" Destination="PWM_Mux.ID_TEST_READ_SENKEN" dx1="280">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_TEST_WRITE_SENKEN" Destination="PWM_Mux.ID_TEST_WRITE_SENKEN" dx1="1280">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_SENKEN_WRITE" Destination="PWM_Mux.ID_SENKEN_WRITE" dx1="1280">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="Output_PWM" Destination="PWM_Mux.Output_PWM" dx1="6913.33">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="DT_PROTECT" Destination="PWM_Mux.DT_PROTECT" dx1="1200">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="Output_DO" Destination="DO_Toggle.Output_DO" dx1="6913.33">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_DO_TOGGLE_METHOD" Destination="DO_Toggle.ID_DO_TOGGLE_METHOD" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_DO_STATE_WRITE" Destination="DO_Toggle.ID_DO_STATE_WRITE" dx1="1280">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
		</DataConnections>
	</SubAppNetwork>
</SubAppType>
