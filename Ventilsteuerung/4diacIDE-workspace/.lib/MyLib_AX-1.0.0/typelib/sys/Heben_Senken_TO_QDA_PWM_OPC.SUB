			<Connection Source="SPLIT_HEBEN.OUT1" Destination="PUBLISH_STATE_HEBEN.IN" dx1="600"/>
			<Connection Source="SPLIT_HEBEN.OUT2" Destination="ILOCK.UP_IN" dx1="600"/>
			<Connection Source="SUBSCRIBE_SENKEN.OUT" Destination="SPLIT_SENKEN.IN" dx1="280"/>
			<Connection Source="SPLIT_SENKEN.OUT2" Destination="PUBLISH_STATE_SENKEN.IN" dx1="600"/>
			<Connection Source="SPLIT_SENKEN.OUT1" Destination="ILOCK.DOWN_IN" dx1="600"/>
			<Connection Source="ILOCK.timeOut" Destination="E_TimeOut.TimeOutSocket" dx1="666.67"/>
			<Connection Source="ILOCK.UP_OUT" Destination="ASSEMBLE_AB_FROM_AX.BIT_00" dx1="600"/>
			<Connection Source="ILOCK.DOWN_OUT" Destination="ASSEMBLE_AB_FROM_AX.BIT_01" dx1="600"/>
			<Connection Source="AR_AUI_MUX_3.OUT" Destination="AR_R_MUL_Korrektur.IN1" dx1="673.33"/>
			<Connection Source="AR_R_MUL_Korrektur.OUT" Destination="AR_R_MUL_PWM13BIT.IN1" dx1="600"/>
			<Connection Source="AR_R_MUL_PWM13BIT.OUT" Destination="AR_TO_AD_NUM.AR_IN" dx1="600"/>
			<Connection Source="AR_TO_AD_NUM.AD_OUT" Destination="DigitalOutput_PWM.OUT" dx1="600"/>
			<Connection Source="initval_AX_DO_EIN.OUT" Destination="DigitalOutput_DO.OUT" dx1="600"/>
			<Connection Source="AB_TO_AUI.AUI_OUT" Destination="AR_AUI_MUX_3.K" dx1="2106.67"/>
			<Connection Source="ASSEMBLE_AB_FROM_AX.OUT" Destination="AB_TO_AUI.AB_IN" dx1="433.33"/>
			<Connection Source="values_50_75_25.OUT_50" Destination="AR_AUI_MUX_3.IN1" dx1="540"/>
			<Connection Source="values_50_75_25.OUT_75" Destination="AR_AUI_MUX_3.IN2" dx1="540"/>
			<Connection Source="values_50_75_25.OUT_25" Destination="AR_AUI_MUX_3.IN3" dx1="540"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
