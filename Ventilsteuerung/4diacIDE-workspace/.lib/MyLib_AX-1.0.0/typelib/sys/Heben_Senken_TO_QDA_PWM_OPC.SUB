<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Heben_Senken_TO_QDA_PWM_OPC" Comment="2 Remote-Kommandos (Heben/Senken, je Subscribe+State-Publish) auf 1 ratiometrisches PWM-Signal (Danfoss PVEA: 25%=Senken, 50%=Neutral, 75%=Heben, Lastteiler-korrigiert) + 1 permanent-EIN Freigabe-DO. Generisch fuer jeden PVEA-Aktor mit 2 physischen Kanaelen (links=PWM, rechts=Stromversorgung/Freigabe), Bedienung von einem Modul ohne eigenes VT.">
	<Identification Standard="61499-2">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-07">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
		<Import declaration="logiBUS::io::DQ::logiBUS_DO"/>
		<Import declaration="logiBUS::io::DQ::logiBUS_DO_S"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<InputVars>
			<VarDeclaration Name="Output_PWM" Type="logiBUS::io::DQ::logiBUS_DO_S" Comment="Physischer PWM-Ausgang (linker Kanal): 25/50/75% Tastgrad, ratiometrisch" InitialValue="logiBUS_DO::Invalid"/>
			<VarDeclaration Name="Output_DO" Type="logiBUS::io::DQ::logiBUS_DO_S" Comment="Physischer Freigabe-Ausgang (rechter Kanal): Stromversorgung des Ventils, permanent EIN (spaeter Notabschaltung/Strassenmodus)" InitialValue="logiBUS_DO::Invalid"/>
			<VarDeclaration Name="DT_PROTECT" Type="TIME" Comment="Schutz-Totzeit vor Richtungswechsel" InitialValue="T#300ms"/>
			<VarDeclaration Name="ID_HEBEN_READ" Type="WSTRING" Comment="Echtes Funktions-Kommando Heben (Subscribe)"/>
			<VarDeclaration Name="ID_HEBEN_WRITE" Type="WSTRING" Comment="Echte Funktions-Rueckmeldung Heben (Publish)"/>
			<VarDeclaration Name="ID_SENKEN_READ" Type="WSTRING" Comment="Echtes Funktions-Kommando Senken (Subscribe)"/>
			<VarDeclaration Name="ID_SENKEN_WRITE" Type="WSTRING" Comment="Echte Funktions-Rueckmeldung Senken (Publish)"/>
		</InputVars>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="SUBSCRIBE_HEBEN" Type="adapter::net::AX_SUBSCRIBE_1" x="-12500" y="-1600">
			<Parameter Name="QI" Value="TRUE"/>
		</FB>
		<FB Name="SUBSCRIBE_SENKEN" Type="adapter::net::AX_SUBSCRIBE_1" x="-12500" y="-400">
			<Parameter Name="QI" Value="TRUE"/>
		</FB>
		<FB Name="SPLIT_HEBEN" Type="adapter::events::unidirectional::AX_SPLIT_2" x="-10700" y="-1600">
		</FB>
		<FB Name="SPLIT_SENKEN" Type="adapter::events::unidirectional::AX_SPLIT_2" x="-10700" y="-400">
		</FB>
		<FB Name="PUBLISH_STATE_HEBEN" Type="adapter::net::AX_PUBLISH_1" x="-8800" y="-2200">
			<Parameter Name="QI" Value="TRUE"/>
		</FB>
		<FB Name="PUBLISH_STATE_SENKEN" Type="adapter::net::AX_PUBLISH_1" x="-8600" y="100">
			<Parameter Name="QI" Value="TRUE"/>
		</FB>
		<SubApp Name="AR_R_MUL_Korrektur" Type="MyLib::sys::AR_R_MUL" x="200" y="-1400">
			<Parameter Name="FACTOR" Value="REAL#1.17619"/>
		</SubApp>
		<SubApp Name="AR_R_MUL_PWM13BIT" Type="MyLib::sys::AR_R_MUL" x="2600" y="-1400">
			<Parameter Name="FACTOR" Value="REAL#81.91"/>
		</SubApp>
		<FB Name="AR_TO_AD_NUM" Type="adapter::conversion::unidirectional::AR_TO_AD_NUM" x="4400" y="-1400">
		</FB>
		<FB Name="DigitalOutput_PWM" Type="logiBUS::io::DQ::logiBUS_QDA_PWM" x="6200" y="-1400">
			<Parameter Name="QI" Value="TRUE"/>
		</FB>
		<FB Name="initval_AX_DO_EIN" Type="adapter::types::unidirectional::AX::initval::initval_AX" x="4400" y="600">
			<Parameter Name="INIT_VAL" Value="TRUE"/>
		</FB>
		<FB Name="DigitalOutput_DO" Type="logiBUS::io::DQ::logiBUS_QXA" x="6200" y="600">
			<Parameter Name="QI" Value="TRUE"/>
		</FB>
		<Comment Comment="Korrekturfaktor 1,17619 = 1/0,8502 und Skalierung x81,91 = 8191/100: siehe 4diac_training1 Uebung_245/247_AX (PWM-auf-PVEA-Kompensationsrechnung als Lehrbeispiel). ILOCK_SWITCH_PROTECT_AX (Last-Wins mit Schutzzeit DT_PROTECT, gleiches Muster wie ILOCK_SWITCH_2_QXA_OPC) sorgt dafuer, dass Heben und Senken NIE gleichzeitig aktiv sind - K=3 (beide Bits gesetzt) kann dadurch nicht auftreten, deshalb genuegt ein 3-Wege- statt 4-Wege-Mux." x="-9500" y="2900" width="6400" height="900"/>
		<FB Name="ILOCK" Type="logiBUS::signalprocessing::interlock::ILOCK_SWITCH_PROTECT_AX" x="-9000" y="-1000">
		</FB>
		<FB Name="E_TimeOut" Type="iec61499::events::E_TimeOut" x="-6700" y="300">
		</FB>
		<FB Name="ASSEMBLE_AB_FROM_AX" Type="adapter::assembling::ASSEMBLE_AB_FROM_AX" x="-6800" y="-800">
		</FB>
		<FB Name="AR_AUI_MUX_3" Type="adapter::selection::unidirectional::AR_AUI_MUX_3" x="-1900" y="-2300">
		</FB>
		<FB Name="AB_TO_AUI" Type="adapter::conversion::unidirectional::AB_TO_AUI" x="-5000" y="-2400">
		</FB>
		<SubApp Name="values_50_75_25" Type="MyLib::sys::values_50_75_25" x="-3600" y="-2100">
		</SubApp>
		<DataConnections>
			<Connection Source="ID_HEBEN_READ" Destination="SUBSCRIBE_HEBEN.ID" dx1="280">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_HEBEN_WRITE" Destination="PUBLISH_STATE_HEBEN.ID" dx1="1280">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_SENKEN_READ" Destination="SUBSCRIBE_SENKEN.ID" dx1="280">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_SENKEN_WRITE" Destination="PUBLISH_STATE_SENKEN.ID" dx1="1280">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="Output_PWM" Destination="DigitalOutput_PWM.Output" dx1="6913.33">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="Output_DO" Destination="DigitalOutput_DO.Output" dx1="6913.33">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="DT_PROTECT" Destination="ILOCK.DT_PROTECT" dx1="1200">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
		</DataConnections>
