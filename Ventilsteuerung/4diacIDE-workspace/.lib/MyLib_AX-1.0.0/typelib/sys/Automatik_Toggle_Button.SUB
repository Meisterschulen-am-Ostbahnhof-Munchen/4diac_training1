<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Automatik_Toggle_Button" Comment="Automatik/Hand-Umschalter: 1 VT-Button (latched Toggle) -&gt; Automatik-Zustand als AX-Plug (AUTOMATIK) + dessen Inverses (AX_MAN, fuer PID-Regler MAN-Eingang) + lokaler Publish (ID_AUTOMATIK_STATE_WRITE) fuer VT-Status/Web-Dashboard. Wiederverwendbar fuer jede Automatik-Funktion (Oelkuehler, Aufnahme, ...).">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.7" Author="Franz Höpfinger" Date="2026-09-20" Remarks="Bugfix: seit v1.6 (Button_IE statt Softkey_IE, Latchable=0) kommt der Klick zwar an, aber der Button zeigte den AUTOMATIK-Zustand nicht mehr an - bei Latchable=1 hatte das VT dieses Feedback bisher selbst uebernommen (eigene Latched-Optik), das entfaellt jetzt. Neue SubApp Background_Automatik (GreenWhiteBackground3_AX, faerbt Button UND AUX gruen/weiss) ergaenzt, AX_SPLIT_3_Automatik auf AX_SPLIT_4_Automatik erweitert (4. Ausgang -&gt; Background_Automatik.DI1).">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.6" Author="Franz Höpfinger" Date="2026-09-20" Remarks="Bugfix: Button_Automatik_Toggle nutzte Softkey_Aux_IE (Softkey_IE) mit einer echten VT-Button-Object-ID (CButton, z.B. Button_Aufnahme_Geschwindigkeitsregelung_EinAus) - Softkey_IE empfaengt aber keine Button-Activation-Message, der Toggle-Klick kam nie an, AUTOMATIK blieb dauerhaft auf bDefaultAutomatik stehen. Neuer Baustein Button_Aux_IE (Button_IE statt Softkey_IE) - der VT-Button muss dafuer non-latching sein (Latchable=0), wird von Franz direkt im Pool umgestellt.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.5" Author="Franz Höpfinger" Date="2026-09-16" Remarks="Event-Input RESET in AUS umbenannt (Franz: 'der Eingang soll AUS heissen') - Namenskonsistenz mit AX_SoftkeyToggle_RS_TO_AX(_BG_PUBLISH)/Baender_Individual_Toggle/Baender_EinAus/Aufnahme_Automatik/Ernteseite_Antriebe.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.4" Author="Franz Höpfinger" Date="2026-09-16" Remarks="Event-Input RESET ergaenzt (rein additiv, zusaetzlich zum bestehenden Reset.IND-Pfad auf E_T_FF_Automatik.R verdrahtet) - fuer einen zentral gelesenen, gemeinsamen SoftKey (z.B. 'Alles Aus'), der mehrere Automatik-Instanzen gleichzeitig per Event zuruecksetzen soll.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.3" Author="Franz Höpfinger" Date="2026-09-15" Remarks="AUX-Unterstuetzung ergaenzt: Button_Automatik_Toggle von isobus::UT::io::Button::Button_IE (nur SoftKey) auf MyLib::sys::Softkey_Aux_IE (SoftKey ODER AUX) umgestellt, neuer optionaler InputVar u16ObjIdA_Automatik_Toggle (Default ID_NULL) - etabliertes Muster aus AX_SoftkeyToggle_RS_TO_AX.SUB uebernommen. Rein additiv, bestehende Instanzen ohne AUX-Wert funktionieren unveraendert.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.2" Author="Franz Höpfinger" Date="2026-09-13" Remarks="FORCE_ON/FORCE_OFF Sockets (AX) ergaenzt - rein FB-interne (nicht VT-Objekt-basierte) Gegenstuecke zum bestehenden VT-Reset, je per AX_R_TRIG (steigende Flanke) auf E_T_FF_Automatik.S bzw. .R. Fuer Automatik-zu-Automatik-Verknuepfungen (z.B. Befuellautomatik EIN schaltet Bunker-Ernte-Automatik automatisch mit ein; ein Kollisionsschutz schaltet eine Automatik hart aus) - rein additiv, bestehende Instanzen unveraendert nutzbar.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-09-13" Remarks="Reset-Eingang ergaenzt (u16ObjId_RESET/u16ObjIdA_RESET/ID_RESET_METHOD -&gt; MyLib::sys::Softkey_Aux_Method_IE -&gt; E_T_FF_Automatik.R), analog AX_SoftkeyToggle_RS_TO_AX - fuer eine globale Sammel-AUS-Taste (SoftKey_AUS), die die Automatik hart auf Hand/AUS zurueckschalten muss (KVE14 Funktionen und Bedingungen Zeile 19, 'Aufnahme, Saege und Baender AUS').">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-12" Remarks="initial implementation - aus Aufnahme_Automatik.SUB herausgeloest (Button_Automatik_Toggle/E_T_FF_Automatik/AX_SPLIT_3_Automatik/AX_NOT_Man/AX_PUBLISH_Automatik), generisch wiederverwendbar.">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
		<Import declaration="isobus::UT::Q::const::IDs::ID_NULL"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<SubAppEventInputs>
			<SubAppEvent Name="AUS" Type="Event" Comment="Reset hart auf Hand/AUS, von aussen als Event (z.B. 1 zentral gelesener gemeinsamer SoftKey) - zusaetzlich zum eigenen u16ObjId_RESET/u16ObjIdA_RESET/ID_RESET_METHOD-Pfad. Unverdrahtet lassen, wenn nicht gebraucht.">
			</SubAppEvent>
		</SubAppEventInputs>
		<InputVars>
			<VarDeclaration Name="u16ObjId_Automatik_Toggle" Type="UINT" Comment="Object ID VT-Button (Automatik/Hand-Umschalter)" InitialValue="ID_NULL"/>
			<VarDeclaration Name="u16ObjIdA_Automatik_Toggle" Type="UINT" Comment="Object ID AuxFunction2 (Joystick), gleichberechtigt zum VT-Button - optional, ID_NULL wenn kein AUX gebraucht wird" InitialValue="ID_NULL"/>
			<VarDeclaration Name="bDefaultAutomatik" Type="BOOL" Comment="Automatik-Zustand beim Start" InitialValue="FALSE"/>
			<VarDeclaration Name="ID_AUTOMATIK_STATE_WRITE" Type="WSTRING" Comment="Lokale Publish-Adresse (BOOL, ACTION=WRITE) fuer den Automatik-Ein/Aus-Zustand - Status-Text auf der VT + Web-Client/Dashboard"/>
			<VarDeclaration Name="u16ObjId_RESET" Type="UINT" Comment="Object ID Softkey &apos;Alles Aus&apos; (Reset, hart auf Hand/AUS) - z.B. SoftKey_AUS" InitialValue="ID_NULL"/>
			<VarDeclaration Name="u16ObjIdA_RESET" Type="UINT" Comment="Object ID AuxFunction2 (Joystick) fuer den Reset - gleichberechtigt zum Softkey &apos;Alles Aus&apos;" InitialValue="ID_NULL"/>
			<VarDeclaration Name="ID_RESET_METHOD" Type="WSTRING" Comment="Lokale Methodenadresse (ACTION=CREATE_METHOD) fuer den argumentlosen Reset-Trigger (hart auf Hand/AUS) - wird von Web-Client UND OPC-Dashboard aufgerufen"/>
		</InputVars>
		<Plugs>
			<AdapterDeclaration Name="AUTOMATIK" Type="adapter::types::unidirectional::AX" Comment="Automatik aktiv (roh, z.B. fuer eine Freigabe-UND-Verknuepfung)"/>
			<AdapterDeclaration Name="AX_MAN" Type="adapter::types::unidirectional::AX" Comment="NICHT Automatik aktiv (fuer PID-Regler MAN-Eingang)"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="FORCE_ON" Type="adapter::types::unidirectional::AX" Comment="Optional: steigende Flanke schaltet die Automatik hart EIN (z.B. von einer anderen, uebergeordneten Automatik). Unverdrahtet lassen, wenn nicht gebraucht."/>
			<AdapterDeclaration Name="FORCE_OFF" Type="adapter::types::unidirectional::AX" Comment="Optional: steigende Flanke schaltet die Automatik hart AUS (z.B. von einem Kollisionsschutz). Unverdrahtet lassen, wenn nicht gebraucht."/>
		</Sockets>
	</SubAppInterfaceList>
