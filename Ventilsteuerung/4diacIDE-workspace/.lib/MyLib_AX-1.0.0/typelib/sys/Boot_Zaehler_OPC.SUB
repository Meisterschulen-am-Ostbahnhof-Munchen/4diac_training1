<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Boot_Zaehler_OPC" Comment="STG1: meldet READY=TRUE und nimmt Boot-Meldungen der Stationen per Methode entgegen (Argument = STG-Nummer)">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-10-29" Remarks="Neu (Franz: STG1 verwaltet alle Boot-Zaehler, ohne INI). READY wird bei INIT einmal TRUE publiziert, die Stationen rufen bei steigender Flanke die Methode mit ihrer Nummer auf (Boot_Melden_OPC). E_DEMUX_6 verteilt K=2..5 auf BOOT_STG2..5.">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
	</CompilerInfo>
	<SubAppInterfaceList>
		<SubAppEventInputs>
			<SubAppEvent Name="INIT" Type="EInit" Comment="Initialization Request">
			</SubAppEvent>
		</SubAppEventInputs>
		<SubAppEventOutputs>
			<SubAppEvent Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</SubAppEvent>
			<SubAppEvent Name="BOOT_STG2" Type="Event" Comment="STG2 ist gestartet">
			</SubAppEvent>
			<SubAppEvent Name="BOOT_STG3" Type="Event" Comment="STG3 ist gestartet">
			</SubAppEvent>
			<SubAppEvent Name="BOOT_STG4" Type="Event" Comment="STG4 ist gestartet">
			</SubAppEvent>
			<SubAppEvent Name="BOOT_STG5" Type="Event" Comment="STG5 ist gestartet">
			</SubAppEvent>
		</SubAppEventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Quality Input - TRUE to enable service" InitialValue="TRUE"/>
			<VarDeclaration Name="ID_READY_WRITE" Type="WSTRING" Comment="Lokaler Knoten READY (BOOL)"/>
			<VarDeclaration Name="ID_METHOD" Type="WSTRING" Comment="Lokale Methode BOOT_MELDUNG (1 UINT-Argument)"/>
		</InputVars>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="Ready" Type="adapter::net::AX_PUBLISH_1" x="-2000" y="0">
		</FB>
		<FB Name="Ready_TRUE" Type="adapter::types::unidirectional::AX::initval::initval_AX" x="-4200" y="600">
			<Parameter Name="INIT_VAL" Value="TRUE"/>
		</FB>
		<FB Name="Boot_Methode" Type="iec61499::net::SERVER_0_1" Comment="IND-&gt;RSP sofort" x="0" y="1400">
		</FB>
		<FB Name="Boot_Verteiler" Type="iec61499::events::E_DEMUX_6" Comment="K = STG-Nummer" x="2400" y="1400">
		</FB>
		<EventConnections>
			<Connection Source="INIT" Destination="Ready.INIT"/>
			<Connection Source="Ready.INITO" Destination="Ready_TRUE.INIT"/>
			<Connection Source="Ready_TRUE.INITO" Destination="Boot_Methode.INIT"/>
			<Connection Source="Boot_Methode.INITO" Destination="INITO"/>
			<Connection Source="Boot_Methode.IND" Destination="Boot_Methode.RSP"/>
			<Connection Source="Boot_Methode.IND" Destination="Boot_Verteiler.EI"/>
			<Connection Source="Boot_Verteiler.EO3" Destination="BOOT_STG2"/>
			<Connection Source="Boot_Verteiler.EO4" Destination="BOOT_STG3"/>
			<Connection Source="Boot_Verteiler.EO5" Destination="BOOT_STG4"/>
			<Connection Source="Boot_Verteiler.EO6" Destination="BOOT_STG5"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="QI" Destination="Ready.QI"/>
			<Connection Source="ID_READY_WRITE" Destination="Ready.ID"/>
			<Connection Source="QI" Destination="Boot_Methode.QI"/>
			<Connection Source="ID_METHOD" Destination="Boot_Methode.ID"/>
			<Connection Source="Boot_Methode.RD_1" Destination="Boot_Verteiler.K"/>
		</DataConnections>
		<AdapterConnections>
			<Connection Source="Ready_TRUE.OUT" Destination="Ready.IN"/>
		</AdapterConnections>
	</SubAppNetwork>
	<Attribute Name="Documentation" Type="CDATA"><![CDATA[<h1>Boot-Zähler auf STG1</h1>
<p>STG1 veröffentlicht nach dem Start einmal <code>READY = TRUE</code>. STG2–5 abonnieren diesen Wert
(<code>Boot_Melden_OPC</code>). Sobald eine Station TRUE sieht (steigende Flanke nach ihrem eigenen Start),
ruft sie die Methode <code>BOOT_MELDUNG</code> mit ihrer STG-Nummer auf. Ein reiner Verbindungsabbruch
löst keine Flanke aus, nur ein Neustart der Station.</p>
<p>Gezählt wird in <code>Station_Alive_VT_OPC</code> (Eingang <code>BOOT</code>), nur im RAM, ohne INI.</p>
]]></Attribute>
</SubAppType>
