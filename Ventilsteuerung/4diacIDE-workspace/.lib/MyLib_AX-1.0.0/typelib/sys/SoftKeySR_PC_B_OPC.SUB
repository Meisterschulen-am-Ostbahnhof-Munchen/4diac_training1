<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="SoftKeySR_PC_B_OPC" Comment="Geraet B (Station 12, 192.168.1.12): empfaengt Set/Reset je per eigenem SERVER_0-Methodenaufruf (reiner RPC-Trigger, kein Wertwechsel-Trick, keine Bridge noetig), taktet die reine SR-Flipflop-Logik (AX_SR, kein Toggle), schaltet DigitalOutput_Q1 und schreibt den neuen Zustand aktiv per CLIENT_1_0 zurueck auf Geraet A - &apos;SUB style&apos;: das Protokoll steckt im MyLib::sys-Composite, nicht in der Resource des Geraets">
