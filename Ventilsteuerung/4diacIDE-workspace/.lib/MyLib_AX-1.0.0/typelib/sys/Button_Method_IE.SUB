<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Button_Method_IE" Comment="VT-Button (Button_IE) ODER lokale argumentlose OPC-UA-Methode (ACTION=CREATE_METHOD, SERVER_0 - z.B. von Web-Client/Dashboard oder per CLIENT_0 von einer anderen Station aufgerufen) aktiviert -&gt; 1 gemeinsames IND-Event. Analog zu Softkey_Aux_Method_IE, aber fuer einen regulaeren VT-Button statt SoftKey/AUX - herausgeloest aus logiBUS_AI_Calibrate_IDA_OPC (CO/CS kamen dort 2x identisch vor).">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-18" Remarks="initial implementation - herausgeloest aus logiBUS_AI_Calibrate_IDA_OPC (Button_IE + SERVER_0 + E_MERGE_2 kam dort 2x vor, fuer CO und CS), wiederverwendbar fuer jeden Event-Trigger, der per VT-Taste UND gleichberechtigt per Methode ausgeloest werden soll.">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
		<Import declaration="isobus::UT::io::Button::ButtonActivationCode::BT_PRESSED_LATCHED"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<SubAppEventOutputs>
			<SubAppEvent Name="IND" Type="Event" Comment="Feuert wenn der Button ODER die lokale Methode aktiviert/aufgerufen wird">
			</SubAppEvent>
		</SubAppEventOutputs>
		<InputVars>
			<VarDeclaration Name="u16ObjId" Type="UINT" Comment="Object ID Button"/>
			<VarDeclaration Name="ID_METHOD" Type="WSTRING" Comment="Lokale Methodenadresse (ACTION=CREATE_METHOD) fuer den argumentlosen Trigger - wird von Web-Client/Dashboard UND per CLIENT_0 von einer anderen Station aufgerufen"/>
		</InputVars>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="Button" Type="isobus::UT::io::Button::Button_IE" x="-200" y="0">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="InputEvent" Value="BT_PRESSED_LATCHED"/>
		</FB>
		<FB Name="METHOD_SERVER" Type="iec61499::net::SERVER_0" x="-200" y="1100">
			<Parameter Name="QI" Value="TRUE"/>
		</FB>
		<FB Name="MERGE" Type="iec61499::events::E_MERGE_2" x="1600" y="450">
		</FB>
		<Comment Comment="RSP MUSS auf IND zurueckverdrahtet werden (argumentloser Trigger, keine Verarbeitung noetig) - sonst blockiert FORTEs onServerMethodCall den OPC-UA-Server-Thread bis zu 4s und haelt dabei open62541s globalen serviceMutex, den JEDER AX_PUBLISH_1 auf einem anderen FORTE-Thread ebenfalls braucht. Siehe Ventilsteuerung/OPC_UA_VERNETZUNG.md Punkt 12." x="-1100" y="2400" width="2800" height="500"/>
		<EventConnections>
			<Connection Source="Button.IND" Destination="MERGE.EI1" dx1="780"/>
			<Connection Source="METHOD_SERVER.IND" Destination="MERGE.EI2" dx1="800"/>
			<Connection Source="METHOD_SERVER.IND" Destination="METHOD_SERVER.RSP" dx1="80" dx2="80" dy="160"/>
			<Connection Source="MERGE.EO" Destination="IND" dx1="800"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="u16ObjId" Destination="Button.u16ObjId" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_METHOD" Destination="METHOD_SERVER.ID" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
		</DataConnections>
	</SubAppNetwork>
</SubAppType>
