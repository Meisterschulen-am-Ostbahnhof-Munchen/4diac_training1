<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="logiBUS_AI_Calibrate_3P_IDA_OPC" Comment="logiBUS_AI_IDA (Analog-Eingang) mit 3-Punkt-Kalibrierung (AR_CALIBRATE_3P_REF, unabhaengig gespeicherte Rohwerte X_MIN/X_MID/X_MAX + Referenzwerte MIN_REF/MID_REF/MAX_REF alle INI-persistiert) auf VT-Zahlenfelder (Rohwert + kalibrierter Wert, je eigene CNumberVariable) + Bargraph (kalibriert) + 3 VT-Tasten (C_MIN/C_MID/C_MAX) + OPC-UA (Rohwert DWORD + kalibrierter Wert REAL, generisch, ein Kanal). Fuer Sensoren mit definierter Mittelstellung (z.B. Lenkwinkelsensor: links/geradeaus/rechts) statt reiner 2-Punkt-Linearisierung.">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof&#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
