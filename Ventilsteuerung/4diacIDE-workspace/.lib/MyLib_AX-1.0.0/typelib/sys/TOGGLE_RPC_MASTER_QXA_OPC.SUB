	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.2" Author="Franz Höpfinger" Date="2026-09-09" Remarks="Fix: TRIGGER_SERVER.RSP war nie verdrahtet - blockierte den OPC-UA-Server-Thread bis zu 4s (haelt open62541s globalen serviceMutex), verzoegerte dadurch JEDE OPC-UA-Statusmeldung projektweit. IND-&gt;RSP direkt verdrahtet. Siehe OPC_UA_VERNETZUNG.md Punkt 12.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-09-07" Remarks="OUT-Plug durch OUT1..OUT6 (AX_SPLIT_7 statt AX_SPLIT_2) ersetzt - Adapter-Verbindungen sind 1:1, ein einzelner Plug kann nicht an mehrere Sockets gleichzeitig verdrahtet werden">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-07" Remarks="initial API and implementation and/or initial documentation - fuer Scheinwerfer (6 Kanaele, 1 SoftKey, versetztes Einschalten gegen kapazitive Einschaltstrom-Spitzen)">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
	</CompilerInfo>
	<SubAppInterfaceList>
		<InputVars>
			<VarDeclaration Name="ID_TRIGGER_METHOD" Type="WSTRING" Comment="Lokale Methodenadresse (ACTION=CREATE_METHOD) fuer den argumentlosen Toggle-Trigger, wird vom Bedienmodul per CALL_METHOD aufgerufen"/>
			<VarDeclaration Name="ID_STATE_WRITE" Type="WSTRING" Comment="Lokale Publish-Adresse (ACTION=WRITE) fuer den tatsaechlichen Toggle-Zustand - wird vom Bedienmodul remote abonniert (z.B. fuer GreenWhiteBackground)"/>
		</InputVars>
		<Plugs>
			<AdapterDeclaration Name="OUT1" Type="adapter::types::unidirectional::AX" Comment="Toggle-Zustand fuer Kanal 1 (z.B. AX_TON_MERGE_QXA_OPC.MASTER)"/>
			<AdapterDeclaration Name="OUT2" Type="adapter::types::unidirectional::AX" Comment="Toggle-Zustand fuer Kanal 2"/>
			<AdapterDeclaration Name="OUT3" Type="adapter::types::unidirectional::AX" Comment="Toggle-Zustand fuer Kanal 3"/>
			<AdapterDeclaration Name="OUT4" Type="adapter::types::unidirectional::AX" Comment="Toggle-Zustand fuer Kanal 4"/>
			<AdapterDeclaration Name="OUT5" Type="adapter::types::unidirectional::AX" Comment="Toggle-Zustand fuer Kanal 5"/>
			<AdapterDeclaration Name="OUT6" Type="adapter::types::unidirectional::AX" Comment="Toggle-Zustand fuer Kanal 6"/>
		</Plugs>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="TRIGGER_SERVER" Type="iec61499::net::SERVER_0" x="-6600" y="-1200">
			<Parameter Name="QI" Value="TRUE"/>
		</FB>
		<FB Name="AX_T_FF" Type="adapter::events::unidirectional::AX_T_FF" x="-5000" y="-1100">
		</FB>
		<FB Name="SPLIT" Type="adapter::events::unidirectional::AX_SPLIT_7" x="-3200" y="-1100">
		</FB>
		<FB Name="PUBLISH_STATE" Type="adapter::net::AX_PUBLISH_1" x="-1600" y="1600">
			<Parameter Name="QI" Value="TRUE"/>
		</FB>
		<EventConnections>
			<Connection Source="TRIGGER_SERVER.IND" Destination="AX_T_FF.CLK" dx1="373.33"/>
			<Connection Source="TRIGGER_SERVER.IND" Destination="TRIGGER_SERVER.RSP"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="ID_TRIGGER_METHOD" Destination="TRIGGER_SERVER.ID" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_STATE_WRITE" Destination="PUBLISH_STATE.ID" dx1="1280">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
		</DataConnections>
		<AdapterConnections>
			<Connection Source="AX_T_FF.Q" Destination="SPLIT.IN" dx1="280"/>
			<Connection Source="SPLIT.OUT1" Destination="OUT1" dx1="1200"/>
			<Connection Source="SPLIT.OUT2" Destination="OUT2" dx1="1200"/>
			<Connection Source="SPLIT.OUT3" Destination="OUT3" dx1="1200"/>
			<Connection Source="SPLIT.OUT4" Destination="OUT4" dx1="1200"/>
			<Connection Source="SPLIT.OUT5" Destination="OUT5" dx1="1200"/>
			<Connection Source="SPLIT.OUT6" Destination="OUT6" dx1="1200"/>
			<Connection Source="SPLIT.OUT7" Destination="PUBLISH_STATE.IN" dx1="600"/>
		</AdapterConnections>
	</SubAppNetwork>
	<Attribute Name="Documentation" Type="CDATA"><![CDATA[<h1>Klick-Toggle-Kopf ohne eigenen Ausgang (fuer Kanalgruppen bis 6)</h1>

<p>Wie <code>Softkey_Toggle_RPC_TO_Remote_BG_OPC</code>/<code>Toggle_RPC_FROM_Remote_QXA_OPC</code>,
aber ohne physischen Ausgang - stattdessen wird der Toggle-Zustand ueber 6 eigene <code>OUTn</code>-Plugs
an bis zu 6 Geschwister-SubApps im selben Netzwerk weitergegeben (z.B. mehrere
<code>AX_TON_MERGE_QXA_OPC</code>-Instanzen, je eine pro physischem Kanal - Adapter-Verbindungen sind
1:1, deshalb kein einzelner gemeinsamer Plug fuer alle Kanaele). So kann EIN SoftKey mehrere Ausgaenge
gleichzeitig toggeln, jeder Kanal aber trotzdem individuell zeitversetzt hochfahren (siehe
<code>AX_TON_MERGE_QXA_OPC.PT</code>) - z.B. Scheinwerfer-Bank gegen kapazitive Einschaltstrom-Spitzen.
Werden weniger als 6 Kanaele gebraucht, bleiben die restlichen <code>OUTn</code>-Plugs einfach
unverdrahtet.</p>
]]></Attribute>
</SubAppType>
