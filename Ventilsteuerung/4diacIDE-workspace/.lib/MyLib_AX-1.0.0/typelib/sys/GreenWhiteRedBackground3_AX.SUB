			<Parameter Name="val1" Value="COLOR_GREEN"/>
		</SubApp>
		<FB Name="F_SEL_Rot" Type="adapter::iec61131::selection::AUS_AX_SEL_AUS" x="-4600" y="2200">
		</FB>
		<FB Name="initval_AUS" Type="adapter::types::unidirectional::AUS::initval::initval_AUS" x="-6000" y="2400">
			<Parameter Name="INIT_VAL" Value="COLOR_RED"/>
		</FB>
		<FB Name="AUS_SPLIT_3" Type="adapter::events::unidirectional::AUS_SPLIT_3" x="-2900" y="2200">
		</FB>
		<FB Name="Q_BackgroundColour_1" Type="isobus::UT::Q::Q_BackgroundColour_AUS" x="-1000" y="400">
		</FB>
		<FB Name="Q_BackgroundColour_2" Type="isobus::UT::Q::Q_BackgroundColour_AUS" x="-1000" y="1400">
		</FB>
		<FB Name="Q_BackgroundColour_3" Type="isobus::UT::Q::Q_BackgroundColourAux_AUS" x="-1000" y="2400">
		</FB>
		<FB Name="AND_QO" Type="iec61131::booleanOperators::AND_BOOL_3" x="1500" y="700">
		</FB>
		<EventConnections>
			<Connection Source="INIT" Destination="Q_BackgroundColour_1.INIT"/>
