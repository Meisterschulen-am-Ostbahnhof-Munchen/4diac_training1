<SubAppType Name="GreenWhiteRedBackground3_AX" Comment="Hintergrundfarbe fuer SoftKey + Aux (3 Objekte), 3 Zustaende: DI1 FALSE -&gt; Weiss, TRUE -&gt; Gruen, DI2 TRUE -&gt; Rot (Vorrang)">
