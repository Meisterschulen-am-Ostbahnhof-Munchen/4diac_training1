			<Connection Source="Q_BackgroundColour_2.INITO" Destination="Q_BackgroundColour_3.INIT"/>
			<Connection Source="Q_BackgroundColour_3.INITO" Destination="AND_QO.REQ"/>
			<Connection Source="Q_BackgroundColour_3.INITO" Destination="INITO"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="QI" Destination="Q_BackgroundColour_1.QI"/>
			<Connection Source="QI" Destination="Q_BackgroundColour_2.QI"/>
			<Connection Source="QI" Destination="Q_BackgroundColour_3.QI"/>
			<Connection Source="u16ObjId" Destination="Q_BackgroundColour_1.u16ObjId"/>
			<Connection Source="u16ObjIdA" Destination="Q_BackgroundColour_2.u16ObjId"/>
			<Connection Source="u16ObjIdA" Destination="Q_BackgroundColour_3.u16ObjId"/>
			<Connection Source="Q_BackgroundColour_1.QO" Destination="AND_QO.IN1"/>
			<Connection Source="Q_BackgroundColour_2.QO" Destination="AND_QO.IN2"/>
			<Connection Source="Q_BackgroundColour_3.QO" Destination="AND_QO.IN3"/>
