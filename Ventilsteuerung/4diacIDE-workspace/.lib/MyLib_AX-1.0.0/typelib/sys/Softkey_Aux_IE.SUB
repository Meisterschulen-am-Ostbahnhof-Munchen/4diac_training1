<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Softkey_Aux_IE" Comment="SoftKey ODER AUX-Zuweisung (Joystick) aktiviert -&gt; 1 gemeinsames IND-Event (SK_PRESSED bzw. AuxEnabled fest verdrahtet - die einzig sinnvolle 'aktiviert'-Bedeutung fuer eine Merge-Anwendung). Analog zu Softkey_Aux_IXA_TO_Remote_WRITE (Dauerzustand-ODER), aber fuer den diskreten Event-Kanal - kollidiert daher nicht mit einer bereits bestehenden Softkey_IXA/Aux_IXA-Dauerzustand-Abonnierung auf demselben Objekt (2 verschiedene Subscription-Typen).">
	<Identification Standard="61499-2">
	</Identification>
	<VersionInfo Version="1.0" Author="Franz Höpfinger" Date="2026-09-11" Remarks="initial implementation">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
		<Import declaration="isobus::UT::io::Softkey::SoftKeyActivationCode::SK_PRESSED"/>
		<Import declaration="isobus::UT::io::Auxiliary::IN::AuxiliaryState::AuxEnabled"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<SubAppEventOutputs>
			<SubAppEvent Name="IND" Type="Event" Comment="Feuert wenn SoftKey (SK_PRESSED) ODER Aux (AuxEnabled) aktiviert wird"/>
		</SubAppEventOutputs>
		<InputVars>
			<VarDeclaration Name="u16ObjId" Type="UINT" Comment="Object ID SoftKey"/>
			<VarDeclaration Name="u16ObjIdA" Type="UINT" Comment="Object ID AuxFunction2"/>
		</InputVars>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<SubApp Name="Softkey" Type="MyLib::sys::Softkey_IE_1" x="0" y="0">
			<Parameter Name="InputEvent" Value="SK_PRESSED"/>
		</SubApp>
		<SubApp Name="Aux" Type="MyLib::sys::Aux_IE_1" x="0" y="900">
			<Parameter Name="InputEvent" Value="AuxEnabled"/>
		</SubApp>
		<FB Name="MERGE" Type="iec61499::events::E_MERGE_2" x="1600" y="450">
		</FB>
		<EventConnections>
			<Connection Source="Softkey.IND" Destination="MERGE.EI1" dx1="800"/>
			<Connection Source="Aux.IND" Destination="MERGE.EI2" dx1="800"/>
			<Connection Source="MERGE.EO" Destination="IND" dx1="800"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="u16ObjId" Destination="Softkey.u16ObjId" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="u16ObjIdA" Destination="Aux.u16ObjId" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
		</DataConnections>
	</SubAppNetwork>
</SubAppType>
