	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-10-31" Remarks="Aus Getreidehacke func/Manual/ManFunc_AUF_AB3 in MyLib::sys verschoben und umbenannt, INIT/INITO/QI/QO ergaenzt, u8SAMember als Parameter.">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
