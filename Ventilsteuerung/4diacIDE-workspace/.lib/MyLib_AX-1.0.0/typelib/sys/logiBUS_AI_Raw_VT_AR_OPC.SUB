<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="logiBUS_AI_Raw_VT_AR_OPC" Comment="logiBUS_AI_IDA (Analog-Eingang, lokal) lesen -&gt; Rohwert per OPC-UA publizieren (DWORD 0-4095) + VT-Zahlenfeld (Rohwert, reine Diagnose-Anzeige) -&gt; als AR-Plug ausgeben, fertig zur Weiterverarbeitung durch einen Kalibrier-Baustein (AR_CALIBRATE_2P_REF.X / AR_CALIBRATE_3P_REF.X). Herausgeloest aus logiBUS_AI_Calibrate_IDA_OPC/_3P_IDA_OPC (logiBUS_AI_IDA+AD_SPLIT_2+AD_PUBLISH_RAW+AD_TO_AUDI+AUDI_SPLIT_2+Q_NumericValue_RAW+AUDI_TO_AR kam dort 2x identisch vor).">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-18" Remarks="initial implementation - herausgeloest aus logiBUS_AI_Calibrate_IDA_OPC/_3P_IDA_OPC, wiederverwendbar fuer jeden lokal (auf derselben Station wie die VT) angeschlossenen Analog-Eingang mit Rohwert-Publish+VT-Anzeige, unabhaengig von 2- oder 3-Punkt-Kalibrierung.">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
		<Import declaration="logiBUS::io::AI::logiBUS_AI"/>
		<Import declaration="logiBUS::io::AI::logiBUS_AI_S"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<SubAppEventOutputs>
			<SubAppEvent Name="INITO" Type="EInit" Comment="Feuert nach Initialisierung von AD_PUBLISH_RAW - Aufrufer kann seine eigene Init-Kette hier anhaengen">
			</SubAppEvent>
		</SubAppEventOutputs>
		<InputVars>
			<VarDeclaration Name="Input" Type="logiBUS::io::AI::logiBUS_AI_S" Comment="Identify the Input AnalogInput_I1..I8" InitialValue="logiBUS_AI::Invalid"/>
			<VarDeclaration Name="u16ObjId_RAWVAR" Type="UINT" Comment="Object ID CNumberVariable (Rohwert 0-4095, unkalibriert, reine Diagnose-Anzeige)"/>
			<VarDeclaration Name="ID_RAW_WRITE" Type="WSTRING" Comment="Rohwert-Ruckmelde-Adresse (DWORD 0-4095, ACTION=PUBLISH)"/>
		</InputVars>
		<Plugs>
			<AdapterDeclaration Name="AR_OUT" Type="adapter::types::unidirectional::AR" Comment="Rohwert als AR, fertig fuer CALIBRATE.X"/>
		</Plugs>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="logiBUS_AI_IDA" Type="logiBUS::io::AI::logiBUS_AI_IDA" x="-9200" y="-1700">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="PARAMS" Value="">
				<Attribute Name="Visible" Value="false"/>
			</Parameter>
			<Parameter Name="AnalogInput_hysteresis" Value="DWORD#0"/>
			<Parameter Name="TimeDelta" Value="DWORD#250"/>
			<Parameter Name="TimeRateLimit" Value="DWORD#100"/>
		</FB>
		<FB Name="AD_SPLIT_2" Type="adapter::events::unidirectional::AD_SPLIT_2" x="-7300" y="-1000">
		</FB>
		<FB Name="AD_PUBLISH_RAW" Type="adapter::net::AD_PUBLISH_1" x="-5600" y="-1700">
			<Parameter Name="QI" Value="TRUE"/>
		</FB>
		<FB Name="AD_TO_AUDI" Type="adapter::conversion::unidirectional::AD_TO_AUDI" x="-5600" y="-400">
		</FB>
		<FB Name="AUDI_SPLIT_2" Type="adapter::events::unidirectional::AUDI_SPLIT_2" x="-4000" y="-400">
		</FB>
		<FB Name="Q_NumericValue_RAW" Type="isobus::UT::Q::Q_NumericValue_AUDI" x="-2300" y="-1000">
		</FB>
		<FB Name="AUDI_TO_AR" Type="adapter::conversion::unidirectional::AUDI_TO_AR" x="-2300" y="200">
		</FB>
		<EventConnections>
			<Connection Source="AD_PUBLISH_RAW.INITO" Destination="INITO" dx1="600"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="Input" Destination="logiBUS_AI_IDA.Input" dx1="1460">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="u16ObjId_RAWVAR" Destination="Q_NumericValue_RAW.u16ObjId" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_RAW_WRITE" Destination="AD_PUBLISH_RAW.ID" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
		</DataConnections>
		<AdapterConnections>
			<Connection Source="logiBUS_AI_IDA.IN" Destination="AD_SPLIT_2.IN" dx1="420"/>
			<Connection Source="AD_SPLIT_2.OUT1" Destination="AD_PUBLISH_RAW.IN" dx1="300"/>
			<Connection Source="AD_SPLIT_2.OUT2" Destination="AD_TO_AUDI.AD_IN" dx1="300"/>
			<Connection Source="AD_TO_AUDI.AUDI_OUT" Destination="AUDI_SPLIT_2.IN" dx1="300"/>
			<Connection Source="AUDI_SPLIT_2.OUT1" Destination="Q_NumericValue_RAW.u32NewValue" dx1="300"/>
			<Connection Source="AUDI_SPLIT_2.OUT2" Destination="AUDI_TO_AR.AUDI_IN" dx1="300"/>
			<Connection Source="AUDI_TO_AR.AR_OUT" Destination="AR_OUT" dx1="300"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
