<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="SoftKeyT_PC_B_OPC_Adapter" Comment="Geraet B (Station 12, 192.168.1.12): wie Uebung_010d_PC_B_OPC, aber CLIENT_0/SERVER_0-Trigger und AX_CLIENT_1_0 sind hinter EINEM AE_AX_SERVER_0_CLIENT_1_0-Baustein hinter einem einzigen bidirektionalen Adapter-Anschluss gebuendelt; AE_AX_AX_SPLIT speist sowohl DigitalOutput_Q1 als auch die Toggle-Flipflop-Logik (AE_AX_T_FF) - &apos;SUB style&apos;: das Protokoll steckt im MyLib::sys-Composite, nicht in der Resource des Geraets">
