<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="AX_SUBSCRIBE_BG_OPC" Comment="OPC-UA Remote-Subscribe + VT-Hintergrundfarbe (generisch, ein Kanal)">
	<Identification Standard="61499-2">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-09-27" Remarks="Neuer Plug OUT (lokal) - bisher verliess der abonnierte Wert diesen Typ nur in die eigene Hintergrundfarbe, kein lokaler Zugriff fuer weitere Konsumenten moeglich (z.B. Bunkerboden-Gruen-Feedback braucht 'Bunker ausgeklappt' zusaetzlich zur eigenen IO-Grid-Anzeige). AX_SUBSCRIBE_1.OUT jetzt per neuem AX_SPLIT_2 auf GreenWhiteBackground1_AX UND OUT verzweigt.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="franz" Date="2026-08-27">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
		<Import declaration="isobus::UT::Q::const::IDs::ID_NULL"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<InputVars>
			<VarDeclaration Name="u16ObjId" Type="UINT" Comment="Object ID Hintergrund-Rechteck (VT)" InitialValue="ID_NULL"/>
			<VarDeclaration Name="ID" Type="WSTRING" Comment="OPC-UA Remote-Subscribe-Adresse"/>
		</InputVars>
		<Plugs>
			<AdapterDeclaration Name="OUT" Type="adapter::types::unidirectional::AX" Comment="Abonnierter Wert, lokal - fuer Weiterverarbeitung ohne zweiten Self-Subscribe desselben Knotens"/>
		</Plugs>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="AX_SUBSCRIBE_1" Type="adapter::net::AX_SUBSCRIBE_1" x="-800" y="-100">
			<Parameter Name="QI" Value="TRUE"/>
		</FB>
		<SubApp Name="GreenWhiteBackground1_AX" Type="MyLib::sys::GreenWhiteBackground1_AX" x="2500" y="0">
		</SubApp>
		<FB Name="AX_SPLIT_2_Out" Type="adapter::events::unidirectional::AX_SPLIT_2" x="700" y="300">
		</FB>
		<DataConnections>
			<Connection Source="ID" Destination="AX_SUBSCRIBE_1.ID" dx1="713.33">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="u16ObjId" Destination="GreenWhiteBackground1_AX.u16ObjId" dx1="526.67">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
		</DataConnections>
		<AdapterConnections>
			<Connection Source="AX_SUBSCRIBE_1.OUT" Destination="AX_SPLIT_2_Out.IN" dx1="280"/>
			<Connection Source="AX_SPLIT_2_Out.OUT1" Destination="OUT" dx1="280"/>
			<Connection Source="AX_SPLIT_2_Out.OUT2" Destination="GreenWhiteBackground1_AX.DI1" dx1="373.33"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
