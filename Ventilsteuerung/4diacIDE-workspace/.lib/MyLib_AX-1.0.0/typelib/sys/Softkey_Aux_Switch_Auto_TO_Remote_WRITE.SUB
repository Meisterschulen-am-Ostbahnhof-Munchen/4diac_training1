<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Softkey_Aux_Switch_Auto_TO_Remote_WRITE" Comment="VT-SoftKey lesen ODER AUX-Zuweisung (Joystick) lesen ODER lokaler Web-Override ODER ein zusaetzlicher physischer Taster auf einem ANDEREN Modul (Remote-Subscribe) ODER Automatik-Kommando + Remote-OPC-UA-Write an Zielmodul (generisch, ein Kanal, ohne Status-Feedback) - 5-Quellen-Erweiterung von Softkey_Aux_Switch_TO_Remote_WRITE um einen zusaetzlichen AUTO_IN-Socket (z.B. Befuellautomatik-Hysterese, die dieselbe Fuellband-Heben-Leitung ansteuert wie SoftKey/AUX/Web/physischer Taster S08).">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.2" Author="Franz Höpfinger" Date="2026-09-27" Remarks="Franz: 'die Automatik muss auch ausschalten wenn man das Fuellband manuell hebt, sonst faengt der Bunkerboden an zu laufen wenn man ueber die Schwelle kommt' - neuer Plug MANUAL_OUT (NUR SoftKey/Aux/Web/Switch, OHNE Automatik-Anteil - sonst wuerde die Automatik sich durch ihr eigenes Kommando selbst abschalten). OR_MERGE (AX_OR_5) aufgeteilt in OR_Manual (AX_OR_4, die 4 manuellen Quellen) + OR_Automatik (AX_OR_2, OR_Manual ODER AUTO_IN) - unveraendertes Gesamtverhalten fuer CMD_OUT/Remote-Write.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-13" Remarks="initial implementation - 5-Quellen-Variante von Softkey_Aux_Switch_TO_Remote_WRITE (AX_OR_5 statt AX_OR_4, zusaetzlicher AUTO_IN-Socket), fuer Fuellband Heben (Befuellautomatik-Hysterese zusaetzlich zu SoftKey/AUX/Web/physischem Taster S08).">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
		<Import declaration="isobus::UT::Q::const::IDs::ID_NULL"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<InputVars>
			<VarDeclaration Name="u16ObjId" Type="UINT" Comment="Object ID SoftKey (VT)" InitialValue="ID_NULL"/>
			<VarDeclaration Name="u16ObjIdA" Type="UINT" Comment="Object ID AuxFunction2 (VT)" InitialValue="ID_NULL"/>
			<VarDeclaration Name="ID_WRITE_REMOTE" Type="WSTRING" Comment="Remote-Write-Adresse zum Zielmodul (Befehl, ACTION=WRITE, CLIENT)"/>
			<VarDeclaration Name="ID_WEB_READ" Type="WSTRING" Comment="Lokale Subscribe-Adresse fuer einen Web-Client (z.B. vt-ui-mirror) auf demselben Modul, ODER-verknuepft mit SoftKey und AUX"/>
			<VarDeclaration Name="ID_SWITCH_REMOTE" Type="WSTRING" Comment="Remote-Subscribe-Adresse eines zusaetzlichen physischen Tasters auf einem ANDEREN Modul, ODER-verknuepft mit SoftKey/AUX/Web/Automatik"/>
		</InputVars>
		<Plugs>
			<AdapterDeclaration Name="AUTOMATIC_OUT" Type="adapter::types::unidirectional::AX" Comment="Optional: lokal gemergter Rohbefehl (SoftKey ODER AUX ODER Web ODER Switch ODER Automatik), VOR dem Remote-Write - unverdrahtet lassen, wenn nicht gebraucht"/>
			<AdapterDeclaration Name="MANUAL_OUT" Type="adapter::types::unidirectional::AX" Comment="Optional: NUR die manuellen Quellen (SoftKey ODER AUX ODER Web ODER Switch), OHNE AUTO_IN - z.B. um eine Automatik abzuschalten, wenn der Bediener manuell eingreift, ohne dass sich die Automatik durch ihr eigenes Kommando selbst abschaltet. Unverdrahtet lassen, wenn nicht gebraucht."/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="AUTO_IN" Type="adapter::types::unidirectional::AX" Comment="Autonomes Kommando (z.B. Befuellautomatik-Hysterese), ODER-verknuepft mit SoftKey/Aux/Web/physischem Taster"/>
		</Sockets>
	</SubAppInterfaceList>
