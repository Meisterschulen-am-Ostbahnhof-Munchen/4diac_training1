		</SubAppEventInputs>
		<SubAppEventOutputs>
			<SubAppEvent Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</SubAppEvent>
		</SubAppEventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Quality Input - TRUE to enable service" InitialValue="TRUE"/>
			<VarDeclaration Name="u16ObjId" Type="UINT" Comment="Object ID Button" InitialValue="ID_NULL"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Quality Output - TRUE if service executed successfully"/>
		</OutputVars>
		<Plugs>
			<AdapterDeclaration Name="OUT" Type="adapter::types::unidirectional::AX" Comment="Button ODER IN"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="IN" Type="adapter::types::unidirectional::AX" Comment="zusaetzlicher Eingang, ODER mit Button"/>
		</Sockets>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="IX" Type="isobus::UT::io::Button::Button_IXA" x="-3000" y="0">
		</FB>
		<FB Name="OR_2" Type="adapter::booleanOperators::AX_OR_2" x="-1200" y="200">
		</FB>
		<FB Name="AX_SPLIT_2" Type="adapter::events::unidirectional::AX_SPLIT_2" x="600" y="200">
		</FB>
		<SubApp Name="GreenWhiteBackground" Type="MyLib::sys::GreenWhiteBackground1_AX" x="2400" y="-400">
		</SubApp>
		<FB Name="AND_QO" Type="iec61131::booleanOperators::AND_BOOL_2" x="6000" y="-1600">
		</FB>
		<EventConnections>
			<Connection Source="INIT" Destination="IX.INIT"/>
			<Connection Source="IX.INITO" Destination="GreenWhiteBackground.INIT"/>
