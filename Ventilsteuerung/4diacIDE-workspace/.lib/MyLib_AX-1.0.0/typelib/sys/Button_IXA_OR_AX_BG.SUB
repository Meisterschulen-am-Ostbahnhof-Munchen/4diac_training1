			<Connection Source="GreenWhiteBackground.INITO" Destination="AND_QO.REQ"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="QI" Destination="IX.QI"/>
			<Connection Source="QI" Destination="GreenWhiteBackground.QI"/>
			<Connection Source="u16ObjId" Destination="IX.u16ObjId"/>
			<Connection Source="u16ObjId" Destination="GreenWhiteBackground.u16ObjId"/>
			<Connection Source="IX.QO" Destination="AND_QO.IN1"/>
			<Connection Source="GreenWhiteBackground.QO" Destination="AND_QO.IN2"/>
			<Connection Source="AND_QO.OUT" Destination="QO"/>
		</DataConnections>
		<AdapterConnections>
			<Connection Source="IX.IN" Destination="OR_2.IN1"/>
			<Connection Source="IN" Destination="OR_2.IN2"/>
			<Connection Source="OR_2.OUT" Destination="AX_SPLIT_2.IN"/>
			<Connection Source="AX_SPLIT_2.OUT1" Destination="GreenWhiteBackground.DI1"/>
			<Connection Source="AX_SPLIT_2.OUT2" Destination="OUT"/>
		</AdapterConnections>
