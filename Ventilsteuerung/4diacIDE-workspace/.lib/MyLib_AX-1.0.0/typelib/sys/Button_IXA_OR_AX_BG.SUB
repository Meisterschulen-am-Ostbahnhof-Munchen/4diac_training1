<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Button_IXA_OR_AX_BG" Comment="Button (IXA) ODER AX-Eingang, Ergebnis als Hintergrundfarbe (Gruen/Weiss) und AX-Ausgang">
