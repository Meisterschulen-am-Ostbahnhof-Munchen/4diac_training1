<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="values_50_75_25" Comment="AR-Adapter-Ausgaenge fuer eine AR_AUI_MUX_3-Sollwertauswahl (K=0-&gt;OUT_50 Neutral, K=1-&gt;OUT_75, K=2-&gt;OUT_25). OUT_50 ist fest (50.0), OUT_75/OUT_25 sind proportional zum PWM_POW-Socket (0.0-1.0): bei PWM_POW=1.0 ergeben sich exakt die mit dem Multimeter kalibrierten Rohwerte 90.0/15.0 (unveraendert gegenueber der vorherigen Version mit festen Konstanten) - kleinere PWM_POW-Werte fahren proportional dazwischen, Vorbereitung fuer eine kuenftige Joystick-Ansteuerung. Name/Plug-Bezeichnungen (_75/_25) sind historisch, die tatsaechlichen kalibrierten Werte sind 90.0/15.0.">
	<Identification Standard="61499-2">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-09-19" Remarks="OUT_75/OUT_25 von festen Konstanten auf PWM_POW-proportionale Werte umgestellt (50 +/- PWM_POW*Spanne) - Vorbereitung fuer proportionale Heben/Senken-Ansteuerung per Joystick. Bei PWM_POW=1.0 unveraendert exakt die alten, mit dem Multimeter kalibrierten Rohwerte (90.0/15.0).">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-08">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
	</CompilerInfo>
	<SubAppInterfaceList>
		<Plugs>
			<AdapterDeclaration Name="OUT_50" Type="adapter::types::unidirectional::AR" Comment="Fester Wert 50.0 (Neutral)"/>
			<AdapterDeclaration Name="OUT_75" Type="adapter::types::unidirectional::AR" Comment="50.0 + PWM_POW*40.0 - bei PWM_POW=1.0 der mit dem Multimeter kalibrierte Rohwert 90.0"/>
			<AdapterDeclaration Name="OUT_25" Type="adapter::types::unidirectional::AR" Comment="50.0 - PWM_POW*35.0 - bei PWM_POW=1.0 der mit dem Multimeter kalibrierte Rohwert 15.0"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="PWM_POW" Type="adapter::types::unidirectional::AR" Comment="PWM Power 1.0 = Maximale Power. 0.0 Aus 0.5 Halb."/>
		</Sockets>
	</SubAppInterfaceList>
