			<VarDeclaration Name="ID_TEST_READ_DOWN" Type="WSTRING" Comment="Bestehende IO-Test-Subscribe-Adresse DOWN"/>
			<VarDeclaration Name="ID_TEST_WRITE_DOWN" Type="WSTRING" Comment="Bestehende IO-Test-Publish-Adresse DOWN"/>
