<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Softkey_Aux_Web_IE" Comment="SoftKey ODER AUX (Joystick) ODER Web-Remote (OPC-UA subscribed BOOL, per SUBSCRIBE_R_TRIG auf Flanke gewandelt) aktiviert -> 1 gemeinsames IND-Event. Baut auf Softkey_Aux_IE auf (Touchscreen+Joystick, diskreter Event-Kanal) und merged zusaetzlich den Web-Kanal hinzu - Muster fuer 'egal von welcher Quelle aus aktiviert, 1 Ergebnis-Event', z.B. Override-Erkennung.">
	<Identification Standard="61499-2">
	</Identification>
	<VersionInfo Version="1.0" Author="Franz Höpfinger" Date="2026-09-11" Remarks="initial implementation">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
	</CompilerInfo>
	<SubAppInterfaceList>
		<SubAppEventOutputs>
			<SubAppEvent Name="IND" Type="Event" Comment="Feuert wenn SoftKey ODER Aux ODER Web-Remote aktiviert wird"/>
		</SubAppEventOutputs>
		<InputVars>
			<VarDeclaration Name="u16ObjId" Type="UINT" Comment="Object ID SoftKey"/>
			<VarDeclaration Name="u16ObjIdA" Type="UINT" Comment="Object ID AuxFunction2"/>
			<VarDeclaration Name="ID" Type="WSTRING" Comment="OPC-UA-Endpoint-Konstante (READ) des Web-Remote-Kanals"/>
		</InputVars>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<SubApp Name="SoftkeyAux" Type="MyLib::sys::Softkey_Aux_IE" x="0" y="0">
		</SubApp>
		<SubApp Name="WebSub" Type="MyLib::sys::SUBSCRIBE_R_TRIG" x="0" y="900">
		</SubApp>
		<FB Name="MERGE" Type="iec61499::events::E_MERGE_2" x="1600" y="450">
		</FB>
		<EventConnections>
			<Connection Source="SoftkeyAux.IND" Destination="MERGE.EI1" dx1="800"/>
			<Connection Source="WebSub.EO" Destination="MERGE.EI2" dx1="800"/>
			<Connection Source="MERGE.EO" Destination="IND" dx1="800"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="u16ObjId" Destination="SoftkeyAux.u16ObjId" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="u16ObjIdA" Destination="SoftkeyAux.u16ObjIdA" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID" Destination="WebSub.ID" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
		</DataConnections>
	</SubAppNetwork>
</SubAppType>
