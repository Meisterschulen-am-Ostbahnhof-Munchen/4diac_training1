<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Softkey_Aux_Web_IE" Comment="SoftKey ODER AUX (Joystick) ODER Web-Remote (extern zugefuehrter BOOL-Pegel, per AX_R_TRIG auf Flanke gewandelt) aktiviert -> 1 gemeinsames IND-Event. Baut auf Softkey_Aux_IE auf (Touchscreen+Joystick, diskreter Event-Kanal) und merged zusaetzlich den Web-Kanal hinzu - Muster fuer 'egal von welcher Quelle aus aktiviert, 1 Ergebnis-Event', z.B. Override-Erkennung.">
	<Identification Standard="61499-2">
	</Identification>
	<VersionInfo Version="2.0" Author="Franz Höpfinger" Date="2026-09-16" Remarks="ID-Parameter + internen SUBSCRIBE_R_TRIG (eigener lokaler OPC-UA-Self-Subscribe) entfernt, durch Socket WEB_IN (AX, Pegel von aussen) + AX_R_TRIG ersetzt - behebt Doppel-Self-Subscribe (FORTE: 'Cannot add another one'), da der Web-Knoten bereits von der Kommando-Seite (Softkey_Aux_Auto_IXA_TO_Remote_WRITE.WEB_STATE) abonniert wird. Siehe BERICHT_2026-09-16_STG3_I1_I3_I4_I6_STALE_REMOTE_SUBSCRIBE.md Abschnitt 16-17.">
	</VersionInfo>
	<VersionInfo Version="1.0" Author="Franz Höpfinger" Date="2026-09-11" Remarks="initial implementation">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
	</CompilerInfo>
	<SubAppInterfaceList>
		<SubAppEventOutputs>
			<SubAppEvent Name="IND" Type="Event" Comment="Feuert wenn SoftKey ODER Aux ODER Web-Remote aktiviert wird"/>
		</SubAppEventOutputs>
		<InputVars>
			<VarDeclaration Name="u16ObjId" Type="UINT" Comment="Object ID SoftKey"/>
			<VarDeclaration Name="u16ObjIdA" Type="UINT" Comment="Object ID AuxFunction2"/>
		</InputVars>
		<Sockets>
			<AdapterDeclaration Name="WEB_IN" Type="adapter::types::unidirectional::AX" Comment="Web-Remote-Pegel von aussen (z.B. Softkey_Aux_Auto_IXA_TO_Remote_WRITE.WEB_STATE), statt eigenem lokalen OPC-UA-Self-Subscribe"/>
		</Sockets>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<SubApp Name="SoftkeyAux" Type="MyLib::sys::Softkey_Aux_IE" x="0" y="0">
		</SubApp>
		<FB Name="WEB_R_TRIG" Type="adapter::events::unidirectional::AX_R_TRIG" x="0" y="900">
		</FB>
		<FB Name="MERGE" Type="iec61499::events::E_MERGE_2" x="1600" y="450">
		</FB>
		<EventConnections>
			<Connection Source="SoftkeyAux.IND" Destination="MERGE.EI1" dx1="800"/>
			<Connection Source="WEB_R_TRIG.EO" Destination="MERGE.EI2" dx1="800"/>
			<Connection Source="MERGE.EO" Destination="IND" dx1="800"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="u16ObjId" Destination="SoftkeyAux.u16ObjId" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="u16ObjIdA" Destination="SoftkeyAux.u16ObjIdA" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
		</DataConnections>
		<AdapterConnections>
			<Connection Source="WEB_IN" Destination="WEB_R_TRIG.QI" dx1="1400"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
