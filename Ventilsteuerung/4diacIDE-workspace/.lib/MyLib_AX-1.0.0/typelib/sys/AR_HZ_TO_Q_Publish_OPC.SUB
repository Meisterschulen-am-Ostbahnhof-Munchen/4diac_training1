<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="AR_HZ_TO_Q_Publish_OPC" Comment="Remote-Hz-Subscribe -&gt; feste Skalierung -&gt; VT-Anzeige (Q_NumericValue_PHYSA) UND per OPC-UA publiziert (AR_PUBLISH_1). Buendelt AR_SUBSCRIBE_1+initval_AR+AR_MUL_2+AR_TO_Q_Publish_OPC - ein Baustein je Puls-Geschwindigkeits-/Drehzahlsensor (Aufnahme B03, Igelband1/2 B10/B11, Saegeblatt B08), nur Parameter unterscheiden sich.">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-13" Remarks="initial implementation - herausgeloest aus Inputs_STG1.SUB (Aufnahme/Igelband1/Igelband2/Saegeblatt waren 4x nahezu identische AR_SUBSCRIBE_1+initval_AR+AR_MUL_2+AR_TO_Q_Publish_OPC-Ketten, nur Parameter unterschiedlich).">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
	</CompilerInfo>
	<SubAppInterfaceList>
		<InputVars>
			<VarDeclaration Name="ID_HZ_REMOTE" Type="WSTRING" Comment="Remote-Subscribe-Adresse der publizierten Frequenz (Hz), z.B. FBs::Ventilsteuerung::Ventilsteuerung_STG1::RemoteSubStrings::AUFNAHME_GESCHWINDIGKEIT_HZ_REMOTE"/>
			<VarDeclaration Name="SCALE" Type="REAL" Comment="Skalierungsfaktor Hz -&gt; physikalische Einheit (z.B. 3.6/53 fuer km/h, 60.0 fuer U/min bei 1 Impuls/Umdrehung)"/>
			<VarDeclaration Name="stObj" Type="logiBUS::utils::conversion::phys::NumericObjectPool_S" Comment="Object pool properties der VT-Zahlenvariable (u16ObjId, scale, offset, decimals) - z.B. FBs::const::DefaultPool_Numeric::NumberVariable_X_N"/>
			<VarDeclaration Name="ID_WRITE" Type="WSTRING" Comment="Lokale Publish-Adresse (REAL, physikalischer Wert) - Web-Mirror/Dashboard/Self-Subscribe"/>
		</InputVars>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="AR_SUBSCRIBE_Hz" Type="adapter::net::AR_SUBSCRIBE_1" x="0" y="0">
			<Parameter Name="QI" Value="TRUE"/>
		</FB>
		<FB Name="LIT_Scale" Type="adapter::types::unidirectional::AR::initval::initval_AR" x="100" y="1200">
		</FB>
		<FB Name="AR_MUL" Type="adapter::iec61131::arithmetic::AR_MUL_2" x="1800" y="600">
		</FB>
		<SubApp Name="Publish" Type="MyLib::sys::AR_TO_Q_Publish_OPC" x="3400" y="600">
		</SubApp>
		<DataConnections>
			<Connection Source="ID_HZ_REMOTE" Destination="AR_SUBSCRIBE_Hz.ID" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="SCALE" Destination="LIT_Scale.INIT_VAL" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="stObj" Destination="Publish.stObj" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_WRITE" Destination="Publish.ID_WRITE" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
		</DataConnections>
		<AdapterConnections>
			<Connection Source="AR_SUBSCRIBE_Hz.OUT" Destination="AR_MUL.IN1" dx1="600"/>
			<Connection Source="LIT_Scale.OUT" Destination="AR_MUL.IN2" dx1="600"/>
			<Connection Source="AR_MUL.OUT" Destination="Publish.AR_IN" dx1="600"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
