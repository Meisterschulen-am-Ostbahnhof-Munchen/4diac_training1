	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-04" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
		<Import declaration="logiBUS::io::DQ::logiBUS_DO"/>
		<Import declaration="logiBUS::io::DQ::logiBUS_DO_S"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<InputVars>
			<VarDeclaration Name="Output" Type="logiBUS::io::DQ::logiBUS_DO_S" Comment="Identify the Output Output_Q1..Q8" InitialValue="logiBUS_DO::Invalid"/>
			<VarDeclaration Name="ID_SET_METHOD" Type="WSTRING" Comment="Lokale Methodenadresse (ACTION=CREATE_METHOD) fuer den Set-Methodenaufruf, wird von Geraet A per CALL_METHOD aufgerufen"/>
			<VarDeclaration Name="ID_RESET_METHOD" Type="WSTRING" Comment="Lokale Methodenadresse (ACTION=CREATE_METHOD) fuer den Reset-Methodenaufruf, wird von Geraet A per CALL_METHOD aufgerufen"/>
			<VarDeclaration Name="ID_STATE_WRITE" Type="WSTRING" Comment="Remote-Ziel-Adresse (BOOL, ACTION=WRITE) fuer den Flipflop-Zustand auf Geraet A"/>
		</InputVars>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="TRIGGER" Type="adapter::net::ASR_AX_SERVER_0_CLIENT_1_0" x="-7200" y="-500">
			<Parameter Name="QI" Value="TRUE"/>
		</FB>
		<FB Name="SPLIT" Type="adapter::events::bidirectional::ASR_AX_AX_SPLIT" x="-4600" y="-100">
		</FB>
		<FB Name="FLIPFLOP" Type="adapter::events::bidirectional::ASR_AX_SR_2" x="-1800" y="-800">
		</FB>
		<FB Name="DigitalOutput_Q1" Type="logiBUS::io::DQ::logiBUS_QXA" x="-1600" y="-200">
			<Parameter Name="QI" Value="TRUE"/>
		</FB>
		<DataConnections>
			<Connection Source="Output" Destination="DigitalOutput_Q1.Output" dx1="4046.67">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_SET_METHOD" Destination="TRIGGER.ID_SET" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_RESET_METHOD" Destination="TRIGGER.ID_RESET" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_STATE_WRITE" Destination="TRIGGER.ID_STATE" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
		</DataConnections>
		<AdapterConnections>
			<Connection Source="TRIGGER.S_R" Destination="SPLIT.IN" dx1="900"/>
			<Connection Source="SPLIT.OUT" Destination="FLIPFLOP.S_R" dx1="580"/>
			<Connection Source="SPLIT.AX_OUT" Destination="DigitalOutput_Q1.OUT" dx1="488.24"/>
		</AdapterConnections>
