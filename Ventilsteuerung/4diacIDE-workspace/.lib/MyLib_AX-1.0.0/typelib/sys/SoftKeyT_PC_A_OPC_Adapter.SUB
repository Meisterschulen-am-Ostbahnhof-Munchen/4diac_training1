<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="SoftKeyT_PC_A_OPC_Adapter" Comment="Geraet A (Station 11, 192.168.1.11): wie Uebung_010d_PC_A_OPC, aber HMI (SoftKey + GreenWhiteBackground) und OPC-UA-Trigger sind getrennt - SoftKeyT_AE_AX buendelt die HMI hinter einem AE_AX-Plug, AE_AX_CLIENT_0_SUBSCRIBE_1 buendelt CLIENT_0 + AX_SUBSCRIBE_1 hinter einem AE_AX-Socket - &apos;SUB style&apos;: das Protokoll steckt im MyLib::sys-Composite, nicht in der Resource des Geraets">
