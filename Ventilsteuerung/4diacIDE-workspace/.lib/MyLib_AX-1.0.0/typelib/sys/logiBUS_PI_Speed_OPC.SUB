			<Connection Source="DerivK.INITO" Destination="AND_QO.REQ"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="Input" Destination="logiBUS_PI_IDA.Input" dx1="1460">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_HZ_WRITE" Destination="AR_PUBLISH_HZ.ID" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_FILTER_TIME_READ" Destination="FilterTimeS.ID_READ" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_FILTER_TIME_WRITE" Destination="FilterTimeS.ID_WRITE" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="sSection" Destination="INI_FilterTimeS.SECTION" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="SCALE" Destination="LIT_Scale.INIT_VAL" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="RASTER" Destination="Round_Final.RASTER" dx1="300">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_WRITE" Destination="AR_PUBLISH_Speed.ID" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_DERIV_K_READ" Destination="DerivK.ID_READ" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_DERIV_K_WRITE" Destination="DerivK.ID_WRITE" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="sSection" Destination="INI_DerivK.SECTION" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="QI" Destination="logiBUS_PI_IDA.QI"/>
			<Connection Source="QI" Destination="AR_PUBLISH_HZ.QI"/>
			<Connection Source="QI" Destination="AR_PUBLISH_Speed.QI"/>
			<Connection Source="QI" Destination="INI_FilterTimeS.QI"/>
			<Connection Source="QI" Destination="INI_DerivK.QI"/>
			<Connection Source="logiBUS_PI_IDA.QO" Destination="AND_QO.IN1"/>
			<Connection Source="AR_PUBLISH_HZ.QO" Destination="AND_QO.IN2"/>
			<Connection Source="AR_PUBLISH_Speed.QO" Destination="AND_QO.IN3"/>
			<Connection Source="INI_FilterTimeS.QO" Destination="AND_QO.IN4"/>
			<Connection Source="INI_DerivK.QO" Destination="AND_QO.IN5"/>
			<Connection Source="AND_QO.OUT" Destination="QO"/>
			<Connection Source="QI" Destination="FilterTimeS.QI"/>
			<Connection Source="QI" Destination="DerivK.QI"/>
			<Connection Source="FilterTimeS.QO" Destination="AND_QO.IN6"/>
			<Connection Source="DerivK.QO" Destination="AND_QO.IN7"/>
		</DataConnections>
		<AdapterConnections>
			<Connection Source="logiBUS_PI_IDA.IN" Destination="AD_TO_AR_NUM.AD_IN" dx1="420"/>
