			<Connection Source="FilterTimeS.VALUEO" Destination="INI_FilterTimeS.VAL" dx1="400"/>
			<Connection Source="FilterTimeS.VALUE_OUT" Destination="ToATM.IN1" dx1="400"/>
			<Connection Source="ToATM.OUT" Destination="FT_PT1_AR.TM" dx1="400"/>
			<Connection Source="FT_PT1_AR.AR_OUT" Destination="AR_SPLIT_2.IN" dx1="133.33"/>
			<Connection Source="AR_SPLIT_2.OUT1" Destination="AR_PUBLISH_HZ.IN" dx1="300"/>
			<Connection Source="AR_SPLIT_2.OUT2" Destination="AR_MUL.IN1" dx1="300"/>
			<Connection Source="LIT_Scale.OUT" Destination="AR_MUL.IN2" dx1="300"/>
