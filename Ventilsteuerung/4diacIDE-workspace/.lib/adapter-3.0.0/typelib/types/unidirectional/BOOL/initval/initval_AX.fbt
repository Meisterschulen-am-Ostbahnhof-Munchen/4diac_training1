	</VersionInfo>
	<CompilerInfo packageName="adapter::types::unidirectional::AX::initval">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Initialization Request">
				<With Var="INIT_VAL"/>
			</Event>
