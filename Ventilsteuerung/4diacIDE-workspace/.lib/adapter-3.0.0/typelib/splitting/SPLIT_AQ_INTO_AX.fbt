<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="SPLIT_AQ_INTO_AX" Comment="this Function splits the 2 AX (BOOL) adapters from a AQ (QUARTER). Jedes&#10;Eingangsereignis erzeugt Ereignisse an beiden Ausgaengen.">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-11-13" Remarks="Initial Version - Luecke in der Adapter-Familie geschlossen">
	</VersionInfo>
	<CompilerInfo packageName="adapter::splitting">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="BIT_00" Type="adapter::types::unidirectional::AX" Comment="Bool Bit 0" x="700" y="0"/>
			<AdapterDeclaration Name="BIT_01" Type="adapter::types::unidirectional::AX" Comment="Bool Bit 1" x="700" y="500"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="IN" Type="adapter::types::unidirectional::AQ" Comment="QUARTER Input" x="-1200" y="200"/>
		</Sockets>
	</InterfaceList>
	<BasicFB>
		<ECC>
			<ECState Name="START" Comment="Initial State" x="400" y="200">
			</ECState>
			<ECState Name="S_SPLIT" x="1600" y="200">
				<ECAction Algorithm="CALC" Output="BIT_00.E1"/>
				<ECAction Output="BIT_01.E1"/>
			</ECState>
			<ECTransition Source="START" Destination="S_SPLIT" Condition="IN.E1" x="1000" y="0"/>
			<ECTransition Source="S_SPLIT" Destination="START" Condition="1" x="1000" y="500"/>
		</ECC>
		<Algorithm Name="CALC" Comment="Bit 0 -> BIT_00, Bit 1 -> BIT_01">
			<ST><![CDATA[BIT_00.D1 := (IN.D1 AND BYTE#1) <> BYTE#0;
BIT_01.D1 := (IN.D1 AND BYTE#2) <> BYTE#0;
]]></ST>
		</Algorithm>
	</BasicFB>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
