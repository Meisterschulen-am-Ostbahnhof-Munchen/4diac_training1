<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ASRT_AX_SERVER_0_CLIENT_1_0" Comment="Receive 3 independent remote OPC-UA method calls via SERVER_0 (Set/Reset/Toggle) and write the resulting state back via CLIENT_1_0, driven by an ASRT_AX bidirectional adapter Plug">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH &#10; &#10;This program and the accompanying materials are made &#10;available under the terms of the Eclipse Public License 2.0 &#10;which is available at https://www.eclipse.org/legal/epl-2.0/ &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-03" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="adapter::net">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Initialization">
				<With Var="QI"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL"/>
			<VarDeclaration Name="ID_SET" Type="WSTRING" Comment="Lokale Methodenadresse (ACTION=CREATE_METHOD) fuer den Set-Methodenaufruf"/>
			<VarDeclaration Name="ID_RESET" Type="WSTRING" Comment="Lokale Methodenadresse (ACTION=CREATE_METHOD) fuer den Reset-Methodenaufruf"/>
			<VarDeclaration Name="ID_TOGGLE" Type="WSTRING" Comment="Lokale Methodenadresse (ACTION=CREATE_METHOD) fuer den Toggle-Methodenaufruf"/>
			<VarDeclaration Name="ID_STATE" Type="WSTRING" Comment="Remote-Ziel-Adresse (ACTION=WRITE) fuer den Zustand"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="TRUE nur wenn SET_SERVER, RESET_SERVER, TOGGLE_SERVER und STATE_CLIENT aktuell alle QO=TRUE melden"/>
			<VarDeclaration Name="STATUS_SET" Type="WSTRING" Comment="STATUS von SET_SERVER"/>
			<VarDeclaration Name="STATUS_RESET" Type="WSTRING" Comment="STATUS von RESET_SERVER"/>
			<VarDeclaration Name="STATUS_TOGGLE" Type="WSTRING" Comment="STATUS von TOGGLE_SERVER"/>
			<VarDeclaration Name="STATUS_STATE" Type="WSTRING" Comment="STATUS von STATE_CLIENT"/>
		</OutputVars>
		<Plugs>
			<AdapterDeclaration Name="S_R_T" Type="adapter::types::bidirectional::ASRT_AX" Comment="Set/Reset/Toggle (in), Zustand (out)" x="0" y="-700"/>
		</Plugs>
	</InterfaceList>
	<FBNetwork>
		<FB Name="SET_SERVER" Type="iec61499::net::SERVER_0" x="-300" y="-2100">
		</FB>
		<FB Name="RESET_SERVER" Type="iec61499::net::SERVER_0" x="-300" y="-1200">
		</FB>
		<FB Name="TOGGLE_SERVER" Type="iec61499::net::SERVER_0" x="-300" y="-300">
		</FB>
		<FB Name="E_D_FF" Type="iec61499::events::E_D_FF" x="1000" y="900">
		</FB>
		<FB Name="STATE_CLIENT" Type="iec61499::net::CLIENT_1_0" x="2300" y="900">
		</FB>
		<FB Name="AND_QO" Type="iec61131::booleanOperators::AND_BOOL_4" x="3800" y="1700">
		</FB>
		<EventConnections>
			<Connection Source="INIT" Destination="SET_SERVER.INIT"/>
			<Connection Source="SET_SERVER.INITO" Destination="RESET_SERVER.INIT"/>
			<Connection Source="RESET_SERVER.INITO" Destination="TOGGLE_SERVER.INIT"/>
			<Connection Source="TOGGLE_SERVER.INITO" Destination="STATE_CLIENT.INIT"/>
			<Connection Source="STATE_CLIENT.INITO" Destination="INITO"/>
			<Connection Source="STATE_CLIENT.INITO" Destination="AND_QO.REQ"/>
			<Connection Source="SET_SERVER.IND" Destination="S_R_T.SET" dx1="373.33"/>
			<Connection Source="RESET_SERVER.IND" Destination="S_R_T.RESET"/>
			<Connection Source="TOGGLE_SERVER.IND" Destination="S_R_T.TOGGLE" dx1="373.33"/>
			<Connection Source="S_R_T.EI1" Destination="E_D_FF.CLK"/>
			<Connection Source="E_D_FF.EO" Destination="STATE_CLIENT.REQ" dx1="673.33"/>
			<Connection Source="SET_SERVER.IND" Destination="AND_QO.REQ"/>
			<Connection Source="RESET_SERVER.IND" Destination="AND_QO.REQ"/>
			<Connection Source="TOGGLE_SERVER.IND" Destination="AND_QO.REQ"/>
			<Connection Source="STATE_CLIENT.CNF" Destination="AND_QO.REQ"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="QI" Destination="SET_SERVER.QI" dx1="3640"/>
			<Connection Source="QI" Destination="RESET_SERVER.QI" dx1="3640"/>
			<Connection Source="QI" Destination="TOGGLE_SERVER.QI" dx1="3640"/>
			<Connection Source="QI" Destination="STATE_CLIENT.QI" dx1="3640"/>
			<Connection Source="ID_SET" Destination="SET_SERVER.ID" dx1="1400"/>
			<Connection Source="ID_RESET" Destination="RESET_SERVER.ID" dx1="1400"/>
			<Connection Source="ID_TOGGLE" Destination="TOGGLE_SERVER.ID" dx1="1400"/>
			<Connection Source="ID_STATE" Destination="STATE_CLIENT.ID" dx1="1000"/>
			<Connection Source="S_R_T.DI1" Destination="E_D_FF.D"/>
			<Connection Source="E_D_FF.Q" Destination="STATE_CLIENT.SD_1" dx1="506.67"/>
			<Connection Source="SET_SERVER.QO" Destination="AND_QO.IN1"/>
			<Connection Source="RESET_SERVER.QO" Destination="AND_QO.IN2"/>
			<Connection Source="TOGGLE_SERVER.QO" Destination="AND_QO.IN3"/>
			<Connection Source="STATE_CLIENT.QO" Destination="AND_QO.IN4"/>
			<Connection Source="AND_QO.OUT" Destination="QO"/>
			<Connection Source="SET_SERVER.STATUS" Destination="STATUS_SET"/>
			<Connection Source="RESET_SERVER.STATUS" Destination="STATUS_RESET"/>
			<Connection Source="TOGGLE_SERVER.STATUS" Destination="STATUS_TOGGLE"/>
			<Connection Source="STATE_CLIENT.STATUS" Destination="STATUS_STATE"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
