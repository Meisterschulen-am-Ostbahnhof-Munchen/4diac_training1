<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ASRT_AX_CLIENT_0_SUBSCRIBE_1" Comment="Trigger 3 independent remote OPC-UA method calls via CLIENT_0 (Set/Reset/Toggle) and read the resulting state back via SUBSCRIBE_1, driven by an ASRT_AX bidirectional adapter Socket">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH &#10; &#10;This program and the accompanying materials are made &#10;available under the terms of the Eclipse Public License 2.0 &#10;which is available at https://www.eclipse.org/legal/epl-2.0/ &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-03" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="adapter::net">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Initialization">
				<With Var="QI"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL"/>
			<VarDeclaration Name="ID_SET" Type="WSTRING" Comment="Remote-Methodenadresse fuer den Set-Aufruf"/>
			<VarDeclaration Name="ID_RESET" Type="WSTRING" Comment="Remote-Methodenadresse fuer den Reset-Aufruf"/>
			<VarDeclaration Name="ID_TOGGLE" Type="WSTRING" Comment="Remote-Methodenadresse fuer den Toggle-Aufruf"/>
			<VarDeclaration Name="ID_STATE" Type="WSTRING" Comment="Lokal ueberwachter Zustandsknoten (ACTION=READ)"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="TRUE nur wenn SET_CLIENT, RESET_CLIENT, TOGGLE_CLIENT und STATE_SUBSCRIBE aktuell alle QO=TRUE melden"/>
			<VarDeclaration Name="STATUS_SET" Type="WSTRING" Comment="STATUS von SET_CLIENT"/>
			<VarDeclaration Name="STATUS_RESET" Type="WSTRING" Comment="STATUS von RESET_CLIENT"/>
			<VarDeclaration Name="STATUS_TOGGLE" Type="WSTRING" Comment="STATUS von TOGGLE_CLIENT"/>
			<VarDeclaration Name="STATUS_STATE" Type="WSTRING" Comment="STATUS von STATE_SUBSCRIBE"/>
		</OutputVars>
		<Sockets>
			<AdapterDeclaration Name="S_R_T" Type="adapter::types::bidirectional::ASRT_AX" Comment="Set/Reset/Toggle (out), Zustand (in)" x="0" y="-700"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="SET_CLIENT" Type="iec61499::net::CLIENT_0" x="-300" y="-2100">
		</FB>
		<FB Name="RESET_CLIENT" Type="iec61499::net::CLIENT_0" x="-300" y="-1200">
		</FB>
		<FB Name="TOGGLE_CLIENT" Type="iec61499::net::CLIENT_0" x="-300" y="-300">
		</FB>
		<FB Name="STATE_SUBSCRIBE" Type="iec61499::net::SUBSCRIBE_1" x="-300" y="900">
		</FB>
		<FB Name="E_D_FF" Type="iec61499::events::E_D_FF" x="1000" y="900">
		</FB>
		<FB Name="AND_QO" Type="iec61131::booleanOperators::AND_BOOL_4" x="2500" y="1700">
		</FB>
		<EventConnections>
			<Connection Source="INIT" Destination="SET_CLIENT.INIT"/>
			<Connection Source="SET_CLIENT.INITO" Destination="RESET_CLIENT.INIT"/>
			<Connection Source="RESET_CLIENT.INITO" Destination="TOGGLE_CLIENT.INIT"/>
			<Connection Source="TOGGLE_CLIENT.INITO" Destination="STATE_SUBSCRIBE.INIT"/>
			<Connection Source="STATE_SUBSCRIBE.INITO" Destination="INITO"/>
			<Connection Source="STATE_SUBSCRIBE.INITO" Destination="AND_QO.REQ"/>
			<Connection Source="S_R_T.SET" Destination="SET_CLIENT.REQ" dx1="546.67"/>
			<Connection Source="S_R_T.RESET" Destination="RESET_CLIENT.REQ" dx1="546.67"/>
			<Connection Source="S_R_T.TOGGLE" Destination="TOGGLE_CLIENT.REQ" dx1="100"/>
			<Connection Source="STATE_SUBSCRIBE.IND" Destination="E_D_FF.CLK" dx1="673.33"/>
			<Connection Source="E_D_FF.EO" Destination="S_R_T.EI1"/>
			<Connection Source="SET_CLIENT.CNF" Destination="AND_QO.REQ"/>
			<Connection Source="RESET_CLIENT.CNF" Destination="AND_QO.REQ"/>
			<Connection Source="TOGGLE_CLIENT.CNF" Destination="AND_QO.REQ"/>
			<Connection Source="STATE_SUBSCRIBE.IND" Destination="AND_QO.REQ"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="QI" Destination="SET_CLIENT.QI" dx1="3640"/>
			<Connection Source="QI" Destination="RESET_CLIENT.QI" dx1="3640"/>
			<Connection Source="QI" Destination="TOGGLE_CLIENT.QI" dx1="3640"/>
			<Connection Source="QI" Destination="STATE_SUBSCRIBE.QI" dx1="3640"/>
			<Connection Source="ID_SET" Destination="SET_CLIENT.ID" dx1="3606.67"/>
			<Connection Source="ID_RESET" Destination="RESET_CLIENT.ID" dx1="3573.33"/>
			<Connection Source="ID_TOGGLE" Destination="TOGGLE_CLIENT.ID" dx1="3506.67"/>
			<Connection Source="ID_STATE" Destination="STATE_SUBSCRIBE.ID" dx1="1000"/>
			<Connection Source="STATE_SUBSCRIBE.RD_1" Destination="E_D_FF.D" dx1="506.67"/>
			<Connection Source="E_D_FF.Q" Destination="S_R_T.DI1"/>
			<Connection Source="SET_CLIENT.QO" Destination="AND_QO.IN1"/>
			<Connection Source="RESET_CLIENT.QO" Destination="AND_QO.IN2"/>
			<Connection Source="TOGGLE_CLIENT.QO" Destination="AND_QO.IN3"/>
			<Connection Source="STATE_SUBSCRIBE.QO" Destination="AND_QO.IN4"/>
			<Connection Source="AND_QO.OUT" Destination="QO"/>
			<Connection Source="SET_CLIENT.STATUS" Destination="STATUS_SET"/>
			<Connection Source="RESET_CLIENT.STATUS" Destination="STATUS_RESET"/>
			<Connection Source="TOGGLE_CLIENT.STATUS" Destination="STATUS_TOGGLE"/>
			<Connection Source="STATE_SUBSCRIBE.STATUS" Destination="STATUS_STATE"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
