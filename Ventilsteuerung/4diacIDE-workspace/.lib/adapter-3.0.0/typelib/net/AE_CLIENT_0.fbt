<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AE_CLIENT_0" Comment="Trigger a remote OPC-UA method call via CLIENT_0, driven by an AE adapter Socket (1 Event)">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0"/>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-03" Remarks="initial API and implementation and/or initial documentation"/>
	<CompilerInfo packageName="adapter::net">
	</CompilerInfo>
	<InterfaceList>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL"/>
			<VarDeclaration Name="ID" Type="WSTRING"/>
		</InputVars>
		<Sockets>
			<AdapterDeclaration Name="TRIGGER" Type="adapter::types::unidirectional::AE" Comment="Trigger" x="0" y="-700"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="CLIENT_0_1" Type="iec61499::net::CLIENT_0" x="-300" y="0">
		</FB>
		<EventConnections>
			<Connection Source="TRIGGER.E1" Destination="CLIENT_0_1.REQ" dx1="1000"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="QI" Destination="CLIENT_0_1.QI" dx1="1000"/>
			<Connection Source="ID" Destination="CLIENT_0_1.ID" dx1="1000"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
