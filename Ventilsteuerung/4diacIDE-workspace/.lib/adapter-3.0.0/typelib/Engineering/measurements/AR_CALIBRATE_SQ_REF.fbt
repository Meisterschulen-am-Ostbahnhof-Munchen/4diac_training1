<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AR_CALIBRATE_SQ_REF" Comment="Adapter-based sequential two-point calibration (offset then scale) with ECC-enforced order - reference targets (Y_Offset/Y_Scale) are live AR sockets, persisted via 2 additional AR2 plugs (ZERO/SPAN)">
	<Identification Standard="61499-1">
	</Identification>
	<VersionInfo Version="1.0" Author="Meisterschulen am Ostbahnhof" Date="2026-08-31">
	</VersionInfo>
	<CompilerInfo packageName="adapter::Engineering::measurements">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="Y" Type="adapter::types::unidirectional::AR" Comment="Calibrated Output"/>
			<AdapterDeclaration Name="OFFSET" Type="adapter::types::bidirectional::AR2" Comment="Stored offset value (initial 0.0)"/>
			<AdapterDeclaration Name="SCALE" Type="adapter::types::bidirectional::AR2" Comment="Stored scale value (initial 1.0)"/>
			<AdapterDeclaration Name="ZERO" Type="adapter::types::bidirectional::AR2" Comment="Persisted low-point target reference (Y_Offset / Nullpunkt)"/>
			<AdapterDeclaration Name="SPAN" Type="adapter::types::bidirectional::AR2" Comment="Persisted high-point target reference (Y_Scale / Spanne)"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="X" Type="adapter::types::unidirectional::AR" Comment="Raw Input"/>
			<AdapterDeclaration Name="CO" Type="adapter::types::unidirectional::AX" Comment="Calibrate Offset"/>
			<AdapterDeclaration Name="CS" Type="adapter::types::unidirectional::AX" Comment="Calibrate Scale"/>
			<AdapterDeclaration Name="Y_Offset" Type="adapter::types::bidirectional::AR2" Comment="Target output Y at low calibration point (ZERO) - live edit in via EI1/DI1, persisted/restored value echoed back out via EO1/DO1 for VT/web display"/>
			<AdapterDeclaration Name="Y_Scale" Type="adapter::types::bidirectional::AR2" Comment="Target output Y at high calibration point (SPAN) - live edit in via EI1/DI1, persisted/restored value echoed back out via EO1/DO1 for VT/web display"/>
		</Sockets>
	</InterfaceList>
	<BasicFB>
		<InternalVars>
			<VarDeclaration Name="X_LOW_INT" Type="REAL" Comment="Stored raw value at CO"/>
			<VarDeclaration Name="Y_LOW_INT" Type="REAL" Comment="Stored target value at CO"/>
		</InternalVars>
		<ECC>
			<ECState Name="IDLE" x="0" y="0">
			</ECState>
			<ECState Name="REQ" x="-1120" y="-1280">
				<ECAction Algorithm="REQ" Output="Y.E1"/>
			</ECState>
			<ECState Name="CO" x="2320" y="160">
				<ECAction Algorithm="CO" Output="OFFSET.EO1"/>
			</ECState>
			<ECState Name="WAIT_CS" x="2960" y="-1760">
			</ECState>
			<ECState Name="REQ_WAIT" x="480" y="-1760">
				<ECAction Algorithm="REQ" Output="Y.E1"/>
			</ECState>
			<ECState Name="CS" x="3360" y="-240">
				<ECAction Algorithm="CS" Output="SCALE.EO1"/>
				<ECAction Output="OFFSET.EO1"/>
			</ECState>
			<ECState Name="ZERO_ECHO" x="2160" y="800">
				<ECAction Algorithm="ZERO_ECHO" Output="ZERO.EO1"/>
			</ECState>
			<ECState Name="SPAN_ECHO" x="1360" y="1440">
				<ECAction Algorithm="SPAN_ECHO" Output="SPAN.EO1"/>
			</ECState>
			<ECState Name="Y_OFFSET_DISP" x="-2080" y="2080">
				<ECAction Algorithm="Y_OFFSET_DISP"/>
			</ECState>
			<ECState Name="Y_SCALE_DISP" x="-1520" y="1680">
				<ECAction Algorithm="Y_SCALE_DISP"/>
			</ECState>
			<ECTransition Source="IDLE" Destination="REQ" Condition="X.E1" x="-253.33" y="-940"/>
			<ECTransition Source="REQ" Destination="IDLE" Condition="1" x="-526.67" y="-826.67"/>
			<ECTransition Source="IDLE" Destination="CO" Condition="CO.E1[CO.D1]" x="1540" y="33.33"/>
			<ECTransition Source="CO" Destination="WAIT_CS" Condition="1" x="2773.33" y="-960"/>
			<ECTransition Source="WAIT_CS" Destination="REQ_WAIT" Condition="X.E1" x="2313.33" y="-2326.67"/>
			<ECTransition Source="REQ_WAIT" Destination="WAIT_CS" Condition="1" x="2186.67" y="-1986.67"/>
			<ECTransition Source="WAIT_CS" Destination="CS" Condition="CS.E1[CS.D1]" x="3680" y="-893.33"/>
			<ECTransition Source="CS" Destination="IDLE" Condition="1" x="1620" y="-240"/>
			<ECTransition Source="WAIT_CS" Destination="CO" Condition="CO.E1[CO.D1]" x="2466.67" y="-1046.67"/>
			<ECTransition Source="IDLE" Destination="REQ" Condition="OFFSET.EI1" x="-486.67" y="-566.67"/>
			<ECTransition Source="IDLE" Destination="REQ" Condition="SCALE.EI1" x="-806.67" y="-433.33"/>
			<ECTransition Source="WAIT_CS" Destination="REQ_WAIT" Condition="OFFSET.EI1" x="2253.33" y="-2220"/>
			<ECTransition Source="WAIT_CS" Destination="REQ_WAIT" Condition="SCALE.EI1" x="2220" y="-2106.67"/>
			<ECTransition Source="IDLE" Destination="ZERO_ECHO" Condition="Y_Offset.EO1" x="1586.67" y="646.67"/>
			<ECTransition Source="ZERO_ECHO" Destination="IDLE" Condition="1" x="1966.67" y="560"/>
			<ECTransition Source="IDLE" Destination="SPAN_ECHO" Condition="Y_Scale.EO1" x="900" y="1006.67"/>
			<ECTransition Source="SPAN_ECHO" Destination="IDLE" Condition="1" x="1126.67" y="780"/>
			<ECTransition Source="IDLE" Destination="Y_OFFSET_DISP" Condition="ZERO.EI1" x="-1693.33" y="520"/>
			<ECTransition Source="Y_OFFSET_DISP" Destination="IDLE" Condition="1" x="-1473.33" y="766.67"/>
			<ECTransition Source="IDLE" Destination="Y_SCALE_DISP" Condition="SPAN.EI1" x="-753.33" y="933.33"/>
			<ECTransition Source="Y_SCALE_DISP" Destination="IDLE" Condition="1" x="-1046.67" y="840"/>
		</ECC>
		<Algorithm Name="REQ" Comment="REQ">
			<ST><![CDATA[
(* calculate calibrated output *)
Y.D1 := (X.D1 + OFFSET.DI1) * SCALE.DI1;
]]></ST>
		</Algorithm>
		<Algorithm Name="CO" Comment="CO">
			<ST><![CDATA[
X_LOW_INT := X.D1;
Y_LOW_INT := ZERO.DI1;
IF SCALE.DI1 <> 0.0 THEN
	OFFSET.DO1 := ZERO.DI1 / SCALE.DI1 - X.D1;
ELSE
	OFFSET.DO1 := ZERO.DI1 - X.D1;
END_IF;
]]></ST>
		</Algorithm>
		<Algorithm Name="CS" Comment="CS">
			<ST><![CDATA[
IF (X.D1 - X_LOW_INT) <> 0.0 THEN
	SCALE.DO1 := (SPAN.DI1 - Y_LOW_INT) / (X.D1 - X_LOW_INT);
	IF SCALE.DO1 <> 0.0 THEN
		OFFSET.DO1 := Y_LOW_INT / SCALE.DO1 - X_LOW_INT;
	END_IF;
END_IF;
]]></ST>
		</Algorithm>
		<Algorithm Name="ZERO_ECHO" Comment="Persist live Y_Offset reference (ZERO) to INI">
			<ST><![CDATA[
ZERO.DO1 := Y_Offset.DI1;
]]></ST>
		</Algorithm>
		<Algorithm Name="SPAN_ECHO" Comment="Persist live Y_Scale reference (SPAN) to INI">
			<ST><![CDATA[
SPAN.DO1 := Y_Scale.DI1;
]]></ST>
		</Algorithm>
		<Algorithm Name="Y_OFFSET_DISP" Comment="Echo the persisted/restored ZERO value back out through Y_Offset for VT/web display (boot and after every change)">
			<ST><![CDATA[
Y_Offset.DO1 := ZERO.DI1;
]]></ST>
		</Algorithm>
		<Algorithm Name="Y_SCALE_DISP" Comment="Echo the persisted/restored SPAN value back out through Y_Scale for VT/web display (boot and after every change)">
			<ST><![CDATA[
Y_Scale.DO1 := SPAN.DI1;
]]></ST>
		</Algorithm>
	</BasicFB>
	<Attribute Name="Documentation" Type="CDATA"><![CDATA[<h2>Formula</h2>

<pre>
Y = (X + OFFSET) * SCALE</pre>

<h2>Reference Targets (Y_Offset / Y_Scale) are live AR Sockets</h2>

<p>Unlike <strong>AR_CALIBRATE_SQ</strong>, the two target values are not plain
InputVars set via a <code>SET</code> event - they are live <strong>AR2</strong>
(bidirectional) Sockets (<code>Y_Offset</code>, <code>Y_Scale</code>), fed
from an external VT/web reader via <code>EI1</code>/<code>DI1</code>. Every
time a new value arrives, it is immediately mirrored out through the
<strong>AR2</strong> Plugs <code>ZERO</code>/<code>SPAN</code> so it can be
persisted (INI_AR2 or NVS_AR2) exactly like <code>OFFSET</code>/<code>SCALE</code>
already are.</p>

<p><strong>Boot/display echo:</strong> whenever <code>ZERO.EI1</code>/
<code>SPAN.EI1</code> fires (the persisted-or-default value arriving from the
external <code>INI_AR2</code>, at boot or right after any live write's
round-trip), that value is immediately echoed back out through
<code>Y_Offset.EO1</code>/<code>Y_Scale.EO1</code>. Since these are now
bidirectional sockets, the external VT/web reader (which owns the matching
Plug) receives this echo on its own <code>DI1</code>/<code>EI1</code> and can
push it straight to the VT/web display - this is what makes a
boot-restored value actually show up on screen without the operator having to
re-enter it first.</p>

<p><strong>Important:</strong> exactly like <code>OFFSET</code>/<code>SCALE</code>,
the <code>CO</code>/<code>CS</code> algorithms never read the raw incoming
<code>Y_Offset.D1</code>/<code>Y_Scale.D1</code> directly for their math - they
read the round-tripped <code>ZERO.DI1</code>/<code>SPAN.DI1</code> instead (the
value echoed back by the external INI_AR2, which requires
<code>SETM=TRUE</code> on that instance to actually echo). This keeps both
reference values consistent with what's really persisted, and is what makes a
boot-restored default usable without the operator having to re-enter it first.</p>

<h2>Calibration (Two-Point, ECC-Enforced)</h2>

<ol>
	<li><strong>Offset (CO):</strong> Apply low reference, set Y_Offset (ZERO) to desired output, trigger CO<br />
	OFFSET := ZERO.DI1 / SCALE - X &rarr; after CO, Y <strong>always</strong> equals ZERO.DI1 (independent of SCALE)</li>
	<li><strong>Scale (CS):</strong> Apply high reference, set Y_Scale (SPAN) to desired output, trigger CS<br />
	Calculates SCALE and OFFSET decoupled using both reference points (SPAN.DI1 and the CO-time ZERO.DI1) &rarr; after CS, the line passes exactly through both points</li>
</ol>

<p><strong>Note:</strong> Both Y_Offset and Y_Scale are target values on the <strong>output side</strong>.</p>

<ul>
	<li>CS is only reachable <strong>after</strong> offset calibration (state WAIT_CS) &ndash; enforced by ECC</li>
	<li>CO can be repeated at any time to re-calibrate offset</li>
	<li>Normal calculation via X.E1 works in all states</li>
</ul>
]]></Attribute>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
