<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ASSEMBLE_AQ_FROM_AX" Comment="this Function combines the 2 AX (BOOL) adapters to a AQ (QUARTER). Jedes&#10;Eingangsereignis erzeugt ein Ausgangsereignis.">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-11-13" Remarks="Initial Version - Luecke in der Adapter-Familie geschlossen">
	</VersionInfo>
	<CompilerInfo packageName="adapter::assembling">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="OUT" Type="adapter::types::unidirectional::AQ" Comment="QUARTER Output (Bit 0 und 1)" x="3100" y="100"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="BIT_00" Type="adapter::types::unidirectional::AX" Comment="Bool Bit 0" x="-1200" y="-300"/>
			<AdapterDeclaration Name="BIT_01" Type="adapter::types::unidirectional::AX" Comment="Bool Bit 1" x="-1200" y="200"/>
		</Sockets>
	</InterfaceList>
	<BasicFB>
		<ECC>
			<ECState Name="START" Comment="Initial State" x="400" y="200">
			</ECState>
			<ECState Name="S_CALC" x="1600" y="200">
				<ECAction Algorithm="CALC" Output="OUT.E1"/>
			</ECState>
			<ECTransition Source="START" Destination="S_CALC" Condition="BIT_00.E1" x="1000" y="0"/>
			<ECTransition Source="START" Destination="S_CALC" Condition="BIT_01.E1" x="1000" y="400"/>
			<ECTransition Source="S_CALC" Destination="START" Condition="1" x="1000" y="700"/>
		</ECC>
		<Algorithm Name="CALC" Comment="BIT_00 -> Bit 0, BIT_01 -> Bit 1">
			<ST><![CDATA[OUT.D1 := BYTE#0;
IF BIT_00.D1 THEN
	OUT.D1 := OUT.D1 OR BYTE#1;
END_IF;
IF BIT_01.D1 THEN
	OUT.D1 := OUT.D1 OR BYTE#2;
END_IF;
]]></ST>
		</Algorithm>
	</BasicFB>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
