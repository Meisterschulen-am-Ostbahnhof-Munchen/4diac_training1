<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="A2X_AND_2_UNGATED" Comment="Composite FB: boolean AND zwischen 2 A2X-Adaptern, UP und DOWN getrennt, OHNE Aenderungserkennung (AX_AND_2_UNGATED)">
	<Identification Standard="61499-2" Function="OUT.UP = AND(INi.UP), OUT.DOWN = AND(INi.DOWN), je Kanal ueber AX_AND_2_UNGATED" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-11-13" Remarks="Initial Version - Luecke in der Adapter-Familie geschlossen">
	</VersionInfo>
	<CompilerInfo packageName="adapter::booleanOperators">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="OUT" Type="adapter::types::unidirectional::A2X" Comment="AND result" x="4200" y="700"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="IN1" Type="adapter::types::unidirectional::A2X" Comment="AND input 1" x="200" y="0"/>
			<AdapterDeclaration Name="IN2" Type="adapter::types::unidirectional::A2X" Comment="AND input 2" x="200" y="700"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="SPLIT1" Type="adapter::conversion::unidirectional::A2X_2X_TO_2AX" x="1000" y="0">
		</FB>
		<FB Name="SPLIT2" Type="adapter::conversion::unidirectional::A2X_2X_TO_2AX" x="1000" y="700">
		</FB>
		<FB Name="AND_UP" Type="adapter::booleanOperators::AX_AND_2_UNGATED" x="2200" y="0">
		</FB>
		<FB Name="AND_DOWN" Type="adapter::booleanOperators::AX_AND_2_UNGATED" x="2200" y="1400">
		</FB>
		<FB Name="JOIN" Type="adapter::conversion::unidirectional::A2X_2AX_TO_2X" x="3300" y="700">
		</FB>
		<AdapterConnections>
			<Connection Source="IN1" Destination="SPLIT1.A2X_IN"/>
			<Connection Source="IN2" Destination="SPLIT2.A2X_IN"/>
			<Connection Source="SPLIT1.UP" Destination="AND_UP.IN1"/>
			<Connection Source="SPLIT2.UP" Destination="AND_UP.IN2"/>
			<Connection Source="SPLIT1.DOWN" Destination="AND_DOWN.IN1"/>
			<Connection Source="SPLIT2.DOWN" Destination="AND_DOWN.IN2"/>
			<Connection Source="AND_UP.OUT" Destination="JOIN.UP"/>
			<Connection Source="AND_DOWN.OUT" Destination="JOIN.DOWN"/>
			<Connection Source="JOIN.A2X_OUT" Destination="OUT"/>
		</AdapterConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
