<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="FIFO_UINT_Adapter" Comment="FIFO-Warteschlange fuer UINT-Werte mit frei waehlbarer Kapazitaet - wie&#10;FIFO::FIFO_UINT, aber OHNE eigene DATA/PROCESSED-Events auf der&#10;Konsumentenseite: der Konsument haengt stattdessen per Socket am Plug&#10;OUT_DATA (Typ AFIFO_UINT) an. Die Verarbeitungs-Quittung laeuft ueber den&#10;Rueckkanal des Adapters selbst (PROCESSED), kein separater Wrapper noetig.">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-10-13" Remarks="Adapter-Variante von FIFO::FIFO_UINT (kein Wrapper): die Konsumentenseite (bisher DATA/PROCESSED als normale Events) wird durch den Plug OUT_DATA (AFIFO_UINT) ersetzt - PROCESSED kommt ueber den eigenen Rueckkanal des Adapters zurueck, analog AX_FB_T_FF (RST.E1/CLK.E1 als ECC-Transition-Bedingung auf Socket-Events).">
	</VersionInfo>
	<CompilerInfo packageName="FIFO_adapter">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
				<With Var="QI"/>
				<With Var="CAPACITY"/>
				<With Var="BUF"/>
			</Event>
			<Event Name="RST" Type="Event" Comment="Queue leeren">
			</Event>
			<Event Name="PUSH" Type="Event" Comment="IN ans Ende der Queue anhaengen, falls Platz vorhanden">
				<With Var="IN"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialisierung bestaetigt">
				<With Var="QO"/>
				<With Var="BUF"/>
			</Event>
			<Event Name="RSTO" Type="Event" Comment="Reset bestaetigt">
				<With Var="N"/>
			</Event>
			<Event Name="PUSHO" Type="Event" Comment="PUSH bestaetigt (OK=FALSE wenn Queue voll war)">
				<With Var="N"/>
				<With Var="OK"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Event Input Qualifier"/>
			<VarDeclaration Name="CAPACITY" Type="UINT" Comment="Kapazitaet = Anzahl Elemente von BUF, z.B. ermittelt ueber F_LEN_ARRAY hinter einer PROVIDE_ARR_x_UINT-Instanz"/>
			<VarDeclaration Name="IN" Type="UINT" Comment="Zu pushender Wert"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Event Output Qualifier"/>
			<VarDeclaration Name="N" Type="UINT" Comment="Anzahl aktuell wartender (noch nicht ausgelieferter) Elemente"/>
			<VarDeclaration Name="OK" Type="BOOL" Comment="TRUE wenn der letzte PUSH erfolgreich war (Queue war nicht voll)"/>
		</OutputVars>
		<InOutVars>
			<VarDeclaration Name="BUF" Type="UINT" ArraySize="*" Comment="Ringpuffer-Speicher - Groesse wird extern ueber eine angeschlossene PROVIDE_ARR_x_UINT-Instanz vorgegeben"/>
		</InOutVars>
		<Plugs>
			<AdapterDeclaration Name="OUT_DATA" Type="FIFO_adapter::AFIFO_UINT" Comment="Konsument haengt per Socket hier an - DATA liefert den naechsten Wert, PROCESSED (Rueckkanal) quittiert"/>
		</Plugs>
	</InterfaceList>
	<BasicFB>
		<InternalVars>
			<VarDeclaration Name="PTR" Type="UINT" Comment="Schreibposition fuer den naechsten PUSH"/>
			<VarDeclaration Name="OUTPTR" Type="UINT" Comment="Leseposition fuer den naechsten auszuliefernden Wert"/>
			<VarDeclaration Name="DELIVERING" Type="BOOL" Comment="TRUE = ein Wert wurde per OUT_DATA.DATA geliefert, auf OUT_DATA.PROCESSED wird gewartet"/>
		</InternalVars>
		<ECC>
			<ECState Name="START" Comment="Initial State" x="800" y="80">
			</ECState>
			<ECState Name="S_INIT" x="2200" y="-700">
				<ECAction Algorithm="INIT_ALG" Output="INITO"/>
			</ECState>
			<ECState Name="S_RST" x="2200" y="-200">
				<ECAction Algorithm="RST" Output="RSTO"/>
			</ECState>
			<ECState Name="S_PUSH" x="2200" y="300">
				<ECAction Algorithm="PUSH" Output="PUSHO"/>
			</ECState>
			<ECState Name="S_PROCESSED" x="2200" y="800">
				<ECAction Algorithm="PROCESSED_ALG"/>
			</ECState>
			<ECState Name="S_DELIVER" x="3600" y="550" Comment="Naechsten Wert aus der Queue entnehmen und ueber den Plug ausliefern">
				<ECAction Algorithm="DELIVER" Output="OUT_DATA.DATA"/>
			</ECState>
			<ECTransition Source="START" Destination="S_INIT" Condition="INIT" x="1500" y="-700"/>
			<ECTransition Source="START" Destination="S_RST" Condition="RST" x="1500" y="-200"/>
			<ECTransition Source="START" Destination="S_PUSH" Condition="PUSH" x="1500" y="300"/>
			<ECTransition Source="START" Destination="S_PROCESSED" Condition="OUT_DATA.PROCESSED" x="1500" y="800"/>
			<ECTransition Source="S_INIT" Destination="START" Condition="1" x="1500" y="-950"/>
			<ECTransition Source="S_RST" Destination="START" Condition="1" x="1500" y="-450"/>
			<ECTransition Source="S_PUSH" Destination="S_DELIVER" Condition="OK AND NOT DELIVERING AND N&gt;0" x="2900" y="420"/>
			<ECTransition Source="S_PUSH" Destination="START" Condition="1" x="1500" y="50"/>
			<ECTransition Source="S_PROCESSED" Destination="S_DELIVER" Condition="N&gt;0" x="2900" y="680"/>
			<ECTransition Source="S_PROCESSED" Destination="START" Condition="1" x="1500" y="1050"/>
			<ECTransition Source="S_DELIVER" Destination="START" Condition="1" x="2900" y="80"/>
		</ECC>
		<Algorithm Name="INIT_ALG" Comment="Queue leeren und QI/QO durchreichen">
			<ST><![CDATA[PTR := 0;
OUTPTR := 0;
N := 0;
DELIVERING := FALSE;
OK := FALSE;
QO := QI;
]]></ST>
		</Algorithm>
		<Algorithm Name="RST" Comment="Queue leeren">
			<ST><![CDATA[PTR := 0;
OUTPTR := 0;
N := 0;
DELIVERING := FALSE;
OK := FALSE;
]]></ST>
		</Algorithm>
		<Algorithm Name="PUSH" Comment="Wert anhaengen, falls Platz vorhanden">
			<ST><![CDATA[IF N >= CAPACITY THEN
    OK := FALSE;
ELSE
    OK := TRUE;
    BUF[PTR] := IN;
    PTR := (PTR + 1) MOD CAPACITY;
    N := N + 1;
END_IF;
]]></ST>
		</Algorithm>
		<Algorithm Name="PROCESSED_ALG" Comment="Liefer-Sperre aufheben - das naechste DATA folgt ueber die Transition nach S_DELIVER, falls die Queue noch Elemente enthaelt">
			<ST><![CDATA[DELIVERING := FALSE;
]]></ST>
		</Algorithm>
		<Algorithm Name="DELIVER" Comment="Vordersten Wert entnehmen und ueber den Plug liefern">
			<ST><![CDATA[OUT_DATA.OUT := BUF[OUTPTR];
OUTPTR := (OUTPTR + 1) MOD CAPACITY;
N := N - 1;
DELIVERING := TRUE;
]]></ST>
		</Algorithm>
	</BasicFB>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
