			<VarDeclaration Name="LL" Type="REAL" Comment="Unterer Grenzwert (REAL)" InitialValue="-1000.0"/>
			<VarDeclaration Name="LH" Type="REAL" Comment="Oberer Grenzwert (REAL)" InitialValue="1000.0"/>
		</InputVars>
		<Sockets>
