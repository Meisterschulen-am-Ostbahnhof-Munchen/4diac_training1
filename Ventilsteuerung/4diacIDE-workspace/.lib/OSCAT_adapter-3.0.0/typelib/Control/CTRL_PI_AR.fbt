			<AdapterDeclaration Name="SET" Type="adapter::types::unidirectional::AR" Comment="Sollwert (REAL, dynamisch berechnet)" x="-1400" y="-900"/>
			<AdapterDeclaration Name="AX_MAN" Type="adapter::types::unidirectional::AX" Comment="Handbetrieb Umschaltung (BOOL/Event, optional)" x="-1400" y="-400"/>
			<AdapterDeclaration Name="M_I" Type="adapter::types::unidirectional::AR" Comment="Handwert (REAL, dynamisch)" x="-1400" y="100"/>
			<AdapterDeclaration Name="KP" Type="adapter::types::unidirectional::AR" Comment="Proportionalbeiwert (REAL, dynamisch)" x="-1400" y="600"/>
			<AdapterDeclaration Name="KI" Type="adapter::types::unidirectional::AR" Comment="Integralbeiwert (REAL, dynamisch)" x="-1400" y="1100"/>
		</Sockets>
		<Plugs>
			<AdapterDeclaration Name="AR_Y" Type="adapter::types::unidirectional::AR" Comment="Stellwert (REAL)" x="5300" y="200"/>
			<AdapterDeclaration Name="AR_DIFF" Type="adapter::types::unidirectional::AR" Comment="Regelabweichung / Differenz (REAL)" x="5100" y="700"/>
			<AdapterDeclaration Name="AB_LIM" Type="adapter::types::unidirectional::AB" Comment="Begrenzung aktiv Flag (BOOL)" x="5100" y="1200"/>
		</Plugs>
