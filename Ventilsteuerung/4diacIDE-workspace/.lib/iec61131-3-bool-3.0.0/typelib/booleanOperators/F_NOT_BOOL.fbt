<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="F_NOT_BOOL" Comment="standard boolean NOT function - realisiert ueber NOOP mit negierter Datenverbindung (kein externes F_NOT noetig)">
	<Identification Standard="61131-3" Classification="standard boolean function" Description="Copyright (c) 2011 TU Wien ACIN, HR Agrartechnik GmbH&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="3.1" Author="Franz Höpfinger" Date="2026-10-11" Remarks="Interne Umsetzung wrapt jetzt NOOP (+ Negated-Attribut auf der IN-Datenverbindung) statt iec61131::bitwiseOperators::F_NOT - damit entfaellt die letzte iec61131-3-Abhaengigkeit dieses Pakets. Instanzname F_NOT auf Negate umbenannt (Type ist jetzt NOOP, Name war sonst irrefuehrend). Organization-Attribut ergaenzt (XSD-Pflichtfeld).">
	</VersionInfo>
	<VersionInfo Organization="TU Wien ACIN" Version="1.0" Author="Monika Wenger" Date="2011-06-21" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<VersionInfo Organization="Eclipse 4diac" Version="3.0" Author="Patrick Aigner" Date="2025-04-14" Remarks="changed package">
	</VersionInfo>
	<CompilerInfo packageName="iec61131::booleanOperators">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Service Request">
				<With Var="IN"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="Confirmation of Requested Service">
				<With Var="OUT"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="IN" Type="BOOL" Comment="Input"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="OUT" Type="BOOL" Comment="Output"/>
		</OutputVars>
	</InterfaceList>
	<FBNetwork>
		<FB Name="Negate" Type="iec61131::booleanOperators::NOOP" Comment="Reiner Durchreicher, die eigentliche Negation passiert auf der IN-Datenverbindung (Negated=true)" x="3800" y="300">
		</FB>
		<EventConnections>
			<Connection Source="REQ" Destination="Negate.REQ" dx1="1880"/>
			<Connection Source="Negate.CNF" Destination="CNF" dx1="2973.33"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="IN" Destination="Negate.IN" dx1="1100">
				<Attribute Name="Negated" Value="true"/>
			</Connection>
			<Connection Source="Negate.OUT" Destination="OUT" dx1="3360"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
