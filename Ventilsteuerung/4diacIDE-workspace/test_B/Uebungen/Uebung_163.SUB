<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Uebung_163" Comment="Übung zu logiBUS_ENC_ID und logiBUS_QW_SERVO: Servo mit dem Drehgeber stellen">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-11-26" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="Uebungen">
		<Import declaration="Uebungen::const::UT::DefaultPool::OutputNumber_N1"/>
		<Import declaration="logiBUS::io::ENC::logiBUS_ENC::Encoder_E1"/>
		<Import declaration="logiBUS::io::DI::logiBUS_DI::Input_I9"/>
		<Import declaration="logiBUS::io::DI::logiBUS_DI_Events::BUTTON_SINGLE_CLICK"/>
		<Import declaration="logiBUS::io::DQ::logiBUS_DO::Output_Q1"/>
	</CompilerInfo>
	<SubAppInterfaceList>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="Drehgeber_E1" Type="logiBUS::io::ENC::logiBUS_ENC_ID" Comment="Trainer20: A = GPIO22, B = GPIO23" x="-15000" y="0">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="Encoder" Value="Encoder_E1"/>
			<Parameter Name="Resolution" Value="1"/>
			<Parameter Name="TimeDelta" Value="0"/>
			<Parameter Name="TimeRateLimit" Value="50"/>
		</FB>
		<FB Name="Position" Type="iec61131::conversion::F_DWORD_TO_DINT" x="-11500" y="0">
		</FB>
		<FB Name="Mal_5" Type="iec61131::arithmetic::F_MUL" Comment="5 Grad je Raste" x="-8500" y="0">
			<Parameter Name="IN2" Value="DINT#5"/>
		</FB>
		<FB Name="Plus_90" Type="iec61131::arithmetic::F_ADD" Comment="Position 0 = Mitte 90 Grad" x="-5500" y="0">
			<Parameter Name="IN2" Value="DINT#90"/>
		</FB>
		<FB Name="Winkel" Type="iec61131::selection::F_LIMIT" Comment="0 bis 180 Grad" x="-2500" y="0">
			<Parameter Name="MN" Value="DINT#0"/>
			<Parameter Name="MX" Value="DINT#180"/>
		</FB>
		<FB Name="Mal_64255" Type="iec61131::arithmetic::F_MUL" Comment="180 Grad = 16#FAFF" x="500" y="0">
			<Parameter Name="IN2" Value="DINT#64255"/>
		</FB>
		<FB Name="Durch_180" Type="iec61131::arithmetic::F_DIV" x="3500" y="0">
			<Parameter Name="IN2" Value="DINT#180"/>
		</FB>
		<FB Name="Als_WORD" Type="iec61131::conversion::F_DINT_TO_WORD" x="6500" y="0">
		</FB>
		<FB Name="Servo_Q1" Type="logiBUS::io::DO_SERVO::logiBUS_QW_SERVO" Comment="0 Grad = PULSE_MIN, 180 Grad = PULSE_MAX" x="9500" y="0">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="Output" Value="Output_Q1"/>
			<Parameter Name="FREQ" Value="50"/>
			<Parameter Name="PULSE_MIN" Value="T#500us"/>
			<Parameter Name="PULSE_MAX" Value="T#2500us"/>
		</FB>
		<FB Name="Winkel_UDINT" Type="iec61131::conversion::F_DINT_TO_UDINT" x="500" y="3000">
		</FB>
		<FB Name="Anzeige_N1" Type="isobus::UT::Q::Q_NumericValue" Comment="Winkel in Grad am VT" x="3500" y="3000">
			<Parameter Name="u16ObjId" Value="OutputNumber_N1"/>
		</FB>
		<FB Name="DigitalInput_CLK_I9" Type="logiBUS::io::DI::logiBUS_IE" Comment="Taster am Drehgeber: zurück auf 90 Grad" x="-19000" y="3000">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="Input" Value="Input_I9"/>
			<Parameter Name="InputEvent" Value="BUTTON_SINGLE_CLICK"/>
		</FB>
		<Comment Comment="Servo mit dem Inkrementalgeber stellen (Trainer20: Drehgeber A = GPIO22, B = GPIO23, Taster = I9, Servo an Q1).&#10;Position 0 = Mitte 90 Grad. Je Raste 5 Grad: ins Minus Richtung 0 Grad, ins Plus Richtung 180 Grad. F_LIMIT hält den Winkel zwischen 0 und 180 Grad.&#10;Winkel * 64255 / 180 ergibt OUT (0..16#FAFF) für logiBUS_QW_SERVO. Der Winkel steht am VT auf OutputNumber N1.&#10;Beim Start fragt INITO die Position einmal ab, der Servo fährt auf 90 Grad. I9 Klick: RST, zurück auf 90 Grad.&#10;PULSE_MIN/PULSE_MAX (hier 500/2500 us für 0/180 Grad) laut Datenblatt des Servos anpassen. Viele Servos machen mit 1000/2000 us nur etwa 90 Grad Weg." x="-19000" y="-2600" width="12000" height="2000"/>
		<EventConnections>
			<Connection Source="Drehgeber_E1.INITO" Destination="Drehgeber_E1.REQ"/>
			<Connection Source="Drehgeber_E1.IND" Destination="Position.REQ"/>
			<Connection Source="Drehgeber_E1.CNF" Destination="Position.REQ"/>
			<Connection Source="Position.CNF" Destination="Mal_5.REQ"/>
			<Connection Source="Mal_5.CNF" Destination="Plus_90.REQ"/>
			<Connection Source="Plus_90.CNF" Destination="Winkel.REQ"/>
			<Connection Source="Winkel.CNF" Destination="Mal_64255.REQ"/>
			<Connection Source="Mal_64255.CNF" Destination="Durch_180.REQ"/>
			<Connection Source="Durch_180.CNF" Destination="Als_WORD.REQ"/>
			<Connection Source="Als_WORD.CNF" Destination="Servo_Q1.REQ"/>
			<Connection Source="Winkel.CNF" Destination="Winkel_UDINT.REQ"/>
			<Connection Source="Winkel_UDINT.CNF" Destination="Anzeige_N1.REQ"/>
			<Connection Source="DigitalInput_CLK_I9.IND" Destination="Drehgeber_E1.RST"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="Drehgeber_E1.IN" Destination="Position.IN"/>
			<Connection Source="Position.OUT" Destination="Mal_5.IN1"/>
			<Connection Source="Mal_5.OUT" Destination="Plus_90.IN1"/>
			<Connection Source="Plus_90.OUT" Destination="Winkel.IN"/>
			<Connection Source="Winkel.OUT" Destination="Mal_64255.IN1"/>
			<Connection Source="Mal_64255.OUT" Destination="Durch_180.IN1"/>
			<Connection Source="Durch_180.OUT" Destination="Als_WORD.IN"/>
			<Connection Source="Als_WORD.OUT" Destination="Servo_Q1.OUT"/>
			<Connection Source="Winkel.OUT" Destination="Winkel_UDINT.IN"/>
			<Connection Source="Winkel_UDINT.OUT" Destination="Anzeige_N1.u32NewValue"/>
		</DataConnections>
	</SubAppNetwork>
</SubAppType>
