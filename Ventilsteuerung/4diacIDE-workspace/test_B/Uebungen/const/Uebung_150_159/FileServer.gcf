	<OriginalSource><![CDATA[(*
 * Übungen 156-159: File Server Client und Server (ISO 11783-13).
 * File Server im NAME: Funktion 61 (F_FILESERVER, Global_NAME_Functions),
 * unabhängig von der Industriegruppe. Filter prüft nur bFunction.
 * Pfade ohne Volume landen im aktuellen Verzeichnis des Servers.
 * CCI 1200: Volume heißt nach der FAT-Seriennummer (\\E82C-0533\).
 *)
PACKAGE Uebungen::const::Uebung_150_159;

IMPORT isobus::pgn::NAMEFIELD_T;

GLOBALCONSTANTS FileServer
	VAR_GLOBAL CONSTANT
		FS_ADD : NAMEFIELD_T := (bSelfConf := TRUE, bIndGroup := 0, bDevClassInst := 0, bDevClass := 0, bReserved := FALSE, bFunction := 61, bFunctionInst := 0, bEcuInstance := 0, wManufCode := 0, dwIdentNumb := 0); // File Server: Funktion 61
		FS_FLT : NAMEFIELD_T := (bSelfConf := FALSE, bIndGroup := 0, bDevClassInst := 0, bDevClass := 0, bReserved := FALSE, bFunction := 16#FF, bFunctionInst := 0, bEcuInstance := 0, wManufCode := 0, dwIdentNumb := 0); // prüft nur bFunction
		FS_DATEI : STRING := 'logibus_test.txt'; // Testdatei, relativ zum aktuellen Volume
		FS_DATEI_2 : STRING := 'logibus_test2.txt'; // Kopie zurück auf den File Server
		FS_LOKAL : STRING := '/data/fs/logibus_test.txt'; // lokale Kopie im logiBUS
		FS_TEXT : STRING := 'logiBUS File Server Test'; // Inhalt der Testdatei
		FS_WURZEL : STRING := '.'; // Wurzel des aktuellen Volumes
		FS_ORDNER : STRING := 'logibus_test_dir'; // Testordner Übung 158
		FS_A : STRING := 'logibus_test_dir\a.txt'; // Übung 158: FsPut-Ziel
		FS_B : STRING := 'logibus_test_dir\b.txt'; // Übung 158: umbenannt
		FS_C : STRING := 'logibus_test_dir\c.txt'; // Übung 158: Kopie
		FS_ADD_LOGIBUS : NAMEFIELD_T := (bSelfConf := TRUE, bIndGroup := 0, bDevClassInst := 0, bDevClass := 0, bReserved := FALSE, bFunction := 61, bFunctionInst := 0, bEcuInstance := 0, wManufCode := 1116, dwIdentNumb := 0); // logiBUS-Server, Hersteller 1116
		FS_FLT_LOGIBUS : NAMEFIELD_T := (bSelfConf := FALSE, bIndGroup := 0, bDevClassInst := 0, bDevClass := 0, bReserved := FALSE, bFunction := 16#FF, bFunctionInst := 0, bEcuInstance := 0, wManufCode := 16#07FF, dwIdentNumb := 0); // prüft Funktion und Hersteller
		FS_LOGIBUS_ORDNER : STRING := '\\LOGIBUS\IMPORT'; // Übung 159b: Ordner am logiBUS-Server
		FS_LOGIBUS_DATEI : STRING := '\\LOGIBUS\IMPORT\test.txt'; // Übung 159b: Ziel am logiBUS-Server
		FS_LOKAL_ZURUECK : STRING := '/data/fs/logibus_test_zurueck.txt'; // Übung 159b: zurückgeholte Kopie
	END_VAR
END_GLOBALCONSTANTS
]]></OriginalSource>
</GlobalConstants>
