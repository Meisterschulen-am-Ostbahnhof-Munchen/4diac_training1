	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-11-26" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="Uebungen">
		<Import declaration="Uebungen::const::Uebung_150_159::FileServer::FS_ADD"/>
		<Import declaration="Uebungen::const::Uebung_150_159::FileServer::FS_FLT"/>
		<Import declaration="Uebungen::const::Uebung_150_159::FileServer::FS_WURZEL"/>
		<Import declaration="isobus::pgn::ISOUSERHOME_e::network"/>
		<Import declaration="isobus::pgn::ISO_CAN_NODE::NODE1"/>
		<Import declaration="logiBUS::io::DI::logiBUS_DI::Input_I1"/>
		<Import declaration="logiBUS::io::DI::logiBUS_DI_Events::BUTTON_SINGLE_CLICK"/>
		<Import declaration="logiBUS::io::DQ::logiBUS_DO::Output_Q1"/>
	</CompilerInfo>
	<SubAppInterfaceList>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="NmGetCfInfo" Type="isobus::pgn::NmGetCfInfo" Comment="meldet den File Server (Funktion 61)" x="-12000" y="0">
			<Parameter Name="u8CanIdx" Value="NODE1"/>
			<Parameter Name="member" Value="network"/>
			<Parameter Name="address" Value="FS_ADD"/>
			<Parameter Name="mask" Value="FS_FLT"/>
		</FB>
		<FB Name="NetEv_DEMUX" Type="eclipse4diac::convert::STRUCT_DEMUX" x="-9000" y="0">
			<Attribute Name="StructuredType" Type="STRING" Value="isobus::pgn::ISONETEVENT_T"/>
		</FB>
		<SubApp Name="NetEv_Install" Type="MyLib::sys::NetEv_Install_Filter" x="-6500" y="0">
		</SubApp>
		<FB Name="Server_merken" Type="iec61131::selection::F_MOVE" Comment="eigener CF und File-Server-CF (NmDestin)" x="-3500" y="0">
		</FB>
		<FB Name="Server_da" Type="iec61499::events::E_SR" x="-1000" y="0">
		</FB>
		<FB Name="DigitalInput_CLK_I1" Type="logiBUS::io::DI::logiBUS_IE" x="-12000" y="3000">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="Input" Value="Input_I1"/>
			<Parameter Name="InputEvent" Value="BUTTON_SINGLE_CLICK"/>
		</FB>
		<FB Name="Nur_mit_Server" Type="iec61499::events::E_PERMIT" x="-9000" y="3000">
		</FB>
		<FB Name="Info" Type="isobus::fs::FsInfo" Comment="Version, Volume-Status, Größe und freier Platz" x="-6000" y="3000">
			<Parameter Name="sVolume" Value="''"/>
		</FB>
		<FB Name="Namen" Type="eclipse4diac::convert::providers::PROVIDE_ARR_0016_STRING" x="-6000" y="6000">
		</FB>
		<FB Name="Groessen" Type="eclipse4diac::convert::providers::PROVIDE_ARR_0016_UDINT" x="-6000" y="7200">
		</FB>
		<FB Name="Attribute" Type="eclipse4diac::convert::providers::PROVIDE_ARR_0016_BYTE" x="-6000" y="8400">
		</FB>
		<FB Name="Geaendert" Type="eclipse4diac::convert::providers::PROVIDE_ARR_0016_DATE_AND_TIME" x="-6000" y="9600">
		</FB>
		<FB Name="Liste" Type="isobus::fs::FsDir" Comment="Wurzel des aktuellen Volumes, max. 16 Einträge" x="-1500" y="3000">
			<Parameter Name="sRemotePath" Value="FS_WURZEL"/>
			<Parameter Name="bHidden" Value="FALSE"/>
		</FB>
		<FB Name="Ergebnis" Type="iec61499::events::E_SR" Comment="Q1 an = Info und Liste gelesen" x="3000" y="3000">
		</FB>
		<FB Name="DigitalOutput_Q1" Type="logiBUS::io::DQ::logiBUS_QX" x="5500" y="3000">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="Output" Value="Output_Q1"/>
		</FB>
		<Comment Comment="File Server: Eigenschaften abfragen und Verzeichnis listen (FsInfo, FsDir)&#10;NmGetCfInfo (network, Filter FS_ADD/FS_FLT = NAME-Funktion 61) meldet den File Server, z. B. CCI 1200 mit USB-Stick.&#10;I1 Klick (nur mit Server): FsInfo, dann FsDir auf FS_WURZEL ('.'). Q1 an = fertig, Q1 aus = Fehler.&#10;Watch Info: u8Version, u8VolumeStatus (255 = meldet keinen), u32TotalKB, u32FreeKB. Watch Liste: u16Count, asName, au32Size (logibus_test.txt aus Übung 156: 24 Byte).&#10;Bei ERR s16Status und u16FsError. Mehr als 16 Einträge: ERR mit E_OVERFLOW (-6), die ersten 16 stehen trotzdem drin.&#10;Voraussetzungen: Firmware mit FsInfo/FsDir (neue Host-Symbole), neue isobus_fs-ELF, PART_13_FSC = 1 in /data/functionalities.ini." x="-12000" y="-2600" width="10000" height="2000"/>
		<EventConnections>
			<Connection Source="NmGetCfInfo.IND" Destination="NetEv_DEMUX.REQ"/>
			<Connection Source="NetEv_DEMUX.CNF" Destination="NetEv_Install.REQ"/>
			<Connection Source="NetEv_Install.INSTALL" Destination="Server_merken.REQ"/>
			<Connection Source="NetEv_Install.RSP" Destination="NmGetCfInfo.RSP">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="Server_merken.CNF" Destination="NetEv_Install.SET"/>
			<Connection Source="Server_merken.CNF" Destination="Server_da.S"/>
			<Connection Source="Server_merken.CNF" Destination="NmGetCfInfo.RSP">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="DigitalInput_CLK_I1.IND" Destination="Nur_mit_Server.EI"/>
			<Connection Source="Nur_mit_Server.EO" Destination="Info.REQ"/>
			<Connection Source="Info.CNF" Destination="Liste.REQ"/>
			<Connection Source="Liste.CNF" Destination="Ergebnis.S"/>
			<Connection Source="Info.ERR" Destination="Ergebnis.R"/>
			<Connection Source="Liste.ERR" Destination="Ergebnis.R"/>
			<Connection Source="Ergebnis.EO" Destination="DigitalOutput_Q1.REQ"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="NmGetCfInfo.sNetEv" Destination="NetEv_DEMUX.IN"/>
			<Connection Source="NetEv_DEMUX.eNetEvent" Destination="NetEv_Install.eNetEvent"/>
			<Connection Source="NmGetCfInfo.sNetEv" Destination="Server_merken.IN"/>
			<Connection Source="Server_merken.OUT" Destination="Info.NmDestin"/>
			<Connection Source="Server_merken.OUT" Destination="Liste.NmDestin"/>
			<Connection Source="Namen.D1" Destination="Liste.asName"/>
			<Connection Source="Groessen.D1" Destination="Liste.au32Size"/>
			<Connection Source="Attribute.D1" Destination="Liste.au8Attr"/>
			<Connection Source="Geaendert.D1" Destination="Liste.adtModified"/>
			<Connection Source="Server_da.Q" Destination="Nur_mit_Server.PERMIT"/>
			<Connection Source="Ergebnis.Q" Destination="DigitalOutput_Q1.OUT"/>
		</DataConnections>
	</SubAppNetwork>
</SubAppType>
