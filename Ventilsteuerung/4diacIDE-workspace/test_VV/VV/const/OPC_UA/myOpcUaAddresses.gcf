	<OriginalSource><![CDATA[PACKAGE VV::const::OPC_UA;

GLOBALCONSTANTS myOpcUaAddresses
	VAR_GLOBAL CONSTANT
		PC_A : WSTRING := logiBUS::stations::Computers::C_11;
		PC_B : WSTRING := logiBUS::stations::Computers::C_12;
		PC_A_OPC : WSTRING := MyLib_OPC::F_MGR_TO_OPC(PC_A);
		PC_B_OPC : WSTRING := MyLib_OPC::F_MGR_TO_OPC(PC_B);
		Q1_NODE : WSTRING := "/Objects/DigitalOutput/Q1,1:s=Output_Q1";
		Q1_LOCAL_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", Q1_NODE);
		Q1_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_B_OPC, Q1_NODE);
		FF1_TRIGGER_NODE : WSTRING := "/Objects/ToggleFF/FF1_Trigger";
		FF1_TRIGGER_LOCAL_METHOD : WSTRING := MyLib_OPC::F_OPC_LOCAL("CREATE_METHOD", FF1_TRIGGER_NODE);
		FF1_TRIGGER_REMOTE_CALL : WSTRING := MyLib_OPC::F_OPC_REMOTE("CALL_METHOD", PC_B_OPC, FF1_TRIGGER_NODE);
		FF1_STATE_NODE : WSTRING := "/Objects/ToggleFF/FF1_State,1:s=FF1_State";
		FF1_STATE_LOCAL_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", FF1_STATE_NODE);
		FF1_STATE_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_A_OPC, FF1_STATE_NODE);
		SR1_SET_NODE : WSTRING := "/Objects/SRFlipflop/SR1_Set";
		SR1_SET_LOCAL_METHOD : WSTRING := MyLib_OPC::F_OPC_LOCAL("CREATE_METHOD", SR1_SET_NODE);
		SR1_SET_REMOTE_CALL : WSTRING := MyLib_OPC::F_OPC_REMOTE("CALL_METHOD", PC_B_OPC, SR1_SET_NODE);
		SR1_RESET_NODE : WSTRING := "/Objects/SRFlipflop/SR1_Reset";
		SR1_RESET_LOCAL_METHOD : WSTRING := MyLib_OPC::F_OPC_LOCAL("CREATE_METHOD", SR1_RESET_NODE);
		SR1_RESET_REMOTE_CALL : WSTRING := MyLib_OPC::F_OPC_REMOTE("CALL_METHOD", PC_B_OPC, SR1_RESET_NODE);
		SR1_TOGGLE_NODE : WSTRING := "/Objects/SRFlipflop/SR1_Toggle";
		SR1_TOGGLE_LOCAL_METHOD : WSTRING := MyLib_OPC::F_OPC_LOCAL("CREATE_METHOD", SR1_TOGGLE_NODE);
		SR1_TOGGLE_REMOTE_CALL : WSTRING := MyLib_OPC::F_OPC_REMOTE("CALL_METHOD", PC_B_OPC, SR1_TOGGLE_NODE);
		SR1_STATE_NODE : WSTRING := "/Objects/SRFlipflop/SR1_State,1:s=SR1_State";
		SR1_STATE_LOCAL_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", SR1_STATE_NODE);
		SR1_STATE_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_A_OPC, SR1_STATE_NODE);
		SR2_SET_NODE : WSTRING := "/Objects/SRFlipflop/SR2_Set";
		SR2_SET_LOCAL_METHOD : WSTRING := MyLib_OPC::F_OPC_LOCAL("CREATE_METHOD", SR2_SET_NODE);
		SR2_SET_REMOTE_CALL : WSTRING := MyLib_OPC::F_OPC_REMOTE("CALL_METHOD", PC_B_OPC, SR2_SET_NODE);
		SR2_RESET_NODE : WSTRING := "/Objects/SRFlipflop/SR2_Reset";
		SR2_RESET_LOCAL_METHOD : WSTRING := MyLib_OPC::F_OPC_LOCAL("CREATE_METHOD", SR2_RESET_NODE);
		SR2_RESET_REMOTE_CALL : WSTRING := MyLib_OPC::F_OPC_REMOTE("CALL_METHOD", PC_B_OPC, SR2_RESET_NODE);
		SR2_STATE_NODE : WSTRING := "/Objects/SRFlipflop/SR2_State,1:s=SR2_State";
		SR2_STATE_LOCAL_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", SR2_STATE_NODE);
		SR2_STATE_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_A_OPC, SR2_STATE_NODE);
		SW1_UP_NODE : WSTRING := "/Objects/Switch1/Up,1:s=Switch1_Up";
		SW1_UP_LOCAL_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", SW1_UP_NODE);
		SW1_UP_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_B_OPC, SW1_UP_NODE);
		SW1_DOWN_NODE : WSTRING := "/Objects/Switch1/Down,1:s=Switch1_Down";
		SW1_DOWN_LOCAL_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", SW1_DOWN_NODE);
		SW1_DOWN_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_B_OPC, SW1_DOWN_NODE);
		SW1_UP_STATE_NODE : WSTRING := "/Objects/Switch1/UpState,1:s=Switch1_UpState";
		SW1_UP_STATE_LOCAL_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", SW1_UP_STATE_NODE);
		SW1_UP_STATE_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_A_OPC, SW1_UP_STATE_NODE);
		SW1_DOWN_STATE_NODE : WSTRING := "/Objects/Switch1/DownState,1:s=Switch1_DownState";
		SW1_DOWN_STATE_LOCAL_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", SW1_DOWN_STATE_NODE);
		SW1_DOWN_STATE_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_A_OPC, SW1_DOWN_STATE_NODE);
		SW2_PRESS_NODE : WSTRING := "/Objects/Switch2/Up,1:s=Switch2_Up;/Objects/Switch2/Down,1:s=Switch2_Down";
		SW2_PRESS_LOCAL_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", SW2_PRESS_NODE);
		SW2_PRESS_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_B_OPC, SW2_PRESS_NODE);
		SW2_STATE_NODE : WSTRING := "/Objects/Switch2/UpState,1:s=Switch2_UpState;/Objects/Switch2/DownState,1:s=Switch2_DownState";
		SW2_STATE_LOCAL_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", SW2_STATE_NODE);
		SW2_STATE_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_A_OPC, SW2_STATE_NODE);
	END_VAR
END_GLOBALCONSTANTS
]]></OriginalSource>
