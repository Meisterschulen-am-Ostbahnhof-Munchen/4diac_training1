	<OriginalSource><![CDATA[PACKAGE VV::const::OPC_UA;

GLOBALCONSTANTS myOpcUaAddresses
	VAR_GLOBAL CONSTANT
		PC_A : WSTRING := logiBUS::stations::Computers::C_11;
		PC_B : WSTRING := logiBUS::stations::Computers::C_12;
		PC_A_OPC : WSTRING := MyLib_OPC::F_MGR_TO_OPC(PC_A);
		PC_B_OPC : WSTRING := MyLib_OPC::F_MGR_TO_OPC(PC_B);
		Q1_NODE : WSTRING := "/Objects/DigitalOutput/Q1,1:s=Output_Q1";
		Q1_LOCAL_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", Q1_NODE);
		Q1_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_B_OPC, Q1_NODE);
		FF1_TRIGGER_NODE : WSTRING := "/Objects/ToggleFF/FF1_Trigger";
		FF1_TRIGGER_LOCAL_METHOD : WSTRING := MyLib_OPC::F_OPC_LOCAL("CREATE_METHOD", FF1_TRIGGER_NODE);
		FF1_TRIGGER_REMOTE_CALL : WSTRING := MyLib_OPC::F_OPC_REMOTE("CALL_METHOD", PC_B_OPC, FF1_TRIGGER_NODE);
		FF1_STATE_NODE : WSTRING := "/Objects/ToggleFF/FF1_State,1:s=FF1_State";
		FF1_STATE_LOCAL_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", FF1_STATE_NODE);
		FF1_STATE_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_A_OPC, FF1_STATE_NODE);
		SR1_SET_NODE : WSTRING := "/Objects/SRFlipflop/SR1_Set";
		SR1_SET_LOCAL_METHOD : WSTRING := MyLib_OPC::F_OPC_LOCAL("CREATE_METHOD", SR1_SET_NODE);
		SR1_SET_REMOTE_CALL : WSTRING := MyLib_OPC::F_OPC_REMOTE("CALL_METHOD", PC_B_OPC, SR1_SET_NODE);
		SR1_RESET_NODE : WSTRING := "/Objects/SRFlipflop/SR1_Reset";
		SR1_RESET_LOCAL_METHOD : WSTRING := MyLib_OPC::F_OPC_LOCAL("CREATE_METHOD", SR1_RESET_NODE);
		SR1_RESET_REMOTE_CALL : WSTRING := MyLib_OPC::F_OPC_REMOTE("CALL_METHOD", PC_B_OPC, SR1_RESET_NODE);
		SR1_TOGGLE_NODE : WSTRING := "/Objects/SRFlipflop/SR1_Toggle";
		SR1_TOGGLE_LOCAL_METHOD : WSTRING := MyLib_OPC::F_OPC_LOCAL("CREATE_METHOD", SR1_TOGGLE_NODE);
		SR1_TOGGLE_REMOTE_CALL : WSTRING := MyLib_OPC::F_OPC_REMOTE("CALL_METHOD", PC_B_OPC, SR1_TOGGLE_NODE);
		SR1_STATE_NODE : WSTRING := "/Objects/SRFlipflop/SR1_State,1:s=SR1_State";
		SR1_STATE_LOCAL_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", SR1_STATE_NODE);
		SR1_STATE_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_A_OPC, SR1_STATE_NODE);
		SR2_SET_NODE : WSTRING := "/Objects/SRFlipflop/SR2_Set";
		SR2_SET_LOCAL_METHOD : WSTRING := MyLib_OPC::F_OPC_LOCAL("CREATE_METHOD", SR2_SET_NODE);
		SR2_SET_REMOTE_CALL : WSTRING := MyLib_OPC::F_OPC_REMOTE("CALL_METHOD", PC_B_OPC, SR2_SET_NODE);
		SR2_RESET_NODE : WSTRING := "/Objects/SRFlipflop/SR2_Reset";
		SR2_RESET_LOCAL_METHOD : WSTRING := MyLib_OPC::F_OPC_LOCAL("CREATE_METHOD", SR2_RESET_NODE);
		SR2_RESET_REMOTE_CALL : WSTRING := MyLib_OPC::F_OPC_REMOTE("CALL_METHOD", PC_B_OPC, SR2_RESET_NODE);
		SR2_STATE_NODE : WSTRING := "/Objects/SRFlipflop/SR2_State,1:s=SR2_State";
		SR2_STATE_LOCAL_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", SR2_STATE_NODE);
		SR2_STATE_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_A_OPC, SR2_STATE_NODE);
		SW1_UP_NODE : WSTRING := "/Objects/Switch1/Up,1:s=Switch1_Up";
		SW1_UP_LOCAL_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", SW1_UP_NODE);
		SW1_UP_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_B_OPC, SW1_UP_NODE);
		SW1_DOWN_NODE : WSTRING := "/Objects/Switch1/Down,1:s=Switch1_Down";
		SW1_DOWN_LOCAL_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", SW1_DOWN_NODE);
		SW1_DOWN_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_B_OPC, SW1_DOWN_NODE);
		SW1_UP_STATE_NODE : WSTRING := "/Objects/Switch1/UpState,1:s=Switch1_UpState";
		SW1_UP_STATE_LOCAL_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", SW1_UP_STATE_NODE);
		SW1_UP_STATE_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_A_OPC, SW1_UP_STATE_NODE);
		SW1_DOWN_STATE_NODE : WSTRING := "/Objects/Switch1/DownState,1:s=Switch1_DownState";
		SW1_DOWN_STATE_LOCAL_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", SW1_DOWN_STATE_NODE);
		SW1_DOWN_STATE_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_A_OPC, SW1_DOWN_STATE_NODE);
		SW2_PRESS_NODE : WSTRING := "/Objects/Switch2/Up,1:s=Switch2_Up;/Objects/Switch2/Down,1:s=Switch2_Down";
		SW2_PRESS_LOCAL_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", SW2_PRESS_NODE);
		SW2_PRESS_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_B_OPC, SW2_PRESS_NODE);
		SW2_STATE_NODE : WSTRING := "/Objects/Switch2/UpState,1:s=Switch2_UpState;/Objects/Switch2/DownState,1:s=Switch2_DownState";
		SW2_STATE_LOCAL_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", SW2_STATE_NODE);
		SW2_STATE_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_A_OPC, SW2_STATE_NODE);

		(*
		 * T13 - Training_13 - Flip-Flop: Flip per SUBSCRIBE, negiert ueber E_SWITCH/E_SR als Flop per PUBLISH.
		 *)
		T13_FLIP_NODE : WSTRING := "/Objects/T13/Flip,1:s=T13_Flip"; // T13: Knoten Flip
		T13_FLOP_NODE : WSTRING := "/Objects/T13/Flop,1:s=T13_Flop"; // T13: Knoten Flop
		T13_FLIP_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", T13_FLIP_NODE); // T13: Flip lokal lesen (SUBSCRIBE)
		T13_FLOP_WRITE : WSTRING := MyLib_OPC::F_OPC_LOCAL("WRITE", T13_FLOP_NODE); // T13: Flop lokal schreiben (PUBLISH)
		T13_FLIP_REMOTE_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_B_OPC, T13_FLIP_NODE); // T13: PC_A schreibt Flip auf PC_B
		T13_FLOP_REMOTE_SUBSCRIBE : WSTRING := MyLib_OPC::F_OPC_REMOTE("SUBSCRIBE", PC_B_OPC, T13_FLOP_NODE); // T13: PC_A abonniert Flop auf PC_B

		(*
		 * T14 - Training_14 - Adder: Num1 + Num2 = Result, Werte von aussen (UaExpert).
		 *)
		T14_NUM1_NODE : WSTRING := "/Objects/T14/Num1,1:s=T14_Num1"; // T14: Knoten Num1
		T14_NUM2_NODE : WSTRING := "/Objects/T14/Num2,1:s=T14_Num2"; // T14: Knoten Num2
		T14_RESULT_NODE : WSTRING := "/Objects/T14/Result,1:s=T14_Result"; // T14: Knoten Result
		T14_NUM1_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", T14_NUM1_NODE); // T14: Num1 lokal lesen
		T14_NUM2_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", T14_NUM2_NODE); // T14: Num2 lokal lesen
		T14_RESULT_WRITE : WSTRING := MyLib_OPC::F_OPC_LOCAL("WRITE", T14_RESULT_NODE); // T14: Result lokal schreiben

		(*
		 * T15 - Training_15 - Methode AddValues: SERVER_1_2 rechnet RD_1 + RD_2, CLIENT_2_1 ruft mit Endpunkt auf.
		 *)
		T15_ADD_NODE : WSTRING := "/Objects/T15/AddValues"; // T15: Knoten AddValues
		T15_ADD_METHOD : WSTRING := MyLib_OPC::F_OPC_LOCAL("CREATE_METHOD", T15_ADD_NODE); // T15: Methode AddValues anlegen (SERVER_1_2)
		T15_ADD_CALL : WSTRING := MyLib_OPC::F_OPC_REMOTE("CALL_METHOD", PC_B_OPC, T15_ADD_NODE); // T15: AddValues aufrufen (CLIENT_2_1)

		(*
		 * T16 - Training_16 - Variablen per CLIENT: WRITE auf Increment, READ von Incremented (Increment + 1).
		 *)
		T16_INC_NODE : WSTRING := "/Objects/T16/Increment,1:s=T16_Increment"; // T16: Knoten Increment
		T16_INCD_NODE : WSTRING := "/Objects/T16/Incremented,1:s=T16_Incremented"; // T16: Knoten Incremented
		T16_INC_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", T16_INC_NODE); // T16: Increment lokal lesen
		T16_INCD_WRITE : WSTRING := MyLib_OPC::F_OPC_LOCAL("WRITE", T16_INCD_NODE); // T16: Incremented lokal schreiben
		T16_INC_CLIENT_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_B_OPC, T16_INC_NODE); // T16: Increment per CLIENT schreiben
		T16_INCD_CLIENT_READ : WSTRING := MyLib_OPC::F_OPC_REMOTE("READ", PC_B_OPC, T16_INCD_NODE); // T16: Incremented per CLIENT lesen
		T16B_INC_NODE : WSTRING := "/Objects/T16B/Increment,1:s=T16B_Increment"; // T16B: Knoten Increment
		T16B_INCD_NODE : WSTRING := "/Objects/T16B/Incremented,1:s=T16B_Incremented"; // T16B: Knoten Incremented
		T16B_INC_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", T16B_INC_NODE); // T16B: Increment lokal lesen
		T16B_INCD_WRITE : WSTRING := MyLib_OPC::F_OPC_LOCAL("WRITE", T16B_INCD_NODE); // T16B: Incremented lokal schreiben
		T16B_INC_CLIENT_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_B_OPC, T16B_INC_NODE); // T16B: Increment per CLIENT schreiben
		T16B_INCD_CLIENT_READ : WSTRING := MyLib_OPC::F_OPC_REMOTE("READ", PC_B_OPC, T16B_INCD_NODE); // T16B: Incremented per CLIENT lesen
		T16B_INCD_SUBSCRIBE : WSTRING := MyLib_OPC::F_OPC_REMOTE("SUBSCRIBE", PC_B_OPC, T16B_INCD_NODE); // T16B: Incremented abonnieren (Ausloeser fuer Lesen)

		(*
		 * T17 - Training_17 - Client-Subscription: wie 16, zusaetzlich SUBSCRIBE mit Endpunkt auf Incremented.
		 *)
		T17_INC_NODE : WSTRING := "/Objects/T17/Increment,1:s=T17_Increment"; // T17: Knoten Increment
		T17_INCD_NODE : WSTRING := "/Objects/T17/Incremented,1:s=T17_Incremented"; // T17: Knoten Incremented
		T17_INC_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", T17_INC_NODE); // T17: Increment lokal lesen
		T17_INCD_WRITE : WSTRING := MyLib_OPC::F_OPC_LOCAL("WRITE", T17_INCD_NODE); // T17: Incremented lokal schreiben
		T17_INC_CLIENT_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_B_OPC, T17_INC_NODE); // T17: Increment per CLIENT schreiben
		T17_INCD_CLIENT_READ : WSTRING := MyLib_OPC::F_OPC_REMOTE("READ", PC_B_OPC, T17_INCD_NODE); // T17: Incremented per CLIENT lesen
		T17_INCD_SUBSCRIBE : WSTRING := MyLib_OPC::F_OPC_REMOTE("SUBSCRIBE", PC_B_OPC, T17_INCD_NODE); // T17: Incremented abonnieren (SUBSCRIBE mit Endpunkt)
		T17B_INC_NODE : WSTRING := "/Objects/T17B/Increment,1:s=T17B_Increment"; // T17B: Knoten Increment
		T17B_INCD_NODE : WSTRING := "/Objects/T17B/Incremented,1:s=T17B_Incremented"; // T17B: Knoten Incremented
		T17B_INC_READ : WSTRING := MyLib_OPC::F_OPC_LOCAL("READ", T17B_INC_NODE); // T17B: Increment lokal lesen
		T17B_INCD_WRITE : WSTRING := MyLib_OPC::F_OPC_LOCAL("WRITE", T17B_INCD_NODE); // T17B: Incremented lokal schreiben
		T17B_INC_CLIENT_WRITE : WSTRING := MyLib_OPC::F_OPC_REMOTE("WRITE", PC_B_OPC, T17B_INC_NODE); // T17B: Increment per CLIENT schreiben
		T17B_INCD_CLIENT_READ : WSTRING := MyLib_OPC::F_OPC_REMOTE("READ", PC_B_OPC, T17B_INCD_NODE); // T17B: Incremented per CLIENT lesen
		T17B_INCD_SUBSCRIBE : WSTRING := MyLib_OPC::F_OPC_REMOTE("SUBSCRIBE", PC_B_OPC, T17B_INCD_NODE); // T17B: Incremented abonnieren (SUBSCRIBE mit Endpunkt)

		(*
		 * T18 - Training_18 - PUBLISH_0: Objekt und Variable anlegen und loeschen (lokal, remote nicht erlaubt).
		 *)
		T18_OBJ_CREATE : WSTRING := "opc_ua[CREATE_OBJECT;,i=58;/Objects/1:T18_MyObject]"; // T18: Objekt anlegen (Typ BaseObjectType i=58)
		T18_VAR_CREATE : WSTRING := "opc_ua[CREATE_VARIABLE;,i=63;,i=6;/Objects/1:T18_MyVariable]"; // T18: Variable anlegen (BaseDataVariableType, Int32)
		T18_VAR_DELETE : WSTRING := "opc_ua[DELETE_VARIABLE;/Objects/1:T18_MyVariable]"; // T18: Variable loeschen
		T18_OBJ_DELETE : WSTRING := "opc_ua[DELETE_OBJECT;/Objects/1:T18_MyObject]"; // T18: Objekt loeschen
		T18_VAR_NODE : WSTRING := "/Objects/1:T18_MyVariable"; // T18: Knoten der angelegten Variable
		T18_VAR_CLIENT_READ : WSTRING := MyLib_OPC::F_OPC_REMOTE("READ", PC_B_OPC, T18_VAR_NODE); // T18: PC_A liest die Variable per CLIENT
	END_VAR
END_GLOBALCONSTANTS
