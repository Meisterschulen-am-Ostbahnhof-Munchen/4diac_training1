<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="SubApp_PC_B" Comment="Geraet B (Station 12, 192.168.1.12): empfaengt Hoch/Runter-Zustand per OPC-UA (AX_SUBSCRIBE_1, lokal ueberwacht), fuehrt beide direkt per Adapter-Verbindung in ILOCK_SWITCH_PROTECT_AX (Last-Wins mit Schutzzeit) zusammen und schaltet Output_Q7/Output_Q8 - &apos;SUB style&apos;: das FB-Netz steckt direkt in diesem Composite, da diese Kombination (2x Subscribe + Interlock + Schutzzeit-Timer + 2x Ausgang) exercise-spezifisch ist. AX_SUBSCRIBE_1.OUT ist bereits vom Adaptertyp &apos;AX&apos; - demselben Typ, den ILOCK_SWITCH_PROTECT_AX.UP_IN/.DOWN_IN als Socket erwarten - daher keine Zwischen-Logik noetig (Vorbild fuer die ILOCK-Verdrahtung selbst: test_AX/Uebungen/Uebung_202_AX.SUB)">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-05" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="subapp::Training_10_OPC_UA_RES">
		<Import declaration="VV::const::OPC_UA::myOpcUaAddresses::SW1_UP_LOCAL_READ"/>
		<Import declaration="VV::const::OPC_UA::myOpcUaAddresses::SW1_DOWN_LOCAL_READ"/>
		<Import declaration="logiBUS::io::DQ::logiBUS_DO::Output_Q7"/>
		<Import declaration="logiBUS::io::DQ::logiBUS_DO::Output_Q8"/>
	</CompilerInfo>
	<SubAppInterfaceList>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="SUBSCRIBE_UP" Type="adapter::net::AX_SUBSCRIBE_1" x="-3100" y="-800">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="ID" Value="SW1_UP_LOCAL_READ"/>
		</FB>
		<FB Name="SUBSCRIBE_DOWN" Type="adapter::net::AX_SUBSCRIBE_1" x="-3100" y="900">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="ID" Value="SW1_DOWN_LOCAL_READ"/>
		</FB>
		<FB Name="ILOCK_AX" Type="logiBUS::signalprocessing::interlock::ILOCK_SWITCH_PROTECT_AX" x="-500" y="0">
			<Parameter Name="DT_PROTECT" Value="T#1s"/>
		</FB>
		<FB Name="E_TimeOut" Type="iec61499::events::E_TimeOut" x="2300" y="2000">
		</FB>
		<FB Name="DigitalOutput_Q7" Type="logiBUS::io::DQ::logiBUS_QXA" x="2300" y="-800">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="Output" Value="Output_Q7"/>
		</FB>
		<FB Name="DigitalOutput_Q8" Type="logiBUS::io::DQ::logiBUS_QXA" x="2300" y="900">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="Output" Value="Output_Q8"/>
		</FB>
		<AdapterConnections>
			<Connection Source="SUBSCRIBE_UP.OUT" Destination="ILOCK_AX.UP_IN" dx1="1150"/>
			<Connection Source="SUBSCRIBE_DOWN.OUT" Destination="ILOCK_AX.DOWN_IN" dx1="1150"/>
			<Connection Source="ILOCK_AX.timeOut" Destination="E_TimeOut.TimeOutSocket" dx1="193.33"/>
			<Connection Source="ILOCK_AX.UP_OUT" Destination="DigitalOutput_Q7.OUT" dx1="1000"/>
			<Connection Source="ILOCK_AX.DOWN_OUT" Destination="DigitalOutput_Q8.OUT" dx1="1000"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
