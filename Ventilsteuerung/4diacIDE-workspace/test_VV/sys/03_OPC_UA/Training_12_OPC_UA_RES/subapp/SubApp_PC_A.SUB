	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-05" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="subapp::Training_12_OPC_UA_RES">
		<Import declaration="Uebungen::const::UT::DefaultPool::SoftKey_F1"/>
		<Import declaration="Uebungen::const::UT::DefaultPool::SoftKey_F2"/>
		<Import declaration="VV::const::OPC_UA::myOpcUaAddresses::SW2_PRESS_REMOTE_WRITE"/>
		<Import declaration="VV::const::OPC_UA::myOpcUaAddresses::SW2_STATE_LOCAL_READ"/>
	</CompilerInfo>
	<SubAppInterfaceList>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<SubApp Name="Keys" Type="MyLib::sys::Softkey2_TO_A2X2_BG" x="-3400" y="-200">
			<Parameter Name="u16ObjId_UP" Value="SoftKey_F1"/>
			<Parameter Name="u16ObjId_DOWN" Value="SoftKey_F2"/>
		</SubApp>
		<FB Name="NET" Type="adapter::net::A2X2_CLIENT_2_0_SUBSCRIBE_2" x="-800" y="-700">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="ID_WRITE" Value="SW2_PRESS_REMOTE_WRITE"/>
			<Parameter Name="ID_READ" Value="SW2_STATE_LOCAL_READ"/>
		</FB>
		<AdapterConnections>
			<Connection Source="Keys.OUT" Destination="NET.IO" dx1="1200"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
