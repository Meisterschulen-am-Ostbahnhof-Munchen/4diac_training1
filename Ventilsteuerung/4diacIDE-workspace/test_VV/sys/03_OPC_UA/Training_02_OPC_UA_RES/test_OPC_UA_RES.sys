					<Connection Source="SUBSCRIBE_Q1.INITO" Destination="App_OPC_UA_RES.OUTPUT_Q1.INIT"/>
				</EventConnections>
				<AdapterConnections>
					<Connection Source="SUBSCRIBE_Q1.OUT" Destination="App_OPC_UA_RES.OUTPUT_Q1.OUT" dx1="1000"/>
