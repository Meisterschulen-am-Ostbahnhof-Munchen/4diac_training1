					<Parameter Name="QI" Value="TRUE"/>
					<Parameter Name="ID" Value="Q1_REMOTE_WRITE"/>
				</FB>
				<EventConnections>
					<Connection Source="START.COLD" Destination="App_OPC_UA_RES.INPUT_I1.INIT" dx1="946.67"/>
					<Connection Source="App_OPC_UA_RES.INPUT_I1.INITO" Destination="CLIENT_Q1.INIT"/>
				</EventConnections>
				<AdapterConnections>
					<Connection Source="App_OPC_UA_RES.INPUT_I1.IN" Destination="CLIENT_Q1.IN" dx1="453.33"/>
				</AdapterConnections>
			</FBNetwork>
		</Resource>
	</Device>
	<Device Name="FORTE_PC_B" Type="iec61499::system::FORTE_PC" x="2400" y="2560">
