	<Mapping From="App_OPC_UA_RES.INPUT_I1" To="FORTE_PC_A.EMB_RES_A"/>
	<Mapping From="App_OPC_UA_RES.OUTPUT_Q1" To="FORTE_PC_B.EMB_RES_B"/>
	<Link SegmentName="Ethernet" CommResource="FORTE_PC_A" Comment="">
