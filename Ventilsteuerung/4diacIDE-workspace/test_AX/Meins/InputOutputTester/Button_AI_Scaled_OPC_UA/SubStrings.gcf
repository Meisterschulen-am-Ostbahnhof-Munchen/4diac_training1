	<OriginalSource><![CDATA[PACKAGE Meins::InputOutputTester::Button_AI_Scaled_OPC_UA;

(* OPC-UA Strings und Umrechnung je Kanal: Wert = mV * SCALE + OFFSET.
   Beispielwerte aus Krauternter (Oeltemperatur B16, 4-20 mA an 491,2 Ohm, Teiler 69/22):
   626,4 mV = -20 °C, 3132,2 mV = 120 °C. *)
GLOBALCONSTANTS SubStrings
	VAR_GLOBAL CONSTANT
		AI_I1_MV_WRITE : WSTRING := "opc_ua[WRITE;/Objects/Analog/I1/MV,1:s=AI_I1_MV]";
		AI_I1_CAL_WRITE : WSTRING := "opc_ua[WRITE;/Objects/Analog/I1/CAL,1:s=AI_I1_CAL]";
		AI_I1_SCALE : LREAL := LREAL#0.0558704; // Faktor je mV (Beispiel 4-20 mA -> -20..120 °C)
		AI_I1_OFFSET : DINT := DINT#-55; // Offset nach dem Faktor (Beispiel -55)
		AI_I2_MV_WRITE : WSTRING := "opc_ua[WRITE;/Objects/Analog/I2/MV,1:s=AI_I2_MV]";
		AI_I2_CAL_WRITE : WSTRING := "opc_ua[WRITE;/Objects/Analog/I2/CAL,1:s=AI_I2_CAL]";
		AI_I2_SCALE : LREAL := LREAL#0.0558704; // Faktor je mV (Beispiel 4-20 mA -> -20..120 °C)
		AI_I2_OFFSET : DINT := DINT#-55; // Offset nach dem Faktor (Beispiel -55)
		AI_I3_MV_WRITE : WSTRING := "opc_ua[WRITE;/Objects/Analog/I3/MV,1:s=AI_I3_MV]";
		AI_I3_CAL_WRITE : WSTRING := "opc_ua[WRITE;/Objects/Analog/I3/CAL,1:s=AI_I3_CAL]";
		AI_I3_SCALE : LREAL := LREAL#0.0558704; // Faktor je mV (Beispiel 4-20 mA -> -20..120 °C)
		AI_I3_OFFSET : DINT := DINT#-55; // Offset nach dem Faktor (Beispiel -55)
		AI_I4_MV_WRITE : WSTRING := "opc_ua[WRITE;/Objects/Analog/I4/MV,1:s=AI_I4_MV]";
		AI_I4_CAL_WRITE : WSTRING := "opc_ua[WRITE;/Objects/Analog/I4/CAL,1:s=AI_I4_CAL]";
		AI_I4_SCALE : LREAL := LREAL#0.0558704; // Faktor je mV (Beispiel 4-20 mA -> -20..120 °C)
		AI_I4_OFFSET : DINT := DINT#-55; // Offset nach dem Faktor (Beispiel -55)
		AI_I5_MV_WRITE : WSTRING := "opc_ua[WRITE;/Objects/Analog/I5/MV,1:s=AI_I5_MV]";
		AI_I5_CAL_WRITE : WSTRING := "opc_ua[WRITE;/Objects/Analog/I5/CAL,1:s=AI_I5_CAL]";
		AI_I5_SCALE : LREAL := LREAL#0.0558704; // Faktor je mV (Beispiel 4-20 mA -> -20..120 °C)
		AI_I5_OFFSET : DINT := DINT#-55; // Offset nach dem Faktor (Beispiel -55)
		AI_I6_MV_WRITE : WSTRING := "opc_ua[WRITE;/Objects/Analog/I6/MV,1:s=AI_I6_MV]";
		AI_I6_CAL_WRITE : WSTRING := "opc_ua[WRITE;/Objects/Analog/I6/CAL,1:s=AI_I6_CAL]";
		AI_I6_SCALE : LREAL := LREAL#0.0558704; // Faktor je mV (Beispiel 4-20 mA -> -20..120 °C)
		AI_I6_OFFSET : DINT := DINT#-55; // Offset nach dem Faktor (Beispiel -55)
		AI_I7_MV_WRITE : WSTRING := "opc_ua[WRITE;/Objects/Analog/I7/MV,1:s=AI_I7_MV]";
		AI_I7_CAL_WRITE : WSTRING := "opc_ua[WRITE;/Objects/Analog/I7/CAL,1:s=AI_I7_CAL]";
		AI_I7_SCALE : LREAL := LREAL#0.0558704; // Faktor je mV (Beispiel 4-20 mA -> -20..120 °C)
		AI_I7_OFFSET : DINT := DINT#-55; // Offset nach dem Faktor (Beispiel -55)
		AI_I8_MV_WRITE : WSTRING := "opc_ua[WRITE;/Objects/Analog/I8/MV,1:s=AI_I8_MV]";
		AI_I8_CAL_WRITE : WSTRING := "opc_ua[WRITE;/Objects/Analog/I8/CAL,1:s=AI_I8_CAL]";
		AI_I8_SCALE : LREAL := LREAL#0.0558704; // Faktor je mV (Beispiel 4-20 mA -> -20..120 °C)
		AI_I8_OFFSET : DINT := DINT#-55; // Offset nach dem Faktor (Beispiel -55)
		Q01_READ : WSTRING := "opc_ua[READ;/Objects/DigitalOutput/Q01,1:s=Q01]";
		Q01_WRITE : WSTRING := "opc_ua[WRITE;/Objects/DigitalOutput/Q01,1:s=Q01]";
		Q02_READ : WSTRING := "opc_ua[READ;/Objects/DigitalOutput/Q02,1:s=Q02]";
		Q02_WRITE : WSTRING := "opc_ua[WRITE;/Objects/DigitalOutput/Q02,1:s=Q02]";
