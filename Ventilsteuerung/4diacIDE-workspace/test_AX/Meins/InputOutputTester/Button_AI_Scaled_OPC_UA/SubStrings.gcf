		Q09_WRITE : WSTRING := "opc_ua[WRITE;/Objects/DigitalOutput/Q09,1:s=Q09]";
		Q10_READ : WSTRING := "opc_ua[READ;/Objects/DigitalOutput/Q10,1:s=Q10]";
