<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Servo_AI3_Calibrate_2P_OPC" Comment="Servo an Output_Q2 folgt dem 2-Punkt-kalibrierten Slider AI3 (0-180 Grad),&#10;Kalibrierung CO/CS + Referenzwerte per OPC-UA-Dashboard">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-11-06" Remarks="Kopie von Meins::Servo_AI4_Calibrate_OPC fuer den Slider AI3 (haelt seine Position, keine Mittelstellung): 2-Punkt-Kalibrierung MyLib::sys::logiBUS_AI_Calibrate_2P_OPC statt 3P. Kalibrierter Wert = Winkel in Grad, Referenzwerte 0/180.">
	</VersionInfo>
	<CompilerInfo packageName="Meins::Servo_AI3_Calibrate_2P_OPC">
		<Import declaration="Meins::Servo_AI3_Calibrate_2P_OPC::SubStrings::SAI3_RAW_WRITE"/>
		<Import declaration="Meins::Servo_AI3_Calibrate_2P_OPC::SubStrings::SAI3_CAL_WRITE"/>
		<Import declaration="Meins::Servo_AI3_Calibrate_2P_OPC::SubStrings::SAI3_CO_METHOD"/>
		<Import declaration="Meins::Servo_AI3_Calibrate_2P_OPC::SubStrings::SAI3_CS_METHOD"/>
		<Import declaration="Meins::Servo_AI3_Calibrate_2P_OPC::SubStrings::SAI3_ZERO_READ"/>
		<Import declaration="Meins::Servo_AI3_Calibrate_2P_OPC::SubStrings::SAI3_ZERO_WRITE"/>
		<Import declaration="Meins::Servo_AI3_Calibrate_2P_OPC::SubStrings::SAI3_SPAN_READ"/>
		<Import declaration="Meins::Servo_AI3_Calibrate_2P_OPC::SubStrings::SAI3_SPAN_WRITE"/>
		<Import declaration="Meins::Servo_AI3_Calibrate_2P_OPC::SubStrings::SAI3_ZERO_RAW_WRITE"/>
		<Import declaration="Meins::Servo_AI3_Calibrate_2P_OPC::SubStrings::SAI3_SPAN_RAW_WRITE"/>
		<Import declaration="Meins::Servo_AI3_Calibrate_2P_OPC::SubStrings::SAI3_ANGLE"/>
		<Import declaration="logiBUS::io::AI::logiBUS_AI::AnalogInput_I3"/>
		<Import declaration="logiBUS::io::DQ::logiBUS_DO::Output_Q2"/>
	</CompilerInfo>
	<SubAppInterfaceList>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<SubApp Name="CalibAI3" Type="MyLib::sys::logiBUS_AI_Calibrate_2P_OPC" x="-1800" y="100">
			<Parameter Name="Input" Value="AnalogInput_I3"/>
			<Parameter Name="sSection" Value="'Servo_AI3_Calibrate_2P'"/>
			<Parameter Name="ID_RAW_WRITE" Value="SAI3_RAW_WRITE"/>
			<Parameter Name="ID_CAL_WRITE" Value="SAI3_CAL_WRITE"/>
			<Parameter Name="ID_CO_METHOD" Value="SAI3_CO_METHOD"/>
			<Parameter Name="ID_CS_METHOD" Value="SAI3_CS_METHOD"/>
			<Parameter Name="ID_ZERO_READ" Value="SAI3_ZERO_READ"/>
			<Parameter Name="ID_ZERO_WRITE" Value="SAI3_ZERO_WRITE"/>
			<Parameter Name="ID_SPAN_READ" Value="SAI3_SPAN_READ"/>
			<Parameter Name="ID_SPAN_WRITE" Value="SAI3_SPAN_WRITE"/>
			<Parameter Name="ID_ZERO_RAW_WRITE" Value="SAI3_ZERO_RAW_WRITE"/>
			<Parameter Name="ID_SPAN_RAW_WRITE" Value="SAI3_SPAN_RAW_WRITE"/>
			<Parameter Name="rLowRefDefault" Value="REAL#0.0"/>
			<Parameter Name="rHighRefDefault" Value="REAL#180.0"/>
		</SubApp>
		<FB Name="AngleToReal" Type="adapter::conversion::unidirectional::AR_R_TO_REAL" x="1000" y="400">
		</FB>
		<FB Name="Clamp" Type="logiBUS::signalprocessing::clamp::F_ClampReal" x="2600" y="400">
			<Parameter Name="rMin" Value="0.0"/>
			<Parameter Name="rMax" Value="180.0"/>
		</FB>
		<FB Name="ToFraction" Type="iec61131::arithmetic::F_DIV" x="4200" y="400">
			<Parameter Name="IN2" Value="REAL#180.0"/>
		</FB>
		<FB Name="ToWord" Type="eclipse4diac::signalprocessing::FIELDBUS_PERCENT_TO_WORD" x="5700" y="400">
		</FB>
		<FB Name="AngleToAW" Type="adapter::conversion::unidirectional::AW_WORD_TO_W" x="8000" y="400">
		</FB>
		<FB Name="ServoQ2" Type="logiBUS::io::DO_SERVO::logiBUS_QWA_SERVO" x="10000" y="200">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="PARAMS" Value="">
				<Attribute Name="Visible" Value="false"/>
			</Parameter>
			<Parameter Name="Output" Value="Output_Q2"/>
			<Parameter Name="PULSE_MIN" Value="T#500us"/>
			<Parameter Name="PULSE_MAX" Value="T#2500us"/>
		</FB>
		<Comment Comment="ServoQ2: PULSE_MIN = T#500us, PULSE_MAX = T#2500us, FREQ 50 Hz (Mitte 1,5 ms).&#10;Passt fuer: 5 Stueck 9G Servo Motor, Mikro-Servomotoren mit Kabel, 180 Grad (Amazon B0H3BC3PSS).&#10;Herstellerangabe: 20 ms Zyklus, 0,5..2,5 ms Impulsbreite fuer 0..180 Grad, 3..7,2 V.&#10;Damit faehrt der Servo exakt 90 Grad in jede Richtung (getestet 2026-11-06).&#10;Standardwerte 1000..2000 us ergeben bei diesem Servo nur ca. 35 Grad." x="5100" y="-1100" width="6000" height="1200"/>
		<FB Name="AngleEchoToAR" Type="adapter::conversion::unidirectional::AR_REAL_TO_R" x="4200" y="1600">
		</FB>
		<FB Name="AngleEcho" Type="adapter::net::AR_PUBLISH_1" x="7400" y="1500">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="ID" Value="SAI3_ANGLE"/>
		</FB>
		<EventConnections>
			<Connection Source="AngleToReal.CNF" Destination="Clamp.REQ"/>
			<Connection Source="Clamp.CNF" Destination="ToFraction.REQ"/>
			<Connection Source="Clamp.CNF" Destination="AngleEchoToAR.REQ" dx1="400"/>
			<Connection Source="ToFraction.CNF" Destination="ToWord.REQ"/>
			<Connection Source="ToWord.CNF" Destination="AngleToAW.REQ"/>
			<Connection Source="CalibAI3.INITO" Destination="AngleEcho.INIT" dx1="3226.67">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="AngleEcho.INITO" Destination="ServoQ2.INIT" dx1="673.33">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
		</EventConnections>
		<DataConnections>
			<Connection Source="AngleToReal.IN" Destination="Clamp.rIn"/>
			<Connection Source="Clamp." Destination="ToFraction.IN1" dx1="373.33"/>
			<Connection Source="ToFraction.OUT" Destination="ToWord.RI"/>
			<Connection Source="ToWord." Destination="AngleToAW.OUT" dx1="373.33"/>
			<Connection Source="Clamp." Destination="AngleEchoToAR.OUT" dx1="400"/>
		</DataConnections>
		<AdapterConnections>
			<Connection Source="CalibAI3.CAL_OUT" Destination="AngleToReal.AR_IN" dx1="373.33"/>
			<Connection Source="AngleToAW.AW_OUT" Destination="ServoQ2.OUT" dx1="373.33"/>
			<Connection Source="AngleEchoToAR.AR_OUT" Destination="AngleEcho.IN" dx1="373.33"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
