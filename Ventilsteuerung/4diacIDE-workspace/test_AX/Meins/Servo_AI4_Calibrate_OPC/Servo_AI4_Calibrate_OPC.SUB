	<SubAppInterfaceList>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<SubApp Name="CalibAI4" Type="MyLib::sys::logiBUS_AI_Calibrate_3P_OPC" x="-1800" y="100">
			<Parameter Name="Input" Value="AnalogInput_I4"/>
			<Parameter Name="sSection" Value="'Servo_AI4_Calibrate_3P'"/>
			<Parameter Name="ID_RAW_WRITE" Value="SAI4_RAW_WRITE"/>
			<Parameter Name="ID_CAL_WRITE" Value="SAI4_CAL_WRITE"/>
			<Parameter Name="ID_MIN_METHOD" Value="SAI4_MIN_METHOD"/>
			<Parameter Name="ID_MID_TRIGGER_METHOD" Value="SAI4_MID_METHOD"/>
			<Parameter Name="ID_MAX_METHOD" Value="SAI4_MAX_METHOD"/>
			<Parameter Name="ID_MINREF_READ" Value="SAI4_MINREF_READ"/>
			<Parameter Name="ID_MINREF_WRITE" Value="SAI4_MINREF_WRITE"/>
			<Parameter Name="ID_MIDREF_READ" Value="SAI4_MIDREF_READ"/>
			<Parameter Name="ID_MIDREF_WRITE" Value="SAI4_MIDREF_WRITE"/>
			<Parameter Name="ID_MAXREF_READ" Value="SAI4_MAXREF_READ"/>
			<Parameter Name="ID_MAXREF_WRITE" Value="SAI4_MAXREF_WRITE"/>
			<Parameter Name="ID_MIN_RAW_WRITE" Value="SAI4_MIN_RAW_WRITE"/>
			<Parameter Name="ID_MID_RAW_WRITE" Value="SAI4_MID_RAW_WRITE"/>
			<Parameter Name="ID_MAX_RAW_WRITE" Value="SAI4_MAX_RAW_WRITE"/>
		</SubApp>
		<FB Name="AngleToReal" Type="adapter::conversion::unidirectional::AR_R_TO_REAL" x="1000" y="400">
		</FB>
		<FB Name="Clamp" Type="logiBUS::signalprocessing::clamp::F_ClampReal" x="2600" y="400">
			<Parameter Name="rMin" Value="0.0"/>
			<Parameter Name="rMax" Value="180.0"/>
		</FB>
		<FB Name="ToFraction" Type="iec61131::arithmetic::F_DIV" x="4200" y="400">
			<Parameter Name="IN2" Value="REAL#180.0"/>
		</FB>
		<FB Name="ToWord" Type="eclipse4diac::signalprocessing::FIELDBUS_PERCENT_TO_WORD" x="5700" y="400">
		</FB>
		<FB Name="AngleToAW" Type="adapter::conversion::unidirectional::AW_WORD_TO_W" x="8000" y="400">
		</FB>
		<FB Name="ServoQ2" Type="logiBUS::io::DO_SERVO::logiBUS_QWA_SERVO" x="10000" y="200">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="PARAMS" Value="">
				<Attribute Name="Visible" Value="false"/>
			</Parameter>
			<Parameter Name="Output" Value="Output_Q2"/>
		</FB>
		<FB Name="AngleEchoToAR" Type="adapter::conversion::unidirectional::AR_REAL_TO_R" x="4200" y="1600">
		</FB>
		<FB Name="AngleEcho" Type="adapter::net::AR_PUBLISH_1" x="7400" y="1500">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="ID" Value="SAI4_ANGLE"/>
		</FB>
		<EventConnections>
			<Connection Source="AngleToReal.CNF" Destination="Clamp.REQ"/>
			<Connection Source="Clamp.CNF" Destination="ToFraction.REQ"/>
			<Connection Source="Clamp.CNF" Destination="AngleEchoToAR.REQ" dx1="400"/>
			<Connection Source="ToFraction.CNF" Destination="ToWord.REQ"/>
			<Connection Source="ToWord.CNF" Destination="AngleToAW.REQ"/>
			<Connection Source="CalibAI4.INITO" Destination="AngleEcho.INIT" dx1="3226.67">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="AngleEcho.INITO" Destination="ServoQ2.INIT" dx1="673.33">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
		</EventConnections>
		<DataConnections>
			<Connection Source="AngleToReal.IN" Destination="Clamp.rIn"/>
			<Connection Source="Clamp." Destination="ToFraction.IN1" dx1="373.33"/>
			<Connection Source="ToFraction.OUT" Destination="ToWord.RI"/>
			<Connection Source="ToWord." Destination="AngleToAW.OUT" dx1="373.33"/>
			<Connection Source="Clamp." Destination="AngleEchoToAR.OUT" dx1="400"/>
		</DataConnections>
		<AdapterConnections>
			<Connection Source="CalibAI4.CAL_OUT" Destination="AngleToReal.AR_IN" dx1="373.33"/>
			<Connection Source="AngleToAW.AW_OUT" Destination="ServoQ2.OUT" dx1="373.33"/>
			<Connection Source="AngleEchoToAR.AR_OUT" Destination="AngleEcho.IN" dx1="373.33"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
