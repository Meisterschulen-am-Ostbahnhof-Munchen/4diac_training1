		<Import declaration="Meins::Servo_AI4_Calibrate_OPC::SubStrings::SAI4_MINREF_READ"/>
		<Import declaration="Meins::Servo_AI4_Calibrate_OPC::SubStrings::SAI4_MINREF_WRITE"/>
		<Import declaration="Meins::Servo_AI4_Calibrate_OPC::SubStrings::SAI4_MIDREF_READ"/>
