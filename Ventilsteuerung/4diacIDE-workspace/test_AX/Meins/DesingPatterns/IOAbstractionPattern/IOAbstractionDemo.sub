<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="IOAbstractionDemo" Comment="IO Abstraction Layer pattern demo: logiBUS_IE/logiBUS_QX as Hardware+HAL layers around the fully event-driven EventDrivenCylinder application layer">
