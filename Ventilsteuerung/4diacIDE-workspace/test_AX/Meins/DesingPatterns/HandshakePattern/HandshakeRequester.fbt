<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="HandshakeRequester" Comment="Handshake pattern demo: Plug / Requester role">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof &#10; &#10;This program and the accompanying materials are made &#10;available under the terms of the Eclipse Public License 2.0 &#10;which is available at https://www.eclipse.org/legal/epl-2.0/ &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.2" Author="Franz Höpfinger" Date="2026-08-31" Remarks="EVENT_HS EventInputs/EventOutputs swapped so the Requester is now a Plug (more natural layout) - back to Plugs here">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-08-31" Remarks="Handshake design pattern (IEC 61499 primer course, Module 6, Valeriy Vyatkin), demo Requester">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-08-31" Remarks="initial version, wrongly declared as Plug - fixed to Socket">
	</VersionInfo>
	<CompilerInfo packageName="Meins::DesingPatterns::HandshakePattern">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Initialization Request">
				<With Var="QI"/>
			</Event>
			<Event Name="START" Type="Event" Comment="Demo: fire a REQ towards the Responder">
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
				<With Var="QO"/>
			</Event>
			<Event Name="DONE" Type="Event" Comment="A CNF was received for the last REQ">
			</Event>
			<Event Name="NOTIFIED" Type="Event" Comment="An IND was received and answered with RSP">
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Input event qualifier"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Output event qualifier"/>
			<VarDeclaration Name="CnfCount" Type="UINT" Comment="Number of CNF received (demo counter)"/>
			<VarDeclaration Name="IndCount" Type="UINT" Comment="Number of IND received / RSP sent (demo counter)"/>
		</OutputVars>
		<Plugs>
			<AdapterDeclaration Name="HS" Type="adapter::events::Handshake::EVENT_HS" Comment="Handshake plug: sends REQ/RSP, receives CNF/IND"/>
		</Plugs>
	</InterfaceList>
	<BasicFB>
		<ECC>
			<ECState Name="START_ST" Comment="Idle" x="200" y="400">
				<ECAction Algorithm="OnInit" Output="INITO"/>
			</ECState>
			<ECState Name="HANDLE_START" Comment="Send a REQ" x="2640" y="80">
				<ECAction Output="HS.REQ"/>
			</ECState>
			<ECState Name="HANDLE_CNF" Comment="A CNF arrived, report DONE" x="2480" y="640">
				<ECAction Algorithm="OnCnf" Output="DONE"/>
			</ECState>
			<ECState Name="HANDLE_IND" Comment="An IND arrived, answer with RSP and report NOTIFIED" x="2480" y="1280">
				<ECAction Algorithm="OnInd" Output="HS.RSP"/>
				<ECAction Output="NOTIFIED"/>
			</ECState>
			<ECTransition Source="START_ST" Destination="HANDLE_START" Condition="START" x="1366.67" y="-300"/>
			<ECTransition Source="HANDLE_START" Destination="START_ST" Condition="1" x="2246.67" y="-466.67"/>
			<ECTransition Source="START_ST" Destination="HANDLE_CNF" Condition="HS.CNF" x="1806.67" y="360"/>
			<ECTransition Source="HANDLE_CNF" Destination="START_ST" Condition="1" x="500" y="550"/>
			<ECTransition Source="START_ST" Destination="HANDLE_IND" Condition="HS.IND" x="1806.67" y="1033.33"/>
			<ECTransition Source="HANDLE_IND" Destination="START_ST" Condition="1" x="500" y="850"/>
		</ECC>
		<Algorithm Name="OnInit" Comment="Reset demo counters">
			<ST><![CDATA[CnfCount := 0;
IndCount := 0;
QO := QI;]]></ST>
		</Algorithm>
		<Algorithm Name="OnCnf" Comment="Count a received CNF">
			<ST><![CDATA[CnfCount := CnfCount + 1;]]></ST>
		</Algorithm>
		<Algorithm Name="OnInd" Comment="Count a received IND, about to answer with RSP">
			<ST><![CDATA[IndCount := IndCount + 1;]]></ST>
		</Algorithm>
	</BasicFB>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
	<Attribute Name="Documentation" Type="CDATA"><![CDATA[<p>Requester ("client") side of the <b>Handshake design pattern</b>
(IEC 61499 primer course, Module 6, Valeriy Vyatkin, slide 72).</p>
<p>Uses the dataless <code>adapter::events::Handshake::EVENT_HS</code>
adapter as a <b>Plug</b>: on <b>START</b> it sends a <b>REQ</b> and
reports <b>DONE</b> once the matching <b>CNF</b> comes back; whenever an
unsolicited <b>IND</b> arrives it answers with <b>RSP</b> and reports
<b>NOTIFIED</b>.</p>
<p>Per the adapter's own declaration, the <b>Plug</b> side is the one
that fires <b>REQ</b>/<b>RSP</b> and reacts to <b>CNF</b>/<b>IND</b> - i.e.
the Plug plays the client/Requester role here, the Socket plays the
server/Responder role. See <code>HandshakePattern.md</code> in this
folder for the full write-up.</p>
]]></Attribute>
</FBType>
