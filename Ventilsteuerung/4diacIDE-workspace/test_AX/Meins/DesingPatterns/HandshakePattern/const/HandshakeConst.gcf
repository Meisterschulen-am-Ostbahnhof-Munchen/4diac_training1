	<GlobalConstants>
		<VarDeclaration Name="ACK_PAYLOAD" Type="WSTRING" Comment="Fixed acknowledgement payload used by the WSTRING Handshake demo (Responder's CNF, Requester's RSP)" InitialValue="&quot;ack&quot;"/>
	</GlobalConstants>
	<OriginalSource><![CDATA[PACKAGE Meins::DesingPatterns::HandshakePattern::const;

GLOBALCONSTANTS HandshakeConst
	VAR_GLOBAL CONSTANT
		ACK_PAYLOAD : WSTRING := "ack"; // Fixed acknowledgement payload used by the WSTRING Handshake demo (Responder's CNF, Requester's RSP)
	END_VAR
END_GLOBALCONSTANTS
]]></OriginalSource>
