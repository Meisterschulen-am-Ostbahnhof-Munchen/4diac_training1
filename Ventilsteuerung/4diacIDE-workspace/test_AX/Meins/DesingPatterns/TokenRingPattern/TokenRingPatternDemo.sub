			<VarDeclaration Name="NodeE_EnteredCount" Type="UINT" Comment="NodeE: number of times it used the critical section"/>
			<VarDeclaration Name="NodeE_PassCount" Type="UINT" Comment="NodeE: number of acknowledged hand-offs"/>
		</OutputVars>
	</SubAppInterfaceList>
