	<CompilerInfo packageName="Meins::GcfFunctionCall::const">
	</CompilerInfo>
	<GlobalConstants>
		<VarDeclaration Name="BASE_VALUE" Type="INT" InitialValue="7"/>
		<VarDeclaration Name="DOUBLE_VALUE" Type="INT" Comment="Aufruf F_Double in GCF" InitialValue="Meins::GcfFunctionCall::F_Double(BASE_VALUE)"/>
	</GlobalConstants>
	<OriginalSource><![CDATA[PACKAGE Meins::GcfFunctionCall::const;

GLOBALCONSTANTS FuncConst
	VAR_GLOBAL CONSTANT
		BASE_VALUE : INT := 7;
		DOUBLE_VALUE : INT := Meins::GcfFunctionCall::F_Double(BASE_VALUE);
	END_VAR
END_GLOBALCONSTANTS
]]></OriginalSource>
