	</VersionInfo>
	<CompilerInfo packageName="Uebungen::const::Uebung_140_149">
	</CompilerInfo>
	<GlobalConstants>
		<VarDeclaration Name="PGN_FPT_PROP_00" Type="UDINT" Comment="142/143: proprietäre Fast-Packet-PGN 0x1FF00" InitialValue="UDINT#16#1FF00"/>
	</GlobalConstants>
	<OriginalSource><![CDATA[(*
 * Übungen 142/143: NMEA 2000 Fast Packet.
 * PGNs 0x1FF00-0x1FFFF mit mehr als 8 Byte gehen als Fast Packet (bis 223 Byte, immer global),
 * wenn die Firmware ISO_NMEA_FPT und PGNS_FPP_PROP_CODE hat (LOGIBUS ab 6dd74ef4).
 *)
PACKAGE Uebungen::const::Uebung_140_149;

GLOBALCONSTANTS FastPacket
	VAR_GLOBAL CONSTANT
		PGN_FPT_PROP_00 : UDINT := UDINT#16#1FF00; // 142/143: proprietäre Fast-Packet-PGN 0x1FF00
	END_VAR
END_GLOBALCONSTANTS
]]></OriginalSource>
</GlobalConstants>
