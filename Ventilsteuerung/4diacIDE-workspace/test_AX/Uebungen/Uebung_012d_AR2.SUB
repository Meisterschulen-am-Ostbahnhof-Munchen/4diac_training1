<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Uebung_012d_AR2" Comment="Numeric Value Input PHYS und Speichern NVS via AR2 (bidirektional) - NumericValue_TO_AR2 direkt an ein NVS_AR2 angeschlossen">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-04-24" Remarks="AR adapter variant of Uebung_012d, plain without subapp">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="2.0" Author="Franz Höpfinger" Date="2026-08-31" Remarks="AR2 variant: MyLib::sys::NumericValue_TO_AR2 (VT-Eingabefeld gelesen, als AR2 weitergereicht, persistiert NICHT selbst) direkt an NVS_AR2 (persistiert via AR2 Socket) angeschlossen - zeigt, dass ein AR2-Consumer wie NumericValue_TO_AR2 ohne Zwischen-FB direkt an einen beliebigen AR2-Speicherbaustein (NVS_AR2 oder INI_AR2) passt">
	</VersionInfo>
	<CompilerInfo packageName="Uebungen">
		<Import declaration="Uebungen::const::NVS::NVS_Keys::KEY_I1_STORE"/>
		<Import declaration="Uebungen::const::UT::DefaultPool_Numeric::InputNumber_I3_N"/>
	</CompilerInfo>
	<SubAppInterfaceList>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<SubApp Name="InputNumber_I3_N" Type="MyLib::sys::NumericValue_TO_AR2" x="-4700" y="1200">
			<Parameter Name="stObj" Value="InputNumber_I3_N"/>
		</SubApp>
		<FB Name="NVS_AR" Type="logiBUS::storage::esp32_nvs::NVS_AR2" x="-1400" y="800">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="SETM" Value="FALSE"/>
			<Parameter Name="KEY" Value="KEY_I1_STORE"/>
			<Parameter Name="DEFAULT_VALUE" Value="REAL#0.0"/>
		</FB>
		<Comment Comment="NumericValue_TO_AR2 speichert NICHTS selbst - es liest nur das VT-Eingabefeld (InputNumber_I3_N) und reicht den Wert als AR2 (bidirektional) weiter. Die eigentliche Speicherung passiert ausschliesslich in NVS_AR2 rechts daneben." x="-4700" y="-200" width="2400" height="1100"/>
		<Comment Comment="SETM=FALSE hier: das betrifft NICHT den Boot-Wert - der laedt immer automatisch (INIT -&gt; INITO -&gt; GET -&gt; GETO -&gt; Echo an NumericValue_TO_AR2 -&gt; Anzeige, unabhaengig von SETM). SETM gilt nur fuer eine LIVE-Aenderung waehrend des laufenden Betriebs: mit SETM=FALSE wird ein frisch eingegebener Wert zwar gespeichert, aber die Bestaetigung nicht sofort zurueckgemeldet - erst der naechste Neustart zeigt ihn wieder korrekt an. Wo der frische Wert noch IM SELBEN Lauf sofort weiterverwendet wird (z.B. AR_CALIBRATE_SQ_REF.ZERO/SPAN fuer CO/CS), braucht es SETM=TRUE." x="-1400" y="-600" width="2600" height="1200"/>
		<AdapterConnections>
			<Connection Source="InputNumber_I3_N.VALUEO" Destination="NVS_AR.VAL" dx1="1313.33"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
