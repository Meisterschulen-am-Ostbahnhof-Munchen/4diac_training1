<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Uebung_006_SAFE_AX" Comment="SAFE-Variante: Wiederanlaufsperre fuer Uebung_006_AX (SF_ResetButton, I7/I8)">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-10-09" Remarks="SAFE-Variante von Uebung_006_AX. STOP (I2) und Meldeeingang I8 (HW-Not-Halt-Rueckmeldung) schalten den Ausgang SW-seitig sofort ab und sperren START per StartPermit-Latch (E_SR) + StartGate (E_PERMIT), bis RESET (I7) ueber SF_ResetButton (PLCopen Safety Part 1 Ch. 6.1) eine gueltige Tasten-Flanke erkennt. RESET alleine schaltet den Ausgang nicht wieder ein, dafuer muss START erneut gedrueckt werden.">
	</VersionInfo>
	<CompilerInfo packageName="Uebungen">
		<Import declaration="logiBUS::io::DI::logiBUS_DI::Input_I1"/>
