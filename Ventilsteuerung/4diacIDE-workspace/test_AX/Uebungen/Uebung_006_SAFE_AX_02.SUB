<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Uebung_006_SAFE_AX_02" Comment="Wie Uebung_006_SAFE_AX, aber mit SF_EmergencyStop statt StartPermit/StartGate">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-10-09" Remarks="Zweite SAFE-Variante von Uebung_006_AX, diesmal mit dem PLCopen-Standardbaustein SF_EmergencyStop (Part 1 Ch. 6.5) statt der handgebauten StartPermit(E_RS)/StartGate(E_PERMIT)-Loesung aus Uebung_006_SAFE_AX. SF_EmergencyStop und SF_ResetButton sind im eingebetteten Muster (Figure 13 der Spec) ueber ResetRequest/ResetRequested verkoppelt: EmergencyStop fordert ResetButton nur dann zur Ueberwachung an, wenn tatsaechlich ein Reset noetig ist. S_StartReset=FALSE und S_AutoReset=FALSE: kein automatischer Wiederanlauf, RESET (I7) ist immer zwingend erforderlich.">
	</VersionInfo>
	<CompilerInfo packageName="Uebungen">
		<Import declaration="logiBUS::io::DI::logiBUS_DI::Input_I1"/>
		<Import declaration="logiBUS::io::DI::logiBUS_DI::Input_I2"/>
		<Import declaration="logiBUS::io::DI::logiBUS_DI::Input_I7"/>
