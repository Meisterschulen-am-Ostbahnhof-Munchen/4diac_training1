<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Uebung_094b3c_AX" Comment="Wie Uebung_094b3_AX, aber K=2 aktiviert zwei Optionsgruppen NACHEINANDER statt nur einer: OptionalGroup_001a wird vom DEMUX aktiviert und reicht die Aktivierung ueber ihren Plug PLUG1 an OptionalGroup_001b weiter - der DEMUX bekommt seine Bestaetigung erst, wenn BEIDE Gruppen initialisiert sind.">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-10-13" Remarks="Daisy-Chain-Variante von Uebung_094b3_AX: OptionalGroup_001 durch OptionalGroup_001a (mit zusaetzlichem Plug PLUG1) ersetzt und mit einer neuen OptionalGroup_001b dahinter verkettet - zeigt, wie man ueber die Plug/Socket-Kette mehrere Gruppen sequenziell (nacheinander, nicht gleichzeitig) hochfahren kann, ohne das Busy-Gating des DEMUX zu verletzen.">
	</VersionInfo>
	<CompilerInfo packageName="Uebungen">
		<Import declaration="Uebungen::const::UT::DefaultPool::InputNumber_I1"/>
	</CompilerInfo>
	<SubAppInterfaceList>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<SubApp Name="NumericValue_TO_AUI2_1" Type="MyLib::sys::NumericValue_TO_AUI2" x="-3500" y="500">
			<Parameter Name="u16ObjId" Value="InputNumber_I1"/>
		</SubApp>
		<FB Name="AOption_AUI_DEMUX_3" Type="Option::selection::AOption_AUI_DEMUX_3" x="-1500" y="600">
		</FB>
		<SubApp Name="OptionalGroup_001a" Type="MyLib_AX_Option::sys::OptionalGroup_001a" x="1500" y="800">
		</SubApp>
		<SubApp Name="OptionalGroup_002" Type="MyLib_AX_Option::sys::OptionalGroup_002" x="1500" y="1200">
		</SubApp>
		<SubApp Name="DummyGroup" Type="MyLib_AX_Option::sys::DummyGroup" x="1600" y="300">
		</SubApp>
		<SubApp Name="OptionalGroup_001b" Type="MyLib_AX_Option::sys::OptionalGroup_001b" x="3200" y="800">
		</SubApp>
		<AdapterConnections>
			<Connection Source="NumericValue_TO_AUI2_1.VALUEO" Destination="AOption_AUI_DEMUX_3.K" dx1="700"/>
			<Connection Source="AOption_AUI_DEMUX_3.OUT2" Destination="OptionalGroup_001a.OPTION" dx1="866.67"/>
			<Connection Source="AOption_AUI_DEMUX_3.OUT3" Destination="OptionalGroup_002.OPTION" dx1="866.67"/>
			<Connection Source="AOption_AUI_DEMUX_3.OUT1" Destination="DummyGroup.OPTION" dx1="960"/>
			<Connection Source="OptionalGroup_001a.PLUG1" Destination="OptionalGroup_001b.OPTION"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
