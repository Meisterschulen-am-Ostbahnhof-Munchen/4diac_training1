			<Parameter Name="Input" Value="Input_I1"/>
			<Parameter Name="InputEvent" Value="BUTTON_SINGLE_CLICK"/>
		</FB>
		<FB Name="Lang_Start_I1" Type="logiBUS::io::DI::logiBUS_IE" x="-4000" y="0">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="Input" Value="Input_I1"/>
			<Parameter Name="InputEvent" Value="BUTTON_LONG_PRESS_START"/>
		</FB>
		<FB Name="Lang_Ende_I1" Type="logiBUS::io::DI::logiBUS_IE" x="-4000" y="1200">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="Input" Value="Input_I1"/>
			<Parameter Name="InputEvent" Value="BUTTON_LONG_PRESS_UP"/>
		</FB>
		<FB Name="Ein_I2" Type="logiBUS::io::DI::logiBUS_IE" x="-4000" y="2400">
