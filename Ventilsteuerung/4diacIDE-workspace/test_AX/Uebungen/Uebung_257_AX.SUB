			<Parameter Name="Input" Value="logiBUS_AI::AnalogInput_I7"/>
			<Parameter Name="AnalogInput_hysteresis" Value="50"/>
		</FB>
		<FB Name="AD_SHL" Type="adapter::iec61131::bitwise::AD_SHL" x="-2000" y="300">
			<Parameter Name="N" Value="UINT#1"/>
		</FB>
		<FB Name="AD_SPLIT" Type="adapter::events::unidirectional::AD_SPLIT_4" x="0" y="300">
		</FB>
		<FB Name="PWMOutput_Q1_100Hz" Type="logiBUS::io::DQ::logiBUS_QDA_PWM" x="2500" y="-1500">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="Output" Value="Output_Q1"/>
			<Parameter Name="FREQ" Value="100"/>
		</FB>
		<FB Name="PWMOutput_Q2_200Hz" Type="logiBUS::io::DQ::logiBUS_QDA_PWM" x="2500" y="-100">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="Output" Value="Output_Q2"/>
			<Parameter Name="FREQ" Value="200"/>
		</FB>
		<FB Name="PWMOutput_Q3_400Hz" Type="logiBUS::io::DQ::logiBUS_QDA_PWM" x="2500" y="1300">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="Output" Value="Output_Q3"/>
			<Parameter Name="FREQ" Value="400"/>
		</FB>
		<FB Name="PWMOutput_Q4_1000Hz" Type="logiBUS::io::DQ::logiBUS_QDA_PWM" x="2500" y="2700">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="Output" Value="Output_Q4"/>
			<Parameter Name="FREQ" Value="1000"/>
		</FB>
		<FB Name="DigitalInput_I1" Type="logiBUS::io::DI::logiBUS_IXA" x="2500" y="4400">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="Input" Value="Input_I1"/>
		</FB>
		<FB Name="LED_Q5_1HZ" Type="logiBUS::io::DO_LED::logiBUS_LED_PWM_QXA" x="4500" y="4400">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="Output" Value="Output_Q5"/>
			<Parameter Name="FREQ" Value="LED_FREQ::LED_1HZ"/>
		</FB>
		<EventConnections>
			<Connection Source="AnalogInput_I7.INITO" Destination="PWMOutput_Q1_100Hz.INIT"/>
			<Connection Source="AnalogInput_I7.INITO" Destination="PWMOutput_Q2_200Hz.INIT"/>
			<Connection Source="AnalogInput_I7.INITO" Destination="PWMOutput_Q3_400Hz.INIT"/>
