			<Connection Source="AD_SPLIT.OUT2" Destination="PWMOutput_Q2_200Hz.OUT"/>
			<Connection Source="AD_SPLIT.OUT3" Destination="PWMOutput_Q3_400Hz.OUT"/>
			<Connection Source="AD_SPLIT.OUT4" Destination="PWMOutput_Q4_1000Hz.OUT"/>
			<Connection Source="DigitalInput_I1.IN" Destination="LED_Q5_1HZ.OUT"/>
		</AdapterConnections>
