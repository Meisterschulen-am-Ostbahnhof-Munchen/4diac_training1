	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-11-06" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="Uebungen">
		<Import declaration="logiBUS::io::AI::logiBUS_AI"/>
		<Import declaration="logiBUS::io::DQ::logiBUS_DO::Output_Q1"/>
		<Import declaration="logiBUS::io::DQ::logiBUS_DO::Output_Q2"/>
	</CompilerInfo>
	<SubAppInterfaceList>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="AnalogInput_I7" Type="logiBUS::io::AI::logiBUS_AI_IDA" x="-4000" y="0">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="Input" Value="logiBUS_AI::AnalogInput_I7"/>
			<Parameter Name="AnalogInput_hysteresis" Value="50"/>
		</FB>
		<FB Name="AD_SHL" Type="adapter::iec61131::bitwise::AD_SHL" x="-2000" y="300">
			<Parameter Name="N" Value="UINT#1"/>
		</FB>
		<FB Name="AD_SPLIT" Type="adapter::events::unidirectional::AD_SPLIT_2" x="0" y="300">
		</FB>
		<FB Name="PWMOutput_Q1_linear" Type="logiBUS::io::DQ::logiBUS_QDA_PWM" x="2500" y="-1500">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="Output" Value="Output_Q1"/>
			<Parameter Name="RAMP" Value="T#2s"/>
		</FB>
		<FB Name="PWMOutput_Q2_gamma" Type="logiBUS::io::DQ::logiBUS_QDA_PWM_G" x="2500" y="-100">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="Output" Value="Output_Q2"/>
			<Parameter Name="RAMP" Value="T#2s"/>
			<Parameter Name="GAMMA" Value="2.2"/>
		</FB>
		<FB Name="RAMPO_Count_Q1" Type="iec61499::events::E_CTU" x="5000" y="-1500">
			<Parameter Name="PV" Value="65535"/>
		</FB>
		<FB Name="RAMPO_Count_Q2" Type="iec61499::events::E_CTU" x="5000" y="-100">
			<Parameter Name="PV" Value="65535"/>
		</FB>
		<EventConnections>
			<Connection Source="AnalogInput_I7.INITO" Destination="PWMOutput_Q1_linear.INIT"/>
			<Connection Source="AnalogInput_I7.INITO" Destination="PWMOutput_Q2_gamma.INIT"/>
			<Connection Source="PWMOutput_Q1_linear.RAMPO" Destination="RAMPO_Count_Q1.CU"/>
			<Connection Source="PWMOutput_Q2_gamma.RAMPO" Destination="RAMPO_Count_Q2.CU"/>
		</EventConnections>
		<AdapterConnections>
			<Connection Source="AnalogInput_I7.IN" Destination="AD_SHL.IN"/>
			<Connection Source="AD_SHL.OUT" Destination="AD_SPLIT.IN"/>
			<Connection Source="AD_SPLIT.OUT1" Destination="PWMOutput_Q1_linear.OUT"/>
			<Connection Source="AD_SPLIT.OUT2" Destination="PWMOutput_Q2_gamma.OUT"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
